    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "d61c2c23-90d6-476f-b570-a62fd12cfafd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "b678e944-f76d-4e48-89b0-6fffb09e2039",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Marriott Hotel on the outskirts of Northampton. Facilities at the hotel include a restaurant and bar. All rooms are en suite.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "dc491b5c-ec32-4e40-9397-72b4b963ac67",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E78 Derngate in Northampton\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll Saints Church in Brixworth\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll Saints Church in Earls Barton\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBoughton House - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECanal Museum at Stoke Bruerne\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBletchley Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKirby Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERockingham Castle - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECanons Ashby House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUpton House and Gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "7b3008e4-9b5e-45ab-b27d-5d16c656da09",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E[Sights]\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "8f2b6a67-6056-492d-b971-9d1900f630dd",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EDay 1 \u2013 78 Derngate in Northampton\u003C/p\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 78 Derngate in Northampton, famously re-modelled by Charles Rennie Mackintosh in 1916 and the architect\u0026#39;s final major commission, is the only place in the world where his mature architectural and interior style can be seen in its original setting \u2013 check in at the 4* Marriott Hotel on the outskirts of Northampton.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 All Saints Church in Brixworth, All Saints Church in Earls Barton \u0026amp; Boughton House\u003C/h3\u003E\n\u003Cp\u003EAll Saints Church in Brixworth, one of the most important Romanesque churches in Europe, dates from the late 8th century and was significantly enlarged in the 13th century \u2013 the 10th century tower at All Saints Church in Earls Barton is one of the best examples of Saxon architecture in England today \u2013 a guided tour of Boughton House, home to some of the finest Baroque state rooms in the British Isles, introduces us to an outstanding collection of fine art, furniture, tapestries, porcelain and carpets.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Canal Museum at Stoke Bruerne \u0026amp; Bletchley Park\u003C/h3\u003E\n\u003Cp\u003EThe Canal Museum at Stoke Bruerne contemplates the history of Britain\u2019s canals and our visit includes a scenic short boat trip along the Grand Union Canal \u2013 Bletchley Park, the historic site of secret codebreaking activities during World War II and birthplace of the modern computer, is home to the most comprehensive public display of Enigma machines in the world, with exhibitions including Hitler\u0026#39;s \u2018Unbreakable\u2019 Cipher Machine, The Life and Works of Alan Turing Gallery and an outstanding Churchill collection.\u003C/p\u003E\n\u003Cp\u003EDay 4 \u2013 Kirby Hall \u0026amp; Rockingham Castle\u003C/p\u003E\n\u003Cp\u003EAlthough Kirby Hall, one of England\u2019s greatest Elizabethan houses, is partly roofless, the walls show the exceptionally rich decoration while The Great Hall and state rooms remain intact, refitted and redecorated to authentic 17th and 18th century specifications \u2013 a guided tour of Rockingham Castle, built by William the Conqueror and granted by Henry VIII to Edward Watson, explores a predominantly Tudor building, within Norman walls, with architecture, furniture and works of art from practically every century, including a fine collection of 20th century paintings.\u003C/p\u003E\n\u003Ch3\u003EDay 5 Canons Ashby House \u0026amp; Upton House and Gardens\u003C/h3\u003E\n\u003Cp\u003ECanons Ashby House has survived more or less unaltered since 1710 and the formal gardens offers an orchard featuring fruit trees from the 16th century \u2013 en route home we stop at another National Trust property such as Upton House and Gardens, a country mansion containing an outstanding collection of English and continental old master paintings including works by Hogarth, Canaletto, Brueghel and El Greco.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember this itinerary is just our suggestion. "
          }
        }
      ]
