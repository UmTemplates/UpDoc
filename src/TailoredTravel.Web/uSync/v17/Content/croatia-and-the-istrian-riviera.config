    {
      "contentTypeKey": "b773f1ac-4538-4d0a-a1ff-85918c8edbf0",
      "key": "f8def152-8192-4ca1-b396-d16dcea94974",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESingle room supplement \u00A3199\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EInsurance\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEntrance fees to places of interest\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOptional excursions to Slovenia \u0026amp; Brijuni Islands\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGratuities\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Extras"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The costs on top of your tour price can be tailored to suit your group\u0027s needs. Here is what we\u0027ve listed as extras:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Many of these can be included in the tour price if you\u0027d prefer. For example, we can include entrance fees, gratuities, or audio headphones as part of your overall cost."
          }
        }
      ]
    },
