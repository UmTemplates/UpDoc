    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "ae3763c7-fa64-4991-a31f-8a154d3e008d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EOne dinner \u0026amp; one lunch included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions, entrance fees \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUK airport coach transfers included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDirect scheduled flights to Palermo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETour manager throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIncluded boat excursion on Day 5\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAudio headsets included on Days 2 to 5\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "d3cce9d5-cbec-4fd3-b67f-a44821ef3b97",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay five nights at the centrally located 3* Superior Al Madarig Hotel (\u003Ca href=\u0022https://www.almadarig.com/en/\u0022\u003Ehttps://www.almadarig.com/en/\u003C/a\u003E) at Castellammare Del Golfo. Facilities at the hotel include a bar and all of our allocated Standard Rooms are ensuite and feature a hairdryer, television, telephone, minibar and an in room safe. A set 3 course dinner is included at a restaurant close to the hotel on the first evening, and the remaining four nights are on a bed and breakfast basis.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "5d6ed65b-76af-45f5-919f-a23703f91c98",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organiser"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For more information on this tour contact your Group Organiser"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "fac3b2fc-36ab-4e2b-9f61-a09e5e7101ed",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What We Will See"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EErice \u0026amp; its Duomo \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETrapani\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESegesta \u0026amp; its Doric temple - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalermo \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMonreale Cathedral \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EValley of the Temples \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMarsala\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFlorio Wine Cellar \u2013 tour \u0026amp; tasting\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBoat trip to Mozia Island\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Mozia\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
