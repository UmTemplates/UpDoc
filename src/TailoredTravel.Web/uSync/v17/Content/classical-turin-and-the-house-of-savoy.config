    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "149181ba-e1ea-4c91-93be-f4a219857b4c",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "f5809575-e572-4ef3-8856-bcf74e60ff87",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "bf9d8c28-e042-465b-8a60-f999e4fd5a25",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 3* Best Western Genio Hotel in the centre of Turin\u2019s old town and just a few minutes\u2019 walk from the main piazzas of the city. The hotel has a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "51f6c42e-72fb-4d01-99b2-bac49e6b292d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Turin\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Egizio - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReggia di Venaria Reale - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Nazionale del Cinema\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChieri\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVezzolano Abbey\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalazzo Reale - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "7a7cdcc1-e6ef-4969-83d5-e47ee84f5212",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EPalazzo Madama - housing the collections of the Museo Civico d\u2019Arte Antica, Turin\u2019s municipal museum of ancient art, this vast museum is a journey through time beginning with the medieval stonework collection, through the Renaissance and finishing with the decorative arts\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDuomo di San Giovanni - built between 1491 and 1498 on the site of three 14th century basilicas and, before that, a Roman theatre, Turin\u0026#39;s cathedral is home to the famous Shroud of Turin\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBasilica di Superga - in 1706 when the city was saved from besieging French and Spanish armies, to honour the Virgin Mary the Basilica was built on a hill across the Po River and the lavish tombs within are the final resting place of the Savoy family\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDuomo di San Giovanni - built between 1491 and 1498 on the site of three 14th century basilicas and, before that, a Roman theatre, Turin\u0026#39;s cathedral is home to the famous Shroud of Turin and a copy of the cloth is on permanent display\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMole Antonelliana - this 167m tower with its distinctive aluminium spire is the symbol of Turin, and its glass panoramic lift whisks you 85m up through the centre of the tower to the roof terrace in 59 seconds where you are treated to amazing 360 degree views\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "3d564d81-daac-4e1e-b9fa-eea10a1f8078",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Turin\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Turin \u2013 transfer with our tour manager in our private executive coach to the 3* Best Western Genio Hotel in Turin.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Turin \u0026amp; Museo Egizio\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Turin, the capital of Piedmont whose proximity to and centuries old ties with France give it a strong Gallic flavour, takes in sights such as the Duomo, the ancient Roman centre and Piazza San Carlo, a jewel of Baroque architecture \u2013 guided tour with an in house Egyptologist of the Museo Egizio to explore the history and civilization of Egypt including the Altar of Isis and the intact Kha and Merit Tomb.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Reggia di Venaria Reale \u0026amp; Museo Nazionale del Cinema\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the UNESCO World Heritage Site of Reggia di Venaria Reale, one of the largest royal residences in the world, designed and built for the Royal House of Savoy from 1675 by Amedeo di Castellamonte and boasting a wonderful art collection with beautiful frescoes \u2013 located inside the Mole Antonelliana, an unusual monument which is the symbol of the City of Torino, the Museo Nazionale del Cinema is one of the most important of its kind in the world with a vast collection of cinematic memorabilia.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Chieri \u0026amp; Vezzolano Abbey\u003C/h3\u003E\n\u003Cp\u003EChieri dates back to Roman times and prospered from textile dealing with Northern Europe in the medieval era and a guided tour takes in sights such as the Cathedral, dedicated to Santa Maria della Scala, and the San Domenico church with its beautiful bell tower \u2013 Vezzolano Abbey, set amidst the rolling hills and vineyards that surround Asti, is one of the finest examples of Piedmontese Romanesque-Gothic architecture.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Palazzo Reale\u003C/h3\u003E\n\u003Cp\u003EBuilt in the late 17th and early 18th century, a guided tour of Palazzo Reale discovers halls decorated by the House of Savoy\u2019s greatest artists including Peter Piffetti, Francesco de Mura, Claudio Francesco Beaumont and Daniel Seyter \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
