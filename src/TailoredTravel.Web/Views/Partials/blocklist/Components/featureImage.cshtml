@using Umbraco.Cms.Core.Models.Blocks
@using TailoredTravel.Web.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem<FeatureImage>>

@{
    var typedMediaPickerSingle = Model.Content.FeaturePropertyFeatureImage;
    if (typedMediaPickerSingle != null)
    {
        var altText = typedMediaPickerSingle.Value<string>("mediaPropertyAltText");

        @typedMediaPickerSingle.RenderPicture(
            crop: "content12Col",
            alt: altText ?? typedMediaPickerSingle.Name,
            cssClass: "w-100 h-100 object-fit-cover")
    } else {
        <p>Missing image</p>
    }
}
