    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "1ac9071f-cb9f-4640-b484-29ce352c4134",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "55878f9a-5e52-4232-b1cc-82f52ca5941e",
            "9b41528a-b26e-40b1-89e2-f57625cbb35d",
            "1b6af6cb-594d-4149-ba91-ec100f62d77c",
            "0f2e08fc-b253-4523-baba-8a0a94b6c968",
            "e7743429-a466-4e62-bfaa-f6d23c7b085d",
