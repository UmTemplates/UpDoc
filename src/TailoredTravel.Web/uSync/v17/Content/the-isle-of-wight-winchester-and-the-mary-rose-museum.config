    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "1466a837-b477-4c60-9ac4-5e9e4106ca9e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn ferry crossing to the Isle of Wight\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "3b811502-2c17-4c84-82bb-a64155386b83",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Norton Park Hotel located in a countryside setting on the outskirts of Winchester. Facilities at the hotel include a restaurant, bar, indoor swimming pool. All rooms are en suite.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "4968a6b8-487c-4069-b871-8e67cf4d195c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESalisbury Cathedral\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWinchester - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWinchester Cathedral\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EJane Austen\u2019s House Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETour of Isle of Wight\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOsborne House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMary Rose Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPortsmouth Historic Dockyard\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWatts Gallery \u0026amp; Chapel - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "81c446ab-d1e8-4ef7-942b-9a51c52b6ad7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EPallant House Gallery - this Grade I listed Queen Anne townhouse boasts one of the best collections of modern British art with works by Henry Moore, Walter Sickert, Ben Nicholson, Eduardo Paolozzi and Peter Blake\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECarisbrooke Castle, Isle of Wight - Charles I was imprisoned here after his Civil War defeat and later it was the summer home of Princess Beatrice, Queen Victoria\u2019s daughter\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChawton House Library - a unique collection of over 9,000 books together with related original manuscripts focusing on women\u2019s writing from 1600 to 1830\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWatercress Line railway - one way train journey from Alresford to Alton runs through the heart of Hampshire\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENational Motor Museum - in the heart of the glorious New Forest and home to some of the earliest examples of motoring and legendary world record breakers like Bluebird and Golden Arrow\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMottisfont Abbey Garden, House \u0026amp; Estate - once a 12th century Augustine priory and now a handsome house set amidst glorious countryside along the River Test, boasts an interesting collection of modern art and grounds offering a magnificent collection of trees, walled gardens and a National Collection of old fashioned roses\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EStonehenge - the great stone circle was begun around 3000 BC in the late Stone Age and continued to evolve until about 1600 BC in the mid Bronze Age\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "609674ba-c215-4dc1-ba70-80cf847ae8ad",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Salisbury Cathedral\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 stop at a convenient property en route such as Salisbury Cathedral, a beautiful historic building, an international symbol of Christianity and a world class heritage attraction \u2013 continue to the 4* Norton Park Hotel on the outskirts of Winchester.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Winchester, Winchester Cathedral \u0026amp; Jane Austen\u2019s House Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Winchester takes in sights such as Queen Eleanor\u0026#39;s Gardens, and a visit to the Great Hall, to see the table around which allegedly King Arthur and his Knights of the Round Table met \u2013 originating back to the 7th century when a Christian church was first built on this site, Winchester Cathedral has played a fundamental part in the life of this ancient city and a role in the history of our nation \u2013 Jane Austen\u2019s House Museum in Chawton is where the world-renowned author spent the last eight years of her life and where she wrote some of her most popular works.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Isle of Wight \u0026amp; Osborne House\u003C/h3\u003E\n\u003Cp\u003ETake a Wightlink ferry crossing from Portsmouth to Fishbourne for a scenic tour of the Isle of Wight taking in sights such as The Needles and Alum Bay \u2013 when Queen Victoria and Prince Albert bought Osborne House and its estate in 1845, the old house was demolished and a new three storey pavilion was built.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Mary Rose Museum \u0026amp; Portsmouth Historic Dockyard\u003C/h3\u003E\n\u003Cp\u003EThe Mary Rose Museum captures the frozen moment in time seconds before Henry VIII\u0026#39;s flagship sank on a fine summer day on 19 July 1545 as she sailed into action against the French fleet providing a time capsule of the ship, her fittings, weaponry and armament, and all the possessions of her 500 crew and soldiers from the Admiral to the common sailor \u2013 explore the rest of Portsmouth Historic Dockyard attractions including HMS Victory, HMS Warrior 1860, National Museum of the Royal Navy, and a boat tour of the harbour.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Watts Gallery\u003C/h3\u003E\n\u003Cp\u003EStop at a convenient property en route home such as Watts Gallery near Guildford where a guided tour introduces us to a fine collection of works by the eminent Victorian artist GF Watts, while the nearby Watts Chapel is an Arts and Crafts masterpiece full of Art Nouveau imagery designed by Mary Watts \u2013 return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember this itinerary is just our suggestion. "
