    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "6904498d-1269-4b44-ab0c-dba3faab5c3a",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "c455c09d-4a2a-422b-84e0-bf7b2dbdaf3c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "65f3dd61-3ddf-4592-8e71-0eb6f76ac5fd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the centrally located 3* Hotel Lindenwirt in Rudesheim. Facilities at the hotel include a restaurant and a bar. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "bef4c9fa-8459-456f-9dda-7f2ef5153025",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECharming town of Cochem\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBernkastel-Kues - the \u2018Pearl of the Moselle\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKoblenz\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKurf\u00FCrstliches Schloss\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERhine River cruise from Koblenz to Boppard\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBeautiful St Goar\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ER\u00FCdesheim \u0026amp; its Drosselgasse\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETrier, the oldest city in Germany\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "91084aa9-9651-4f5b-9888-b8b651822155",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBurg Eltz - surrounded on three sides by the Elzbach River, this 12th century medieval castle is one of Germany\u2019s most romantic\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ER\u00FCdesheim - famous for the Drosselgasse, a narrow cobbled alley full of inns buzzing with the sound of revelry, but also boasting the remains of the 1,000 year old Bromersburg Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERhine, Moselle \u0026amp; Main River Valleys cruise - instead of coaching, relax and enjoy a seven day river cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "dd82db80-4e43-4fec-b8a3-db10836e9a93",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 R\u00FCdesheim\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 continue to R\u00FCdesheim and check in to the 3* Hotel Lindenwirt.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Cochem \u0026amp; Bernkastel-Kues\u003C/h3\u003E\n\u003Cp\u003EThe charming town of Cochem is dominated by the Reichsburg Castle rising more than 330 feet above the River Moselle \u2013 Bernkastel- Kues, with its beautiful Marktplatz of half-timbered, colourwashed houses with steep roofs and gables, is the \u2018Pearl of the Moselle\u2019 and high above the town stands the Landshut, the ruins of a 13th century castle.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Koblenz \u0026amp; Rhine River cruise to Boppard\u003C/h3\u003E\n\u003Cp\u003EKoblenz is the largest city on the Rhine and among its sights are the 12th century Church of Our Lady and the magnificent Kurfurstliches Schloss, one of the most beautiful Renaissance buildings in Germany \u2013 cruise along the Rhine from Koblenz to Boppard where the rest of the day is free time to relax and explore.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 St Goar \u0026amp; R\u00FCdesheim\u003C/h3\u003E\n\u003Cp\u003ESt Goar is on the most scenic stretch of the Rhine and you can take the train from the main shopping street up the hill to the museum in the ruins of Rheinfels Castle \u2013 continue along the Rhine to R\u00FCdesheim, famous for the Drosselgasse, a narrow cobbled alley full of inns buzzing with the sound of revelry, but also boasting the remains of the 1,000 year old Bromersburg Castle.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Trier\u003C/h3\u003E\n\u003Cp\u003ETrier is the oldest city in Germany and home to the famous Porta Nigra, a huge and still formidable mass of stone and the biggest Roman gateway north of the Alps, and to the 12th century St Peter\u2019s Cathedral containing many rich treasures including the so called \u2018Holy Robe\u2019 of Christ.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 R\u00FCdesheim to UK\u003C/h3\u003E\n\u003Cp\u003ETake our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
