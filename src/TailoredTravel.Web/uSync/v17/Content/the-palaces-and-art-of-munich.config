    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "5a9859a1-f41b-4229-8ed6-b6d9fd535f97",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "1a1e638f-565a-4823-8a53-45a6e6351580",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Munich\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Germany\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "eee7206d-cfeb-4711-be99-7812f963251c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Leonardo Royal Hotel in Munich. Located near the Olympic Park and opposite a Metro Station, the hotel has a bar and restaurant and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "f2401fcb-f648-47d8-a938-37c52c4a365d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Munich\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMunich Residenz - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAlte Pinakothek - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECuvilli\u00E9s Theatre - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBrandhorst Collection\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELenbachhaus - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENymphenburg Palace - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "667ce887-6445-4e87-bfb4-1ef31132300a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ELinderhof Castle, Neuschwanstein Castle \u0026amp; Wieskirche - travel into Bavaria to see Linderhof, one of Ludwig II\u2019s three famous castles, the fairytale Neuschwanstein Castle, built between 1869 and 1886 as a retreat for Ludwig II and a homage to Wagner, and the Wieskirche, a masterpiece of Bavarian Rococo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPinakothek der Moderne - home to four different collections of 20th century design, architecture, art and graphics\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGlyptothek Museum - wonderful collection of Roman and Greek statues and terracotta and bronze antiquities\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "d9947ec0-1da3-44c4-bf46-9d9a16ddbcd5",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Munich\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Munich \u2013 transfer with our professional guide in our private executive coach to the 4* Leonardo Royal Hotel in Munich.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Munich \u0026amp; Munich Residenz\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Munich taking in the Michaelskirche, built by Duke Wilhelm V for the Jesuits who arrived here in 1559, the Frauenkirche, completed in 1488 and one of Southern Germany\u2019s biggest Gothic structures, the magnificent Rococo Asamkirche, built in 1773 by the Asam brothers as their private church, and the Alter Hof, the former residence of the Wittelsbach \u2013 guided tour of the vast Munich Residenz explores the architecture, decoration and works of art spanning the Renaissance, Baroque, Rococo and neoclassical eras taking in the Treasury, a series of rooms holding the crown jewels of Bavaria, and the decorative vaulted ceiling of the Antiquarium.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Alte Pinakothek \u0026amp; Cuvilli\u00E9s Theatre\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Alte Pinakothek introducing us to one of the most important collections of 14th to 18th century European paintings with more than 800 masterpieces by European artists from the Middle Ages to the end of the Rococo period \u2013 guided tour of the Bavarian Rococo Cuvilli\u00E9s Theatre, named after its architect Fran\u00E7ois Cuvilli\u00E9s the Elder, with an auditorium that Elector Maximilian Joseph III built in 1751-55 as his \u2018new opera house\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Brandhorst Collection \u0026amp; Lenbachhaus\u003C/h3\u003E\n\u003Cp\u003EThe Brandhorst Collection, opened to the public in 2009, contains over 700 artworks by the most renowned artists of the 20th century, including Pablo Picasso, Andy Warhol and Sigmar Polke \u2013 guided tour of the Lenbachhaus, a Florentine style 19th century villa, home to a fine collection of paintings by the expressionist Der Blaue Reiter (the Blue Rider) group established in Munich in 1911.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Nymphenburg Palace\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Baroque Nymphenburg Palace in Munich, the summer residence of the Bavarian monarchs, takes in the \u2018Gallery of Beauties\u2019 commissioned by Ludwig I, the former bedroom of King Ludwig II and the impressive banquet hall with fine ceiling frescoes by Johann Baptist Zimmerman \u2013 transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
