    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "fdc84c40-e4b9-405a-b383-a926517a4e64",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe meet at Heathrow Airport for our direct scheduled British Airways flight to Budapest. On arrival in Budapest we are met by our guide who will accompany us on all transfers and included excursions. We transfer by private executive coach to the centrally located 4* K\u002BK Opera Hotel in Budapest for a four night stay. A welcome dinner is included in our hotel this evening.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EOur morning guided city tour of Budapest reveals the characters of the once rival cities of Buda and Pest separated by the Danube. A city full of Baroque and Art Nouveau architecture, we see the Coronation Church, the white stone and Fisherman\u2019s Bastion. This afternoon we enjoy a guided tour at the Museum of Fine Arts. The museum is home to a magnificent Spanish collection, reputedly the best outside Spain, and other highlights include an excellent Venetian collection (particularly Titian and Giorgione), a D\u00FCrer, several Brueghels, a beautiful Raphael and works by Leonardo da Vinci.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EToday we enjoy guided tour of the scenic \u2018Danube Bend\u2019. On arrival in Esztergom we visit the famous imposing hilltop Basilica. The home of Hungarian Catholicism and formerly the state capital, the town is steeped in a history stretching back to the days of Saint Stephen. We continue to Visegr\u00E1d, famous for the remains of the Early Renaissance summer palace of King Matthias Corvinus of Hungary. The first royal house on this site was built by King Charles I of Hungary after 1325, and between 1477 and 1484 King Matthias Corvinus had the palace reconstructed in the Late Gothic style. After the Ottoman Turks\u2019 siege in 1544, the palace fell into ruins. We visit the Museum Palace of King Matthias to see exhibitions on the history of the palace, and reconstructed historical interiors. We then see the ruins of the citadel reflecting the military and strategic importance of this small ancient town. Later today we visit Szentendre. Situated on the banks of the Danube with old medieval streets and churches, this delightful town is famous for its Orthodox Church and Margit Kovacs Museum, a much renowned ceramics artist.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EThis morning we visit the Dohany Synagogue. Built in 1859 in the Moorish Revival style, the building can seat nearly 3,000 people, and is the second largest synagogue in the world. We then visit the neighbouring Jewish Museum, whose rich and vast collection of Judaica makes it the second largest Jewish museum in Europe. This afternoon we visit the magnificent neo-Gothic Parliament House for a guided tour, one of Budapest\u2019s finest architectural achievements and the home of the Holy Hungarian Crown, the splendid Session Room, the impressive central staircase and the wonderful Great Vaulted Hall. Later this afternoon we enjoy an included one hour cruise on the River Danube to see the city from a different perspective.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EWe visit the Castle of Sissi today, the largest Baroque palace in Hungary and one of the largest in Europe. It was built as a summer residence for Queen Elisabeth (Sissi), wife of the Austrian emperor, in the 1800\u2019s. We then transfer to Budapest Airport for our direct scheduled British Airways flight back to Heathrow.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
