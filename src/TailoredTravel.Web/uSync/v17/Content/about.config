  <Properties>
    <contentGrid>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "0708fc2f-92f1-4efc-a9d1-a755f66e6845",
      "key": "c167338c-bf8f-45dd-b28d-27988b3460c8",
      "values": []
    },
    {
      "contentTypeKey": "1e6ac523-7122-4994-9f51-7ca67065222a",
      "key": "0d532376-92ee-42c7-9aae-e95c3490a3ef",
      "values": []
    },
    {
      "contentTypeKey": "f170b29c-338f-4ab8-a5c4-f72c90826f69",
      "key": "a3681d1d-54a3-4789-9a7c-393902f49b5a",
      "values": []
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "b20cce27-1f9f-4ff4-9ef0-bd75a02fa6d2",
      "values": [
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ETailored Travel was established in 1998 by brothers Michael and John English and remains an independent family-run tour operator committed to providing quality group tours at reasonable prices.\u003C/p\u003E\u003Cp\u003EWe are very proud of our reputation as one of the UK\u2019s leading specialist group tour operators.\u003C/p\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "About Us"
        }
      ]
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "2cb6360a-e233-41bb-b33a-0a0156d60be2",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENo matter whether your group chooses to stay within the UK, travel to Europe or venture further afield, when you deal with Tailored Travel you will always speak to a professional who knows the region well, rather than someone in a call centre who is reading from a brochure. We work closely with you to tailor the tour, and our service, to your requirements until we have the itinerary and the price that you are happy with.\u003C/p\u003E\u003Cp\u003EThe key to our success so far has been our flexibility. Larger companies are simply unable to work in the same way, so closely with the group organiser. Every aspect of our service can be adapted to suit you so if you need free places that\u2019s fine, but if you don\u2019t then we\u2019ll lower the price instead. If you would like a tour manager with you, we\u2019ll happily send one. We\u2019ll even collect the money and handle the admin and invoicing if it makes things easier for you. Our policies are as flexible as our tours.\u003C/p\u003E\u003Cp\u003EAll of these little things make a big difference to our clients and that\u2019s why they keep coming back to us, but we don\u2019t reserve this special service just for groups. Whenever individuals book on one of our tours we offer the same professional service and attention to detail so everyone experiences the same great holiday when they book with Tailored Travel.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "About Our Service"
        }
      ]
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "d9bd179d-1489-4dbf-bdaf-8b285469459a",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EContact us now to find out how we have earned our excellent reputation for providing outstanding quality and professional service at reasonable prices - 020 7064 4970\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Contact us"
        }
      ]
    },
    {
      "contentTypeKey": "dfab01ba-2429-4be9-a894-3c6c4c49df94",
      "key": "4b3ac31d-35b6-4d45-9b91-10c323d3e272",
      "values": [
        {
          "alias": "featurePropertyFeatureImage",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "ffaac4a8-74d7-45e3-b92f-a4cc909c998c",
              "mediaKey": "3f39e2a4-9136-4d64-ac7b-d1fb740a2fe2",
              "mediaTypeAlias": "imageResponsive",
              "crops": [],
              "focalPoint": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "d5130f74-c7bf-453d-bf74-a500e5fed88d",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOver 90% of our group organisers return to book with us year after year. They do this because we listen to them and provide them with a consistently high standard of service, personalised to meet and exceed their expectations. Visit our Testimonials page to read what our clients say about us.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
