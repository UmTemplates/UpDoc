    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "48fc64db-8fd9-4aed-ad27-fe571a16e2d7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3 data-pm-slice=\u00220 0 []\u0022\u003EDay 1\u003C/h3\u003E\u003Cp\u003EWe depart by executive coach from our designated pick up point and travel with our tour manager to Folkestone for our Eurotunnel crossing to Calais. On arrival in Bruges we check into the 4* Dukes\u0027 Academie Hotel for a four night stay. A welcome dinner is included at a restaurant close to our hotel this evening.\u003C/p\u003E\u003Ch3\u003EDay 2\u003C/h3\u003E\u003Cp\u003EThis morning, we enjoy an included guided walking tour of Bruges, whose historic city centre is a UNESCO World Heritage Site. Known as the \u0027Venice of the North\u0027, Bruges is famous for lace making, chocolate and its picturesque network of canals. An included 45 minute cruise on the picturesque canals of Bruges enables us to see the city from a different perspective. This afternoon we visit the Groeninge Museum in Bruges, home to a fine collection of Flemish and Belgian painting from Jan Van Eyck to Marcel Broodthears, a wide range of Renaissance and Baroque Masters and representations of Belgian Symbolism and Modernism.\u003C/p\u003E\u003Ch3\u003EDay 3\u003C/h3\u003E\u003Cp\u003EOur morning guided tour of Antwerp takes in sights such as the Great Market Square, Town Hall, Butchers\u0027 Guild House and the Cathedral of Our Lady. This afternoon we visit Rubens House, the former house of Peter Rubens from 1616 until his death in 1640. The house was built around an inner courtyard and the Baroque portico between the courtyard and the Flemish-Italian Renaissance garden was designed by the master himself. Our guided tour of the House introduces us to the life and works of Rubens, including his self portrait, \u0027Adam and Eve in Paradise\u0027, \u0027Henry IV in the battle for Paris\u0027 and a portrait of Sir Anthony Van Dyck as a boy.\u003C/p\u003E\u003Ch3\u003EDay 4\u003C/h3\u003E\u003Cp\u003EWe visit Ghent this morning for a guided walking tour. Originally the capital of Flanders, Ghent retains more historical buildings than any other Flemish city. Here we visit St Bavo Cathedral, which is home to the famous 24-panel altarpiece \u0027The Adoration of the Mystic Lamb\u0027. This afternoon we have a guided tour at the Ghent Museum of Fine Arts with works ranging from 19th century Realism, Romanticism, Impressionism, Symbolism and Expressionism to 20th century Surrealism, including two works by Hieronymus Bosch.\u003C/p\u003E\u003Ch3\u003EDay 5\u003C/h3\u003E\u003Cp\u003EAfter checking out of our hotel we enjoy a guided tour at the Palais des Beaux Arts at Lille, considered by many to be one of France\u0027s most important galleries. Taking carefully selected comfort stops en route, we return to Calais for our return Eurotunnel crossing to Folkestone, and onwards coach travel back to our original pick up point.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EDue to regulations in Bruges, coaches have restricted access within the city centre.  On the first and last days of the tour, the coach will drop us off at a designated point  which is less than a three minute walk away from the hotel. Porterage between the  coach and hotel is included in the cost of the tour (one piece of luggage per person). \u003C/p\u003E\u003Cp\u003EPlease note we reserve the right to alter the above itinerary if required for operational  reasons. Given the historic nature of the places visited, a certain degree of walking will  be involved, and this holiday may not be suitable for those with mobility problems. \u003C/p\u003E"
          }
        }
      ]
    },
