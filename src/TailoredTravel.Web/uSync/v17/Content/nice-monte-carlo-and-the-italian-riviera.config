    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "f06c3f22-0bc9-4ebd-b228-cc71a0402267",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "c9490cb6-3086-4f1b-866d-a2f23271aa58",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the centrally located 4* Torino Hotel at Diano Marina on the Italian Riviera. Located a five minute walk from the beach, facilities at the hotel include a restaurant, bar, outdoor swimming pool, gymnasium and Jacuzzi. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "a72fdee2-529f-4998-a766-d896920a0517",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EMonte Carlo \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVilla \u0026amp; Gardens of Ephrussi de Rothschild\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERapallo \u0026amp; Cervo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGenoa \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESan Remo \u0026amp; Dolceacqua\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENice \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMatisse Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "5fb5a6b3-6c4a-4411-a1df-c428c095b4bf",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "6151db06-5b77-400e-8e52-f38df63ada16",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Diano Marina\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Torino Hotel at Diano Marina on the Italian Riviera.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Monte Carlo \u0026amp; Villa and Gardens of Ephrussi de Rothschild\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Monte Carlo, the roulette capital of the world and winter shelter for the rich and famous, takes in the Casino and the cathedral where Princess Grace was married \u2013 continue to the Villa and Gardens of Ephrussi de Rothschild where, through the art dealers and experts she befriended, the Baroness de Rothschild transformed the villa at Saint-Jean Cap- Ferrat into a collector\u2019s paradise.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Rapallo \u0026amp; Cervo\u003C/h3\u003E\n\u003Cp\u003ETravel along the Liguarian coast to Rapallo, where two post-World War II treaties were signed, and a haven for writers such as DH Lawrence and Ezra Pound \u2013 free time to explore the narrow streets of Cervo, one of Liguria\u2019s prettiest coastal towns.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Genoa\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Genoa takes in sights such as Piazzo San Matteo, the Church of Ges\u00F9 and Palazzo Ducale \u2013 guided tour of Palazzo Rosso introduces us to a wonderful art collection including 17th century frescoes by Genoese artists such as de Ferrari and Piola \u2013 afternoon visit to Belvedere di Castelleto, offering a wonderful panoramic view across the city \u2013 guided tour of the ornate Rococo interior at Palazzo Reale and a fine collection of paintings including a \u2018Crucifixion\u2019 by Van Dyck.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 San Remo \u0026amp; Dolceacqua\u003C/h3\u003E\n\u003Cp\u003EMorning at leisure in San Remo, known as the city of flowers and sun, where you may choose to take a stroll along the famous palm lined promenade or visit Chiesa Russa, an authentic Russian Orthodox church in the city centre \u2013 travel to the delightful town of Dolceacqua where many archaeological remains bear witness to the successive occupations of the site since the Iron Age.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Nice \u0026amp; Matisse Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Nice takes in the narrow streets of the old town, the famous \u2018Promenade\u2019 and the heart of the city with its rich architectural and cultural heritage \u2013 the Matisse Museum boasts a wonderful collection of works left by Henri Matisse to the city of Nice where he lived from 1921 to 1954 \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
