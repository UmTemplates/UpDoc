              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "e16473f1-946b-4b93-abef-7e15ea04bfdc",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EVienna \u2013 guided city tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt Stephen\u2019s Cathedral\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESch\u00F6nbrunn Palace \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EImperial Apartments at the Hofburg Palace \u2013 audio guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKunsthistorisches Museum \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMelk Abbey \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERiver Danube cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUpper Belvedere Palace \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "6d27009d-a93b-42b6-8c92-77ba9dfb9579",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
