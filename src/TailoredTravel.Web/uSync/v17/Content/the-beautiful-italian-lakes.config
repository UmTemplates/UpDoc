    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "1ac4473e-ce95-4d56-97ff-088c5c838f9f",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "1a115915-febb-40ec-b562-23d72ef5a8ad",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003EOne free place per 10 paying passengers\u003C/strong\u003E\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "e5516052-f4fa-4945-9d24-ecfbd00460b8",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESix nights on half board basis at the family owned 3* Hotel Della Torre in Stresa, a short walk from the shores of Lake Maggiore and then along the promenade to the old town centre. Facilities include a restaurant, bar, lounge area and outdoor swimming pool. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "1c2c8b13-5e2c-4a70-8004-ea27c3a93625",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ELake Maggiore \u0026amp; the Borromean Islands\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVilla Cicogna Mozzoni on Lake Lugano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELake Como \u0026amp; cruise to Villa Balbianello\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELake Orta\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMarket day at Omegna\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "40bce417-bb16-4796-8e4a-3f656563babe",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp data-pm-slice=\u00220 0 []\u0022\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "0a9e05af-2c40-420b-8de2-b7df25a44c3b",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Lake Maggiore\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 3* Hotel Della Torre in Stresa.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Borromean Islands\u003C/h3\u003E\n\u003Cp\u003EDepart from Stresa on Lake Maggiore for our trip to the Borromean Islands \u2013 stop at Isola Madre, home to botanical gardens with exotic trees, azaleas and rhododendrons, and a beautiful villa dating back to 1590 \u2013 Isola dei Pescatori is a pretty fishing village \u2013 finish at beautiful Isola Bella with its 17th century palazzo and Baroque gardens built on ten terraces.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Villa Cicogna Mozzoni \u0026amp; Villa del Balbianello\u003C/h3\u003E\n\u003Cp\u003EThe gardens and villa at Villa Cicogna Mozzoni in the hillside village of Bisuschio are a hidden Renaissance treasure and have wonderful views of Lake Lugano and the Brevio Valley \u2013 at Lake Como we take a boat to Villa del Balbianello, which dates back to 1787 and offers splendid views across the Lake.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Lake Maggiore\u003C/h3\u003E\n\u003Cp\u003EA free day at leisure on Lake Maggiore with a chance to relax by the lake or take the local boat service to explore this enchanting lake.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Lake Orta \u0026amp; Omegna\u003C/h3\u003E\n\u003Cp\u003EHalf day visit to picturesque Lake Orta at the foot of the Alps, probably the prettiest of the Italian lakes and yet one of the least known \u2013 continue on to Omegna at the north end of the Lake for free time to relax.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Centovalli Railway \u0026amp; Locarno\u003C/h3\u003E\n\u003Cp\u003EOptional 90 minute train ride along the Centovalli Railway from the Italian town of Domodossola passing through breathtaking scenery to Locarno in Switzerland \u2013 on a broad sweeping curve of a bay in Lake Maggiore, the arcades and piazzas of Locarno overlook subtropical gardens which flourish on the lakeside promenades and cover the wooded slopes above the town.\u003C/p\u003E\n\u003Ch3\u003EDay 7 \u2013 Lake Maggiore\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before we transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
