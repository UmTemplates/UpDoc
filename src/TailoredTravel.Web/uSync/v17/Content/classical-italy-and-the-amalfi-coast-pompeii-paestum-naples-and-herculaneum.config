    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "da08866c-b2aa-44d1-853c-02f582b3e8d3",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions \u0026amp; guided tours\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "e28c56be-b0e0-4b3e-b02a-b51ca7a72426",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESeven nights on half board basis at the 4* Hotel Due Golfi, located a five minute walk from the centre of the village of Sant\u2019Agata sui Due Golfi and a fifteen minute drive from Sorrento. The hotel has a restaurant, bar and an outdoor swimming pool and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "bb70aeb9-61fe-4286-9029-42d16141bec6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EThe beautiful Amalfi Coast\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMount Vesuvius\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPompeii - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENaples - Palazzo Reale \u0026amp; Piazza del Plebiscito\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Archeologico Nazionale - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPaestum - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHerculaneum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVilla Poppaea at Oplontis\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESant\u2019Agata sui Due Golfi\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "7e90321a-5a26-47c1-b621-6176975a2cc9",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECumae \u0026amp; the Cave of the Sybil - the archaeological park is the site of the Cave of the Sibyl, one of the major oracles of the ancient world dedicated to the famous prophetess\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBaia - deriving its name from Baios, Odysseus\u2019s navigator, and the place where Roman society came to swim, its Parco Archeologico features extensive ruins of Roman palaces\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EStabian Villas - excavations at this site have so far revealed the remains of two large villas, Villa Arianna and Villa San Marco destroyed by Vesuvius in 79AD\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIsland of Ischia - the largest island in the Bay of Naples, a guided tour takes in the old town and Giardini la Mortella, the spectacular subtropical and Mediterranean garden developed by the late Susana Walton, Argentinian wife of the British composer Sir William Walton\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "4dee607b-e5a0-424f-a35c-356f3a2e1114",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Sant\u2019Agata sui Due Golfi\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our guide in our private executive coach to the 4* Hotel Due Golfi in the village of Sant\u2019Agata sui Due Golfi.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Amalfi Coast\u003C/h3\u003E\n\u003Cp\u003ETour the fabulous Amalfi Coast stopping at Belvedere Positano for a stunning view and at Amalfi followed by the hydrofoil to Maiori and then coach to Ravello with time for lunch.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Mount Vesuvius \u0026amp; Pompeii\u003C/h3\u003E\n\u003Cp\u003EStop to see Mount Vesuvius \u2013 guided tour and then the rest of the day at Pompeii, the town destroyed by the eruption of Vesuvius in 79AD and then preserved by the deluge of ash and lava giving us an amazing insight into ancient Roman life.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Naples \u0026amp; Museo Archeologico Nazionale\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Naples taking in sights such as the Palazzo Reale and Piazza del Plebiscito \u2013 guided tour of Museo Archeologico Nazionale with its magnificent collections of artefacts, mosaics and painted plaster from Pompeii and Herculaneum.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Sorrento or Island of Capri\u003C/h3\u003E\n\u003Cp\u003EFree day to enjoy Sorrento or join the optional excursion to the island of Capri \u2013 after a boat transfer to the island, a guided tour of this beautiful island is followed by time to wander through the maze of delightful streets and squares or simply to dine in one of the many trattorias.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Paestum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Paestum explores the site of the temples of Hera, Neptune and Ceres at what was the ancient Greek city of Poseidon (named Poseidonia by the Romans) and are considered to be amongst the best preserved examples of Doric temples anywhere in the world.\u003C/p\u003E\n\u003Cp\u003EDay 7 \u2013 Herculaneum \u0026amp; Oplontis\u003C/p\u003E\n\u003Cp\u003EThe ancient town of Herculaneum that was destroyed in the eruption of Vesuvius was home to an array of sprawling villas owned by wealthy patricians that were built for the enjoyment of sea breezes and views across the Bay of Naples \u2013 in Oplontis we explore the excellently preserved architecture and decorations at Villa Poppaea, the home of Nero\u2019s wife and his family.\u003C/p\u003E\n\u003Ch3\u003EDay 8 \u2013 Sant\u2019Agata sui Due Golfi\u003C/h3\u003E\n\u003Cp\u003EMorning free to relax \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
