    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "23907001-6a6e-40e0-a613-a2faf258edb9",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe meet at Clitheroe Interchange and transfer by private coach to Liverpool Airport for our direct scheduled Easyjet flight to Jersey. On arrival in Jersey, we are met by our Blue Badge guide and transfer by private coach to the 3* Hotel Ambassadeur Hotel at St Clement\u2019s Bay for a four night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EOur Blue Badge guide meets us at our hotel today for our panoramic Island tour, including St Aubin\u0026#39;s bay, St Brelade\u0026#39;s Bay, Corbiere Lighthouse, St Ouen\u0026#39;s Bay, Greve de Lecq, the Northern Coastline, Gorey Harbour, return to St Helier via the East Coast, La Rocque harbour, St Clement\u0026#39;s Bay, and the Jersey Pearl Centre. We continue to La Hougue Bie Museum, home to one of Europe\u2019s finest passage graves. Depicting life in Jersey\u2019s Neolithic community 6,000 years ago, the museum is home to a fine collection of ancient treasures including coin hoards, axes, swords and spears.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EThis morning we visit St Matthews Church at Millbrook with our Blue Badge guide. Known locally as the Glass Church, its opalescent panels, magnificent altar cross, glass font, Jersey lily motif and the perfectly angelic Art Deco angels make the church one of the Island\u2019s treasures. We continue to Jersey\u2019s largest testament to its World War II Occupation \u2013 the Jersey War Tunnels. This afternoon we visit Samares Manor, a beautiful house, dating in part to Norman times, surrounded by exceptional gardens originally constructed in the 1920s by Sir James Knott. The Japanese Garden, rock and water gardens, formal gardens, large ponds with islands and camellia plantations are the result of his passion.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EWith our Blue Badge guide we visit the Durrell Wildlife Conservation Trust, founded by famous writer and naturalist Gerald Durrell. Animals that have been saved from extinction include the Assam pygmy hog, St Lucia whiptail lizard and the Mallorcan midwife toad. We continue to Mount Orgueil Castle this afternoon. Built in the thirteenth century to protect the Island against the French, this dramatic castle towers over the harbour at Gorey.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EOur Blue Badge guide accompanies us on our visit to the Eric Young Orchid Foundation today, home to one of the finest collections of orchids in all the world. The Foundation was established in 1958 by the late Eric Young, a trained scientist who, even from childhood, was a gifted horticulturist. We transfer to Jersey Airport for our direct scheduled Easyjet flight to Manchester, and onwards private coach travel back to Clitheroe Interchange.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
