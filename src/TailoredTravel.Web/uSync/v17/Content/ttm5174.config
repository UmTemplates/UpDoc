    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "ca4dbdc1-bbf3-413b-9616-6935086c0980",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEntrance fees to non-National Trust for Scotland properties included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach for all transfers and day excursions in Scotland\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAudio headsets included on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "d7dc2454-6831-4c37-9810-818eb7d86a93",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay four nights at the 4* Best Western Plus Keavil House Hotel on the outskirts of Dunfermline (\u003Ca href=\u0022http://www.keavilhouse.co.uk\u0022\u003Ewww.keavilhouse.co.uk\u003C/a\u003E). Located in a countryside setting, facilities at the hotel include a restaurant, bar, indoor swimming pool, sauna, Jacuzzi, steam room and a gymnasium. All rooms are en suite and feature television, telephone, hairdryer and tea \u0026amp; coffee making facilities. A set 3 course dinner without drinks is included in our hotel on the first night. A choice 3 course dinner without drinks is included in our hotel on the remaining three nights of our tour.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "f4d170e7-8074-425b-99e7-6228f30225cd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organiser"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For more information on this tour contact your Group Organiser"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "d6182972-a0eb-4d2d-b128-97bddf7a0705",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ENational Gallery of Scotland\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERoyal Yacht Britannia \u2013 audio tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERosslyn Chapel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHopetoun House \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalace of Holyroodhouse \u0026amp; the Queen\u2019s Gallery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E7 Charlotte Square\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "35461c9d-b979-4a34-87dd-0462d1cff4a1",
      "values": [
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "5a8034f7-812b-4f85-98e2-0fd3978d1317",
            "ca4dbdc1-bbf3-413b-9616-6935086c0980",
            "d7dc2454-6831-4c37-9810-818eb7d86a93",
            "d6182972-a0eb-4d2d-b128-97bddf7a0705",
            "29d94c75-b813-4d26-a722-e96845de889f",
            "0e754171-89f6-4406-b18a-67c0e97bccc1",
            "f4d170e7-8074-425b-99e7-6228f30225cd"
          ]
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "5a8034f7-812b-4f85-98e2-0fd3978d1317",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe make our own way from London to Edinburgh Waverley Station by train. Here we meet our Blue Badge guide and transfer by private executive coach to the 4* Best Western Plus Keavil House Hotel on the outskirts of Dunfermline for a four night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EWith our Blue Badge guide we visit Edinburgh and the National Gallery of Scotland. Including paintings by renowned artists such as Van Dyck and Tiepolo, the Gallery is home to Scotland\u2019s greatest collection of European paintings and sculpture from the Renaissance to Post Impressionist eras. This afternoon we visit the Royal Yacht Britannia. Serving the Royal Family for over forty years, the Royal Yacht played a leading role in some of the defining moments of recent history. The audio tour takes in the State Dining Room, the Bridge and the Queen\u2019s Sitting Room.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EOur Blue Badge guide meets us at our hotel this morning and accompanies us throughout the day. This morning we visit Rosslyn Chapel. One of Scotland\u2019s most remarkable buildings, Rosslyn Chapel has been in the ownership of our family since its foundation in 1446 by Sir William St Clair, and is still used today as a place of worship. The beauty of its setting, in rural Midlothian, the mysterious symbolism of its ornate stonework and its role in the Da Vinci Code have inspired, attracted and intrigued writers, artists and visitors ever since. This afternoon we visit Hopetoun House for a guided tour. Set in 150 acres of rolling parkland, Hopetoun House is one of the most splendid examples of the work of Scottish architects Sir William Bruce, William Adam and his sons John and Robert. Building began on the house in 1699 and since its completion in the mid 18th century, the house has remained substantially unaltered, save for the introduction of the State Dining Room by James Gillespie Graham in the Regency period.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EWe return to Edinburgh with our Blue Badge guide, and on arrival we visit the Palace of Holyroodhouse, the official residence in Scotland of His Majesty the King. Situated at the end of Edinburgh\u2019s Royal Mile against the backdrop of Arthur\u2019s Seat, our visit also includes entrance to the Queen\u2019s Gallery, built in the shell of the former Holyroodhouse Free Church and Duchess of Gordon\u2019s School. This afternoon we visit the newly restored National Trust for Scotland\u2019s 7 Charlotte Square, an Edinburgh Town House which houses paintings by Scottish artists including Sir Henry Raeburn, Allan Ramsay and Alexander Nasmyth.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EThe morning is at leisure in Edinburgh and on an individual basis you may choose to visit Edinburgh Castle. Perched on a volcanic plug, the castle has dominated the skyline of Scotland\u2019s capital for centuries. Scotland\u2019s crown jewels are among the national treasures on display within the castle walls. We return to Edinburgh Waverley Station where our tour concludes. From here we make our own way back to London by train.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
