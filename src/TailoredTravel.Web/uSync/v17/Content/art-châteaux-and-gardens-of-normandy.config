    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "107f1f0b-cf6c-4fcf-8548-c749a8a38fa5",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Rouen hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "99490d2f-4da6-4d15-840d-05101b965fce",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the centrally located 4* Radisson Blu Hotel in Rouen. Facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "47d018a5-0707-42b5-a0c2-7266dd75c551",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ERouen\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELe Vasterival\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Miromesnil - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Eug\u00E8ne Boudin\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHonfleur\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMonet\u2019s Garden\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e des Impressionnismes\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e des Beaux Arts, Rouen - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "7f02c8fc-0ca3-4c4a-9e5c-e526b4821ddc",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Beaumesnil - an exceptional Louis XIII Baroque mansion with beautifully furnished interiors and surrounded by 120 acres of park and French formal gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ED-Day Beaches - guided tour focussing on the Normandy D-Day landings including a visit to the Landings Museum at Arromanches which contemplates the construction of Mulberry Harbour, a truly extraordinary technological feat which provided the key to victory in Normandy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELe Bois des Moutiers Ch\u00E2teau - an Arts and Crafts house and garden by Edwin Lutyens and Gertrude Jekyll, a tour of the gardens explores an extensive collection of rare trees and shrubs in a series of valleys running down to the sea\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Modern Art Andr\u00E9 Malraux, Le Havre - renowned for its late 19th and 20th century art, the collection of Impressionist works is today one of France\u2019s largest, with works by Renoir, Pissarro, Sisley, Degas, Courbet and Corot\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "cb407d66-947b-4d75-b59c-73f31f84ef81",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Rouen\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 continue with our tour manager to Rouen and check in to the 4* Radisson Blu Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Le Vasterival \u0026amp; Ch\u00E2teau de Miromesnil\u003C/h3\u003E\n\u003Cp\u003ELe Vasterival, one of the finest private gardens in Europe, was created in 1957 by Princess Sturdza and its sweeping paths, long vistas and huge variety of plants make this garden breathtaking in its scope \u2013 guided tour of Ch\u00E2teau de Miromesnil, the birthplace of the French writer Guy de Maupassant, and where four centuries of architectural styles are evident in the ch\u00E2teau while ancient cedar of Lebanon dominate the magnificent gardens and in the kitchen garden squares separated by grass pathways are ordered with a fantastic harmony of vegetables and flowers.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Mus\u00E9e Eug\u00E8ne Boudin \u0026amp; Honfleur\u003C/h3\u003E\n\u003Cp\u003ELocated in a 19th century chapel and named after Honfleur\u2019s most famous painter, a guided tour of the Mus\u00E9e Eug\u00E8ne Boudin explores a fine collection of impressionist works by artists such as Boudin, Dubourg, Monet and Jongkind \u2013 rest of the day is at leisure in Honfleur to explore the town from which numerous French artists drew inspiration.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Monet\u2019s Garden, Mus\u00E9e des Impressionnismes \u0026amp; Rouen\u003C/h3\u003E\n\u003Cp\u003EMonet\u2019s Garden at Giverny, where the artist painted his Waterlillies series, is asymmetrical with an exotic Japanese feel to it and Monet came here repeatedly through his life \u2013 the nearby Mus\u00E9e des Impressionnismes is dedicated to the history of Impressionism and its aftermath and its more distant impact on the second half of the twentieth century \u2013 return to Rouen to relax for the remainder of the afternoon.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Mus\u00E9e des Beaux Arts, Rouen\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Mus\u00E9e des Beaux Arts in Rouen introduces us to an outstanding collection of paintings, drawings and sculptures by renowned artists such as Caravaggio, Monet and Sisley \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
