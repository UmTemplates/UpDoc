    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "9ddeef5f-29ef-4a44-8676-84f29f515f5f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe meet at Gatwick Airport for our direct scheduled Ryanair flight to Cork. On arrival at Cork we meet our coach driver. We continue to The Queenstown Story at Cobh, to discover one of the most important maritime naval bases in 19th century Europe, which also served as the main Irish emigration centres to North America and Australia. On arrival in Killarney we check in at the 4* Killarney Hotel for a four night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EThe morning is at leisure in Killarney and on an individual basis you may choose to take a ride on Killarney\u2019s famous horse-drawn Jaunting Cars. We visit Muckross House this afternoon with our local guide, built for Henry Arthur Herbert and his wife, the water colourist Mary Balfour Herbert. This was actually the fourth house that successive generations of the Herbert family had occupied at Muckross over a period of almost two hundred years.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EThis morning we tour the famous Ring of Kerry with our local guide who meets us at our hotel. Our tour of this spectacularly beautiful coastline starts in the village of Kenmare and continues to Molls Gap for the most fantastic view, Killorglin, Caherciveen and Glenbeigh.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EOur local guide meets us at our hotel this morning and accompanies us throughout the day. This morning we spend some time at leisure in Glengariff, one of Ireland\u0026#39;s most beautiful scenic villages. We then enjoy an included scenic boat trip to Garnish Island, where we will explore the scenic gardens. This afternoon we circle the Beara Peninsula, where we witness some of Ireland\u2019s most staggering mountain, lake and coastal scenery. The tour passes numerous prehistoric stones and tombs, and the highly scenic village of Eyeries, which produces its own award winning \u2018Millens\u2019 cheese.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EWe spend some time at leisure in Killarney this morning. We then return to Cork Airport for our direct scheduled Ryanair flight back to Gatwick.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for\noperational reasons. Given the historic nature of the places visited, a certain degree of walking will be involved.\u003C/p\u003E\n"
          }
        }
      ]
    },
