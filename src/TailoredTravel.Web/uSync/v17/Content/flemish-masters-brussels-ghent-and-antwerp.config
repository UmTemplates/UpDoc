    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "8eacbbee-0309-450b-afd5-cdf3ff4875c4",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "48ceada3-0ec2-4735-9d5e-42668a367ae4",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Bruges hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in Belgium\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "061848bd-cdcd-442e-8de2-3667cc636e94",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights at the centrally located 4* Academie Hotel in Bruges. Located under a fifteen minute walk from the market square, facilities at the hotel include a breakfast room and bar and all rooms are en suite. Dinner is included in a local restaurant on the first evening and the remaining nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "39fbde75-c5ff-4331-aca2-b35de3e1b51a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Bruges\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBruges canal cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Antwerp\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERockox House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum Mayer van den Bergh - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Ghent\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGhent Museum of Fine Arts - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalais des Beaux-Arts, Lille - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "d62ff121-f067-4813-bab8-40dafc10a6dd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EArentshuis, Bruges - located on the upper floor of an elegant 18th century city mansion, it features the work of British artist Frank Brangwyn (1867-1956), a leading graphic artist and painter as well as a designer of carpets, furniture, stained glass windows, ceramics and jewellery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Industry, Work and Textiles - housed in an impressive former cotton mill on the Minnemeers Canal, it sheds light on Ghent\u2019s vitally important textile industry from the Middle Ages to the 20th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Brussels - taking in the Grand Place, the Royal District, the Louise District and the Museum of Ancient Art, housing a vast collection of paintings, sculptures and drawings from the 15th to the 18th century including an internationally renowned Rubens collection\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "23c4df2c-7cee-4239-9a8f-7559555a4744",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Bruges\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 continue with our professional guide to the the 4* Academie Hotel in Bruges \u2013 dinner in a local restaurant.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Bruges guided tour \u0026amp; canal cruise\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Bruges, famous for lace making, chocolate and its picturesque network of canals and whose historic city centre is included on UNESCO\u2019s World Heritage List \u2013 a cruise on the picturesque canals of Bruges to see the city from a different perspective.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Antwerp guided tour, Rockox House \u0026amp; Museum Mayer van den Bergh\u003C/h3\u003E\n\u003Cp\u003EFull day in Antwerp \u2013 guided city tour of the Great Market Square, Town Hall, Butchers Guild House and the Cathedral of our Lady \u2013 Rockox House, the 17th century home of Antwerp mayor, Nicolaas Rockox, a friend of Rubens, contains a fine collection of paintings by artists such as van der Weyden, Memling, van Eyck, Rubens and van Dyck \u2013 guided tour of the Museum Mayer van den Bergh, home to a collection of paintings, sculpture, pottery, porcelain, stained glass, manuscripts, coins and tapestries from antiquity until 1800 including the \u2018Dulle Griet\u2019 by Pieter Bruegel the Elder.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Ghent guided tour \u0026amp; Ghent Museum of Fine Arts\u003C/h3\u003E\n\u003Cp\u003EFull day in Ghent, once the ancient capital of Flanders and birthplace of Emperor Charles V and boasting more historical buildings than any other Flemish city \u2013 guided city tour taking in sights such as the Bridge of St Michael, the Belfry, the Cloth Hall and Van Eyck\u2019s \u2018The Adoration of the Mystic Lamb\u2019 at St Bavo Cathedral \u2013 guided tour of the collection of the Ghent Museum of Fine Arts with works ranging from 19th century Realism, Romanticism, Impressionism, Symbolism and Expressionism to 20th century Surrealism including two works by Hieronymus Bosch.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Palais des Beaux-Arts, Lille\u003C/h3\u003E\n\u003Cp\u003ETravel to Lille for a guided tour of the Palais des Beaux-Arts, considered by many to be one of France\u2019s most important galleries \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
