        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "a3e3111b-8902-4137-83ec-3275088c7ea6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe board our private executive coach at our designated pick up points. En route to our hotel we spend some time at leisure on Avebury in Wiltshire. Here, you may choose to wander among the standing stones of the largest stone circle in the world and marvel at the human ingenuity and dedication it took to create the enormous bank and ditch. This afternoon we visit the National Trust\u2019s Avebury Manor and Garden. Unlike most other properties, visitors are allowed to touch the furniture, lie on the beds and handle the pots and pans at this 16th century manor house. The garden is arranged as a series of \u0026#39;rooms\u0026#39;, each with a different character, including Kitchen Garden, Topiary Garden, Lions Walk, Church Garden, East Garden, Half Moon Garden, Orchard, Monks Garden and South Lawn. We continue to the 4* Mercure Hotel in Bridgwater for a two night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EThis morning we enjoy a guided tour and tasting at Sheppy\u2019s House of Cider. Through more than 200 years of making real premium craft cider, six generations of the Sheppy family have weathered the ups and downs of combining farming with cider-making by embracing change and opportunity. With our Blue Badge guide we continue to Bishops Lydeard Station where we enjoy an included nostalgic one way steam train excursion to Minehead on the scenic West Somerset Railway. Travelling 20 miles, we admire the stunning Somerset countryside and coast.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EWells, the smallest city in England is our destination this morning. Our guided walking tour of Wells with our Blue Badge guide takes in sights such as the exterior of the famous Gothic cathedral with its fine medieval statuary, stained glass, chapter house and astronomical clock, the 13th century Bishop\u0026#39;s Palace and the Vicar\u0026#39;s Close, a complete medieval street. This afternoon we enjoy a guided tour at Shepton Mallet Prison, the world\u2019s oldest prison. During our 90 minute guided tour we discover what life was like for prisoners, officers and visitors. This unique experience covers every corner of the prison, including the 2 Victorian Prison Wings, the Hard Labour Yard, the old Gate Lodge and the execution room. Taking carefully selected comfort stops en route, we return back to our original pick up points.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
