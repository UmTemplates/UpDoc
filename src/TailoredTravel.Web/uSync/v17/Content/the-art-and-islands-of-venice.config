    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "a7abfdd2-7f0e-4215-b8e8-4d969080c4f4",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "8706820a-1ac1-4d20-88e3-a52b2be9d3ce",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECentral 4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Venice\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWater taxi transfers\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "1d4f6547-7142-487a-b974-ed622d747ab6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* All\u0026#39;Angelo Art Hotel. In a 17th century palazzo, this historic hotel is located just 50 metres from Saint Mark\u2019s Square and the Doge\u2019s Palace. The hotel has a bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "34608f70-568a-4a2f-93dc-60ecd20118a9",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ETeatro La Fenice - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVenice - St Mark\u2019s Square \u0026amp; the Basilica of St Mark\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScuola Grande di San Rocco - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGallerie dell\u2019Accademia - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECa\u2019 d\u2019Oro\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBoat trip to the Islands of the Venetian Lagoon\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPeggy Guggenheim Collection\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "099dd72d-a5cd-4b74-b534-ffd33812dbd4",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECa\u2019 Rezzonico - a palazzo on the Grand Canal, now a museum dedicated to 18th century Venice\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPunta della Dogana - the former customs house presents a permanent exhibition of works from the Fran\u00E7ois Pinault Collection\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBasilica of San Giovanni e Paolo - built by the Dominicans in the 14th century, the city\u2019s great Gothic church houses monuments to 25 doges\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Querini Stampalia - home to one of the richest art collections in Venice with works by artists such as Pietro Longhi, Gabriel Bella, Lorenzo di Credi and Luca Giordano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalazzo Ducale - the Doge\u2019s Palace was founded in the 9th century and was the official residence of the elected rulers of Venice\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "01aa3d24-34d5-4abf-94a0-d74649f9aad2",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 Venice \u0026amp; Teatro La Fenice\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Venice from your preferred airport \u2013 transfer with our tour manager by water taxi into the heart of Venice \u2013 guided tour of the historic opera house of Teatro La Fenice dating back to 1789 \u2013 check in to the centrally located 4* All\u0026#39;Angelo Art Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 St Mark\u2019s Square, the Basilica of St Mark \u0026amp; Scuola Grande di San Rocco\u003C/h3\u003E\n\u003Cp\u003EGuided tour explores St Mark\u2019s Square, described by Napoleon as \u2018the finest drawing room in Europe\u2019, and the Basilica of St Mark which was built in the 10th century to house the body of St Mark the Evangelist \u2013 guided tour of the Scuola Grande di San Rocco, home to more than 50 paintings by Tintoretto.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Gallerie dell\u2019Accademia \u0026amp; Ca\u2019 d\u2019Oro\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Gallerie dell\u2019Accademia to introduce us to the wonderful collection of Venetian art including works by Titian, Carpaccio, Tintoretto and Veronese \u2013 Ca\u2019 d\u2019Oro, the House of Gold, is one of the most beautiful Gothic palaces on the Grand Canal and home to an excellent art collection including works by Titian and Francesco Guardi.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Islands of the Venetian Lagoon\u003C/h3\u003E\n\u003Cp\u003EFull day private boat trip to the neighbouring islands just off Venice \u2013 Murano, the island famous for its glass making \u2013 Burano, the most colourful of the islands with brightly coloured houses and easily recognisable from the tilting tower of its church \u2013 Torcello, barely inhabited, whose central piazza and its ancient buildings are a haunting reminder of a bygone era.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Peggy Guggenheim Collection\u003C/h3\u003E\n\u003Cp\u003EThe Peggy Guggenheim Collection in the Palazzo Venier dei Leoni on the Grand Canal is home to the most important collection in Italy of European and American art of the first half of the 20th century with works from Picasso, Mondrian, Dali and Pollock \u2013 water taxi to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
