      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "3ffe2569-b6c8-458b-a808-3641df20cfd1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Germany\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Germany\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "34304abd-2d5f-44fd-8a9c-9329d717d547",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the family run 3* Hotel Seeblick in the village of Bernried. Located near the shores of beautiful Lake Starnberg, the hotel has a restaurant, bar and an indoor pool. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "eaf9361e-2d6a-4749-9b1e-eb0ac4c682af",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBernried, voted Bavaria\u2019s most attractive village in 2006\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHerrsching am Ammersee\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBaroque Nymphenburg Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUNESCO listed Wieskirche\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMedieval town of Fussen\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFairytale Neuschwanstein Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMagnificent Linderhof Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOberammergau Passion Play Theatre\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Munich\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "c06d6643-c1d3-49fb-8415-64ec210feafc",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EF\u00FCnfseenland (Five Lakes Country) - full day tour of Bavaria\u2019s stunning lake district including Lake Starnberg, Lake Ammersee and beautiful lakeside villages\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDeutsches Museum, Munich - home to over 28,000 objects, this is the largest science and technology museum in the world\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENeue Pinakothek - European art and sculpture from the late 18th to the beginning of the 20th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBeautiful hilltop monastery of Andechs - founded in the 10th century, with relics reputed to come from Christ\u2019s crown of thorns, and a victory cross of Charlemagne, whose army overran much of Western Europe in the 9th century\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "a9a8fbde-05a9-4952-8d06-8de1d311bf02",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Bernried\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Germany from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 3* Hotel Seeblick in the village of Bernried, voted Bavaria\u2019s most attractive village in 2006.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Herrsching am Ammersee \u0026amp; Nymphenburg Palace\u003C/h3\u003E\n\u003Cp\u003ETime at leisure in the town of Herrsching am Ammersee or choose to join our optional cruise on picturesque Lake Ammersee \u2013 the highlights of the Baroque Nymphenburg Palace, the summer residence of the Bavarian monarchs, include the \u2018Gallery of Beauties\u2019, commissioned by Ludwig I, the former bedroom of King Ludwig II and fine ceiling frescoes in the impressive banquet hall.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Wieskirche, F\u00FCssen \u0026amp; Neuschwanstein Castle\u003C/h3\u003E\n\u003Cp\u003EWieskirche, an oval Rococo church designed in the late 1740s by Dominikus Zimmermann, was added to the UNESCO list in 1983 \u2013 time at leisure for lunch in the medieval town of F\u00FCssen, framed by imposing high mountain peaks \u2013 Neuschwanstein Castle was built by the shy King Ludwig II in order to withdraw from public life but seven weeks after his death in 1886 it was opened to the public and today is one of the most popular of all Europe\u2019s castles.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Linderhof Palace \u0026amp; Oberammergau Passion Play Theatre\u003C/h3\u003E\n\u003Cp\u003EBuilt between 1874 and 1878 and the smallest of King Ludwig II\u2019s three royal castles, Linderhof Palace was originally intended as a hunting lodge but later he declared it would be a new Versailles and the wonderful French Rococo interiors and beautiful parkland certainly reflect that ambition \u2013 guided tour of the Oberammergau Passion Play Theatre where in a production involving more than 2,000 villagers, the world famous Passion Play is performed, a tradition which first started in 1634.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Guided tour of Munich\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Munich taking in the Michaelskirche, built by Duke Wilhelm V for the Jesuits who arrived here in 1559, the Frauenkirche, completed in 1488 and one of Southern Germany\u2019s biggest Gothic structures, the magnificent Rococo Asamkirche, built in 1773 by the Asam brothers as their private church, and the Alter Hof, the former residence of the Wittelsbach \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
