      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "ee5d2557-4d04-414d-81ef-1547cc36c00c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Belfast\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional guide in Northern Ireland\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Northern Ireland\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "7242736a-2e6d-47b9-bd5b-48ab7c716c25",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Dunadry Hotel and Country Club in a countryside setting 15 miles from Belfast. The hotel has a bar and restaurant and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "9853aa74-cb81-4eb1-a73a-a0cea6c94712",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EMount Stewart House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Belfast\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Ulster Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGiant\u2019s Causeway\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOld Bushmills Distillery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Derry\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESeamus Heaney HomePlace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETitanic Experience\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "257ffa22-4788-42d9-8ce8-4d10c0bc1e0c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EFlorence Court - the former home of the Earls of Enniskillen, every aspect of life in this classical Irish house is brought to life on our guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEnniskillen Castle - built almost 600 years ago for Hugh \u2018The Hospitable\u2019, it became an English garrison fort and later served as part of a military barracks\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUlster American Folk Park - an outdoor museum telling the story of emigration from Ulster to America in the 18th and 19th centuries\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDonegal - stay some nights in Derry to explore Donegal and the stunning Inishowen Peninsula including Fort Dunree, Doagh Famine Village \u0026amp; Malin Head\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "4695e2e4-887e-4df7-9c20-2e5ff69a5d53",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Mount Stewart House\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Belfast from your preferred airport \u2013 the National Trust\u2019s Mount Stewart House and Gardens offers magnificent views over Strangford Lough and its famous gardens were planted in the 1920s by Edith, Lady Londonderry \u2013 transfer to the 4* Dunadry Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Belfast \u0026amp; The Ulster Museum\u003C/h3\u003E\n\u003Cp\u003ETour of Belfast with our guide taking in the Falls Road and Shankhill areas of the city, St Anne\u2019s Cathedral and Stormont Castle \u2013 guided tour of The Ulster Museum, home to a rich collection split between floors of art, history and natural sciences and a section focusing on The Troubles.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Giant\u2019s Causeway \u0026amp; Old Bushmills Distillery\u003C/h3\u003E\n\u003Cp\u003ETravel the North Antrim coastline \u2013 the National Trust\u2019s Giant\u2019s Causeway was formed from lava eruptions over 60 million years ago and with many rich traditions in explanation of its strange rock \u2013 optional guided tour and tasting at Old Bushmills Distillery, Ireland\u2019s oldest whiskey distillery dating back to 1608.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Guided tour of Derry \u0026amp; Seamus Heaney HomePlace\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Derry takes in the Bogside, the City Walls, completed in 1618 and amongst the best preserved city fortifications in the Western world, and St Columb\u2019s Cathedral, one of Derry\u0026#39;s most prominent buildings built between 1628 and 1633 \u2013 a visit to Seamus Heaney HomePlace takes us on an inspiring journey through the life and work of one of Ireland\u2019s greatest writers.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Titanic Experience\u003C/h3\u003E\n\u003Cp\u003ETitanic Experience is housed in a new \u00A390m, six floor building as high as the world famous ship\u2019s hull and located beside the historic site of its construction \u2013 this state of the art visitor experience tells the story of the Titanic, from its conception in Belfast in the early 1900s, through its construction and launch, to its famous maiden voyage and tragic end \u2013 transfer to the airport for our flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
