    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "1c8ef3b4-daba-4691-8167-3d23d5ea6a6e",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "ae6fcac8-1b57-4d11-87cc-c35c77b252df",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EScheduled flights to Germany\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EExecutive coach in Germany\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003EOne free place per 10 paying passengers\u003C/strong\u003E\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "8328c5a0-dfda-4fcd-af35-2f618cb7ae9b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the 3* Best Western Hofgut Sternen Hotel at Breitnau. This typical Black Forest style hotel is an ideal base for our tour. All rooms have en suite facilities and the hotel has a bar\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "0e0476ad-0cf3-439d-938c-fde80154d9d1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGlass blowers \u0026amp; cuckoo clock workshop at Breitnau\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELakeside resort of Titisee\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERhine Falls, the most spectacular waterfall in central Europe\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMedieval town of Constance\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E\u2018Flower island\u2019 of Mainau\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETriberg \u0026amp; Villingen\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUniversity city of Freiburg\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "ce0be104-7ede-4c60-9cba-a34dc532eebe",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EColmar - this picture postcard town with its halftimbered houses is the capital of the Alsatian wine producing area\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGerman Clock Museum in Furtwangen - traces the development of clocks from the Dark Ages to the space age\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELa Cit\u00E9 de l\u0026#39;Automobile in Mulhouse - the largest car museum in the world showcasing 400 classic, prestige and racing cars which trace the history of the automobile\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "01a4c71c-652f-4bd2-956a-3754d3aad900",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Breitnau\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Germany from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 3* Best Western Hofgut Sternen Hotel at Breitnau.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Breitnau, Titisee \u0026amp; Rhine Falls\u003C/h3\u003E\n\u003Cp\u003EMorning visit to a traditional glass blowers and cuckoo clock workshop at Breitnau \u2013 time at leisure to stroll around the lakeside resort of Titisee or to take a boat cruise \u2013 located on the upper Rhine River just below Schaffhausen in northern Switzerland, the Rhine Falls is described as the most spectacular waterfall in central Europe.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Constance \u0026amp; Island of Mainau\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the medieval town of Constance \u2013 a memorable boat excursion on Lake Constance before visiting the nearby \u2018flower island\u2019 of Mainau, famous for its tropical plants, flowers and trees.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Triberg \u0026amp; Villingen\u003C/h3\u003E\n\u003Cp\u003EMorning visit to Triberg whose sights include the Black Forest Open Air Museum and Germany\u2019s highest waterfall \u2013 rest of the day is spent in the charming resort of Villingen.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Freiburg\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the old university town of Freiburg taking in the charming squares and the Gothic cathedral which dominates the medieval town \u2013 rest of the day at leisure in Freiburg.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Breitnau\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before we transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
