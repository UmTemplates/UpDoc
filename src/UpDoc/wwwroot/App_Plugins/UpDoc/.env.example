# Default target: the UpDoc test site.
URL=https://localhost:44390
UMBRACO_URL=https://localhost:44390
UMBRACO_USER_LOGIN=admin@example.com
UMBRACO_USER_PASSWORD=yourpassword

# Optional second target: the Tailored Travel mirror.
#
# Run against it with:  TARGET=mirror npx playwright test tests/e2e/<spec>.ts
#
# The mirror is a separate Umbraco install with its own Playwright user, so it
# needs its own login as well as its own URL — the test site's credentials do
# not work against it.
MIRROR_URL=https://localhost:44351
MIRROR_USER_LOGIN=play.wright@tailored-travel.co.uk
MIRROR_USER_PASSWORD=yourpassword
