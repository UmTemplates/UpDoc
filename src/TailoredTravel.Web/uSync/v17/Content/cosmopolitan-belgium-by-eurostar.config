    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "6e147404-113a-49a9-b1dc-46db34a05fb8",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "89984c52-72ee-4077-ae17-c2b1f4420c83",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* central Brussels hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEurostar train to Brussels\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Belgium\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "992b5a30-94d7-4b30-b5b7-0bdcd3610e72",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Crowne Plaza Hotel in Brussels. Located close city\u2019s main shopping area and historic sites, facilities include a restaurant and bar. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "8787f134-c55b-4e4a-adc9-8cf919608a42",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EIntroductory tour of Brussels\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Ancient Art\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Antwerp\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDiamond Pavilion \u0026amp; Diamond Land\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHistoric city of Bruges\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVisitor Centre at Waterloo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWellington Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "b50fc511-a0d7-44ad-a35e-2f01a5911b4c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "7c3aa7e4-0427-4ebe-a5f1-066821aed5ab",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 - Eurostar to Brussels\u003C/h3\u003E\n\u003Cp\u003EBoard the Eurostar train at your choice of either London St Pancras International or Ebbsfleet Station for the journey to Brussels in standard class coaches \u2013 transfer with our tour manager in our private executive coach to the centrally located 4* Crowne Plaza Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 - Brussels \u0026amp; Museum of Ancient Art\u003C/h3\u003E\n\u003Cp\u003EGuided coach tour of Brussels taking in the city\u2019s main districts including the Grand Place, the Royal District and the Louise District \u2013 guided tour of the Museum of Ancient Art, housing a vast collection of paintings, sculptures and drawings from the 15th to the 18th century, the majority of which were confiscated and deposited by the French State during the revolutionary period.\u003C/p\u003E\n\u003Ch3\u003EDay 3 - Antwerp, Diamond Pavilion \u0026amp; Diamond Land\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Antwerp takes in sights such as the Great Market Square, Town Hall, Butcher\u2019s Guild House and the Cathedral of Our Lady \u2013 at the Diamond Pavilion we discover the significance of the industry to Antwerp\u2019s economic success since the 15th century \u2013 at Diamond Land we learn about the diamond grading process.\u003C/p\u003E\n\u003Ch3\u003EDay 4 - Bruges\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Bruges, famous for lace making, chocolate and its picturesque network of canals and whose historic city centre is included on UNESCO\u2019s World Heritage List \u2013 an optional short cruise on the picturesque canals of Bruges to see the city from a different perspective \u2013 rest of the day free at leisure in Bruges.\u003C/p\u003E\n\u003Ch3\u003EDay 5 - Waterloo \u0026amp; Wellington Museum\u003C/h3\u003E\n\u003Cp\u003EThe Visitor Centre at Waterloo is home to the \u2018Panorama of the Battle\u2019, a canvas dating back to 1912 offering a panoramic view measuring 110 metres long and 12 metres high \u2013 option of climbing the 226 steps to the top of the Lion\u2019s Mound, a monument commemorating the battlefield of Waterloo \u2013 the Wellington Museum, located in an inn dating back to the start of the 18th century which was the headquarters of the Duke of Wellington, traces the events of the era \u2013 return to the station in Brussels for our Eurostar train home.\u003C/p\u003E\n\u003Ch3\u003ETravel to Brussels by coach (instead of Eurostar) from \u00A3639\u003C/h3\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
