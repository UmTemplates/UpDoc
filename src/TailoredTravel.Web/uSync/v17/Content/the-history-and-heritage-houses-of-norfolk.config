    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "45277191-64aa-468e-862a-fd3dc3b7b8a5",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBoutique hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "These are the main features in this suggested itinerary:"
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "4972b691-baae-49a5-82d1-b71168534392",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the boutique Best Western George Hotel in Norwich. Located a fifteen minute walk from the centre of Norwich, facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Our suggested accommodation for this tour:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "d24ca98c-874c-416a-9023-9669dcfeabbf",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EEly Cathedral \u0026amp; Stained Glass Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Norwich\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOxburgh Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESandringham Estate\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHolkham Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFelbrigg Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlickling Hall \u0026amp; Gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAnglesey Abbey \u0026amp; Gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For this suggested itinerary these are the main sights you will visit:"
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "5ec26c91-c120-431b-8f43-ee157afa275e",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003ENational Trust\u2019s Textile Conservation Studio\u003C/strong\u003E - guided tour of the centre entrusted with the careand conservation of the Trust\u2019s internationally important textile collections\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003ELittle Walsingham\u003C/strong\u003E - a place of pilgrimage from Saxon times and famous for its Shrine of Our Lady of Walsingham\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003ENorth Norfolk Railway\u003C/strong\u003E - a nostalgic return steam train journey from Sheringham to Holt with included cream tea\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003EHoughton Hall\u003C/strong\u003E - a thriving estate, reflecting nearly 300 years of history, while still dominated by the ebullient personality, energy and taste of Sir Robert Walpole\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003ECruise the Norfolk Broads\u003C/strong\u003E - ashort leisurely cruise from Wroxham explores the Broads at their very best\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "b773f1ac-4538-4d0a-a1ff-85918c8edbf0",
      "key": "d17894ab-7c2d-4275-aaae-04ddfbd5625a",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003ESingle room supplement \u00A379\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EInsurance\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EEntrance fees to places of interest (NT properties free to NT members)\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EAudio headphones\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EGratuities\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Extras"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "74abc869-f3ee-4aee-ae73-f87386df476b",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3 data-pm-slice=\u00220 0 []\u0022\u003EDay 1 \u2013 Ely Cathedral \u0026amp; Stained Glass Museum\u003C/h3\u003E\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 stop at a convenient property en route such as Ely Cathedral, the \u2018Ship of the Fens\u2019, famous for its Octagon and Lantern Towers and whose Stained Glass Museum displays over 100 original stained glass panels dating from the 13th century \u2013 check in at the boutique Best Western George Hotel in Norwich.\u003C/p\u003E\u003Ch3\u003EDay 2 \u2013 Norwich \u0026amp; Oxburgh Hall\u003C/h3\u003E\u003Cp\u003EGuided tour of Norwich, England\u2019s best preserved medieval city, takes in sights such as the Norman Castle, Norwich Cathedral and the City Hall \u2013 Oxburgh Hall, a moated manor house with a Tudor gatehouse and accessible Priest\u2019s Hole built by the Bedingfeld family who still live here, shows the development from medieval austerity to Victorian comfort and includes a display of embroidery by Mary Queen of Scots and Bess of Hardwick.\u003C/p\u003E\u003Ch3\u003EDay 3 \u2013 Sandringham Estate \u0026amp; Holkham Hall\u003C/h3\u003E\u003Cp\u003ESandringham Estate, built for Edward VII in 1870 and the much loved country retreat of Her Majesty the Queen, is set in 60 acres of splendid gardens and the museum houses extraordinary collections of royal vehicles, rare ceramics, photographs and memorabilia \u2013 Holkham Hall was conceived by Thomas Coke, the first Earl of Leicester, as his vision of an Italian villa on the windswept north Norfolk coast.\u003C/p\u003E\u003Ch3\u003EDay 4 \u2013 Felbrigg Hall \u0026amp; Blickling Hall and Gardens\u003C/h3\u003E\u003Cp\u003EThe 17th century country house Felbrigg Hall contains original 18th century furniture and is noted for its Jacobean architecture and fine Georgian interior \u2013 visit the National Trust\u2019s Blickling Hall and Gardens, one of England\u2019s great Jacobean houses, famed for its spectacular long gallery, superb plasterwork ceilings and fine collections of furniture, pictures, books and tapestries.\u003C/p\u003E\u003Ch3\u003EDay 5 \u2013 Anglesey Abbey \u0026amp; Gardens\u003C/h3\u003E\u003Cp\u003EStop at a convenient property en route home such as Anglesey Abbey and Gardens, a Jacobean style house built on the site of a 12th century Augustinian priory and containing a priceless art collection \u2013 return to our original departure points with comfort stops en route.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        }
      ]
    },
