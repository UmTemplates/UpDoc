    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "b07e83ca-0734-4363-9c4f-e5b5f893b5cb",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EScheduled flights to Spain\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EExecutive coach in Spain\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003EOne free place per 10 paying passengers\u003C/strong\u003E\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "43f95a5d-b2a2-428b-abef-690cc367342d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Olimpo Hotel at Playa de Isla. On a promontory in a huge estate and with direct access onto private beaches, facilities include a restaurant, bar and outdoor swimming pool. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "80a9ce03-effe-4237-bf4b-eb3c0f4e11ed",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuggenheim Museum, Bilbao\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFishing town of Castro Urdiales\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPicos de Europa mountain range\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAncient town of Potes\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESantillana del Mar\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPretty resort of Comillas\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESantander, Cantabria\u2019s capital\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "5d3bfcef-0667-4c72-bd07-d28c307bb536",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECab\u00E1rceno Natural Park - Europe\u2019s largest wildlife park is home to such animals as Bengal tigers, desert antelopes and elephants\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAltamira Cave - considered the Sistine Chapel of Prehistory, this replica of the UNESCO listed cave depicts bison, horses, deer, hands and mysterious signs\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEl Soplao Cave - our mine train excursion is followed by a walk through the \u2018rooms\u2019 to see a spectacular array of geological formations\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "f9f15b5c-fac5-4605-bf21-f211ce098d0f",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Playa de Isla\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Spain from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Olimpo Hotel at Playa de Isla.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guggenheim Museum at Bilbao \u0026amp; Castro Urdiales\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Guggenheim Museum in Bilbao, designed by the renowned American architect Frank O Gehry and displaying a wonderful collection of modern and contemporary art \u2013 travel the scenic coastal road to the fishing town of Castro Urdiales for free time or to visit the Santa Maria Church which is located on a high promontory above the port.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Picos de Europa, Potes \u0026amp; Fuente D\u00E9 Cable Car\u003C/h3\u003E\n\u003Cp\u003EThe beautiful Picos de Europa mountain range were reputedly christened the \u2018Peaks of Europe\u2019 by returning sailors for whom this was often the first sight of their homeland \u2013 Potes is a small ancient town with old balconied houses lining the river and a main square dominated by a 15th century defensive tower \u2013 option of taking the 900 metre ascent up the Fuente D\u00E9 Cable Car (subject to favourable weather conditions) from where you are rewarded with spectacular panoramic views across the Picos\u2019 peaks and valleys.\u003C/p\u003E\n\u003Cp\u003EDay 4 \u2013 Guided tour of Santander, Santillana del Mar \u0026amp; Comillas\u003C/p\u003E\n\u003Cp\u003EGuided tour of Santander, Cantabria\u2019s capital, takes in the Palacio de la Magdalena, a summer palace built for Alfonso XIII in 1912, reflecting the resort\u2019s popularity at the time with the Royal Family \u2013 Santillana del Mar, one of the prettiest towns in Spain, was established around a monastery and is surrounded by an ensemble of 15th to 17th century golden stone houses and you may choose to visit the Romanesque La Colegiata Church or explore the rustic Plaza Mayor \u2013 the pretty resort of Comillas is famed for its unusual buildings designed by Catalan Modernista architects Antonio L\u00F3pez y L\u00F3pez.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Bilbao\u003C/h3\u003E\n\u003Cp\u003EMorning at leisure in Bilbao \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
