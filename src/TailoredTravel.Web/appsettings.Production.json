{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error"
    }
  },
  "Umbraco": {
    "Forms": {
      "FormDesign": {
        "UseViewEngineFormThemeResolver": true
      }
    },
    "CMS": {
      "Runtime": {
        "Mode" : "Production"
      },
      "Hosting": {
        "Debug": false
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      }
    }
  }
}
