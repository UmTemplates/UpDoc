    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "a1456198-b310-4522-9346-8b3ab340629e",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "91ad87f3-dc0f-49ec-aa35-64dbfdd825b2",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "414dce68-905f-4152-b286-0be089ac1ae3",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Oxford Belfry Hotel. Located in a countryside setting thirteen miles from the famous university city of Oxford, facilities at the hotel include a restaurant, bar, indoor swimming pool and sauna. All rooms are en suite.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "34c812ae-052b-43e0-a9c1-692b4fe99fe2",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBlenheim Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIntroductory tour of Oxford\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Ashmolean Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAnne Hathaway\u2019s Cottage\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Stratford upon Avon\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EShakespeare\u2019s Birthplace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EShakespeare\u0026#39;s New Place\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECharlecote Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECompton Verney Art Gallery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChrist Church Picture Gallery\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "8410ca44-6138-49b4-a6a4-f959c3e1aabe",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBodleian Library - one of the oldest libraries in Europe includes the 17th century Convocation House where parliament was held during the Civil War and Duke Humfrey\u2019s medieval library whose former readers have included writers such as Oscar Wilde, CS Lewis and JRR Tolkien\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERadcliffe Camera - the first rotunda library built in Britain and the interior of the architectural icon of Oxford\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERoyal Shakespeare Theatre - a behind the scenes tour exploring both the public and private areas of the Theatre, the origins of the RSC and the theatre making process\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "7a1171b0-df05-4aad-b7c4-d0a8fb5d24b3",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Blenheim Palace\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 stop at a convenient property en route such as Blenheim Palace, the home of the 11th Duke of Marlborough and the birthplace of Sir Winston Churchill and set in beautiful parkland of 2,100 acres landscaped by \u2018Capability\u2019 Brown in the 1760\u2019s \u2013 continue to the 4* Oxford Belfry Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Oxford \u0026amp; The Ashmolean Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the City of Dreaming Spires taking in the architecture and traditions of Oxford\u2019s university and other famous buildings and institutions \u2013 The Ashmolean Museum was Britain\u2019s first public museum founded in 1683 and is home to the University of Oxford\u2019s world class collections of art and archaeology.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Anne Hathaway\u2019s Cottage, Shakespeare\u2019s Birthplace \u0026amp; Shakespeare\u0026#39;s New Place\u003C/h3\u003E\n\u003Cp\u003EAfter a scenic drive through the Cotswolds, visit Anne Hathaway\u2019s Cottage which was still owned by her descendants until the late 19th century and contains the Hathaway bed and many other items of furniture owned by the family \u2013 guided tour of Stratford upon Avon taking in Shakespeare\u2019s Birthplace, where rooms are furnished to recreate the interiors as they might have been in the 1570s and Shakespeare\u0026#39;s New Place, the site that was his family home for 19 years where we uncover the fascinating story of why the house is no longer there and discover beautiful gardens and specially commissioned artworks.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Charlecote Park \u0026amp; Compton Verney\u003C/h3\u003E\n\u003Cp\u003EThe National Trust\u2019s Charlecote Park has been home to the Lucy Family for over 700 years and its mellow brickwork and great chimneys seem to sum up the very essence of Tudor England \u2013 the award winning art gallery at Compton Verney is located in the setting of a Grade I listed Robert Adam mansion and our guided tour examines its outstanding collection of British, Neapolitan, Germanic and Chinese paintings.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Christ Church Picture Gallery\u003C/h3\u003E\n\u003Cp\u003EThe Picture Gallery at Christ Church in Oxford is one of the most important private collections of Old Master drawings in the country including works by Leonardo, Michelangelo, D\u00FCrer Raphael and Rubens \u2013 return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember this itinerary is just our suggestion. "
          }
        }
      ]
    },
