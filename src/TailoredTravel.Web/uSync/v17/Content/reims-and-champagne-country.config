        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003ETravel by Eurostar to Paris and then by coach to Reims\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EFor more (or fewer) days\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EInclude different excursions\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EInclude UK coach transfers for Eurostar tours\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EBring a specialist lecturer\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EInclude all entrance fees \u0026amp; gratuities\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "If you\u0027d like to adjust what\u0027s included, perhaps a different hotel standard, more or fewer days, or different excursions, here are some alternatives:"
