    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "99caf3fa-f7b0-4f4a-bf63-5093c4442afa",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe depart from our designated pick up points in our private executive coach and travel to Dover with our tour manager, for our P\u0026amp;O Ferries Channel crossing to Calais in Club Class. We continue to the centrally located 4* Radisson Blu Hotel in Rouen for a four night stay. A welcome dinner is included in our hotel this evening.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EThis morning we enjoy a guided walking tour of Rouen, where we see the picturesque half timbered houses and architectural treasures such as St Ouen Abbey. During our guided tour we visit the Cath\u00E9drale Notre-Dame, a Gothic masterpiece that is dominated by the famous west fa\u00E7ade. In the 1890s Claude Monet made almost 30 paintings of the Cathedral, several of which are now in the Mus\u00E9e d\u2019Orsay in Paris. This afternoon we enjoy a guided tour at the Mus\u00E9e des Beaux-Arts in Rouen, home to an outstanding collection of paintings, drawings and sculptures by renowned artists such as Caravaggio, Monet and Sisley.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EOur guided walking tour of Honfleur this morning takes in sights such as the Old Dock, the Lieutenancy and Saint Stephen\u0026#39;s Church. We then have an audio-guided tour at Mus\u00E9e Eug\u00E8ne Boudin, located in a 19th century chapel and named after the town\u2019s most famous painter. The museum is home to a fine collection of impressionist works by artists such as Boudin, Dubourg, Monet and Jongkind. On arrival back in Rouen this afternoon we embark on a guided tour at A\u020Btre Saint Maclou. The diverse history at this unique site dates back to the Great Plague of 1348, that killed 75% of the Parish. The A\u020Btre Saint Maclou was built as a plague cemetery. From 1661 to 2014, the buildings on the site were used as a place of education, and for over 120 years, educational activities took place alongside funeral activities.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EWe visit Monet\u2019s Gardens at Giverny this morning where the artist painted his Waterlilies series. The Water Garden is asymmetrical with an exotic Japanese feel to it and Monet came here repeatedly through his life, letting his imagination rove amid the complex interplay of water and light. We then visit the nearby Mus\u00E9e des Impressionnismes, dedicated to the history of Impressionism and its aftermath. A farewell dinner is included in our hotel this evening.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EAfter checking out of our hotel we have a guided tour of Ch\u00E2teau de Miromesnil, the birthplace of the French writer Guy de Maupassant. Four centuries of harmonious architectural styles are present in the ch\u00E2teau whilst the magnificent gardens are dominated by a cedar of Lebanon tree that is several centuries old. We then spend some time at leisure for lunch in Dieppe, before continuing to Calais for our P\u0026amp;O Ferries Channel crossing to Dover in Club Class, and onward travel back to our original pick up points.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
