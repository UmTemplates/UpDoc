    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "9fdd2b75-c949-4b33-9eef-b3af79e4414f",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "7e0b1811-e906-4eb5-b560-65fb97b81153",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* central Strasbourg hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "f3c6db8c-a1f0-4521-91f5-898f1cda4a91",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Grand Hotel Bristol located just a short walk from Colmar\u2019s historic centre. The hotel has a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "23bcf8f6-f783-480f-84d9-95fc90a13c50",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EColmar\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Colmar\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Unterlinden\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Strasbourg\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e des Arts D\u00E9coratifs\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e des Beaux-Arts\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBeyeler Foundation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKunstmuseum Basel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFreiburg\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "25bf7690-e1c1-4c48-8c20-1f374039cbac",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EEuropean Parliament - at the intersection of the River Ill and the Marne-Rhine Canal, the building is one of the biggest and most visible in Strasbourg\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Modern \u0026amp; Contemporary Art in Strasbourg - the collection boasts works by artists such as Monet, Picasso, Kandinsky and Brauner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EObernai - a delightful town set amongst vineyards on the eastern slopes of the Vosges Mountains with medieval ramparts and cramped lanes lined with halftimbered houses\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "43390228-03d7-4617-b16d-50964ddd9822",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Colmar\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Basel Mulhouse Airport \u2013 transfer with our tour manager in our private executive coach to the 4* Grand Hotel Bristol in Colmar.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Colmar \u0026amp; the Mus\u00E9e Unterlinden\u003C/h3\u003E\n\u003Cp\u003EA guided tour of the picture postcard town of Colmar, the capital of the Alsatian wine producing area, takes in sights such as the well preserved half-timbered houses in the old town lining the streets and canals and the Gothic church of St Martin \u2013 the Mus\u00E9e Unterlinden, housed in a 13th century Dominican convent and a 1906 former public baths building, is home to the Isenheim Altarpiece by Matthias Gr\u00FCnewald and features a large collection of local and international artworks and manufactured artefacts from prehistoric to contemporary times.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Guided tour of Strasbourg, Mus\u00E9e des Arts D\u00E9coratifs \u0026amp; Mus\u00E9e des Beaux-Arts\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Strasbourg takes in the major sights including the picturesque waterways and houses of Le Petit France and a visit to the Cathedral of Notre Dame, dating back to 1015 and an outstanding masterpiece of Gothic art \u2013 Strasbourg\u2019s Mus\u00E9e des Arts D\u00E9coratifs and Mus\u00E9e des Beaux-Arts are located within the stunning Palais de Rohan whose classical fa\u00E7ade and sumptuous interior make this one of France\u2019s finest architectural creations of the 18th century.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Beyeler Foundation \u0026amp; Kunstmuseum Basel\u003C/h3\u003E\n\u003Cp\u003EThe Beyeler Foundation in Riehen, near Basel, owns and oversees the world famous art collection of Hildy and Ernst Beyeler comprising 300 classic, modern and contemporary works including paintings and sculptures by Giacometti, Picasso, Matisse, Monet and Rousseau \u2013 continue to Basel with free time for lunch \u2013 a guided tour of the Kunstmuseum Basel explores the largest and most significant public art collection in Switzerland, ranging from Renaissance Old Masters to a collection of Picassos and, in the new building opened in 2016, paintings by Kline, Newman, Rothko and Still.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Freiburg\u003C/h3\u003E\n\u003Cp\u003ETime at leisure in the famous old university city of Freiburg, dominated by the ruins of three castles perched high on surrounding slopes \u2013 transfer to Basel Mulhouse Airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
