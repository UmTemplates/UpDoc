    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "3e7b181f-e439-45a0-a579-05f076462aac",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* central Nice hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "5ed79eba-7010-4e07-a131-d2a01993b779",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights at the centrally located 4* Splendid Hotel in Nice. Facilities at the hotel include a bar and restaurant and all rooms are en suite. Dinner is included the first evening and the remaining nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "a36f1869-1739-46d1-8096-5094941cb893",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ENice - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChapelle du Rosaire\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFondation Maeght\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESaint-Paul-de-Vence\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Renoir\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e des Beaux-Arts - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Matisse - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Marc Chagall - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVilla \u0026amp; Gardens of Ephrussi de Rothschild\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChapelle St Pierre, Villefranche\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "5685798e-9770-4f5e-b43f-36a0f56f54b5",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EFranciscan Monastery and Gardens - located in the fashionable Cimiez District on the hills overlooking Nice, its museum exhibits range from pictorial and sculptural artworks to manuscripts and prayer books, evoking the simplicity of the life of the monks\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVilla Kerylos - built between 1902 and 1908 for archaeologist Theodore Reinach in imitation of an ancient Greek residence, Villa Kerylos at Beaulieu sur Mer contains lovingly reproduced mosaics, frescoes and furniture\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e International d\u2019Art Naif - the former residence of perfume creator Fran\u00E7ois Coty provides a unique overview of the history of na\u00EFve painting from the 18th century to the present day\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Picasso at Antibes - a former residence of Monaco\u2019s ruling family, in 1946 Picasso used part of the castle as a studio and in gratitude donated all 150 works completed during his stay\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "079f76c5-4626-4ee3-b0ed-cf6bbab8305a",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Guided tour of Nice\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Nice from your preferred airport \u2013 guided tour of Nice takes in the narrow streets of the old town, the famous \u2018Promenade\u2019 and the heart of the city with its rich architectural and cultural heritage \u2013 transfer with our tour manager in our private executive coach to the 4* Splendid Hotel in Nice \u2013 dinner in the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Chapelle du Rosaire, Fondation Maeght, Saint-Paul-de-Vence \u0026amp; Mus\u00E9e Renoir\u003C/h3\u003E\n\u003Cp\u003EChapelle du Rosaire, a masterpiece of sacred art, was built between 1947 and 1951 and then decorated by Henri Matisse in gratitude to the nuns who nursed him during his illness \u2013 built in 1964 by Paris art dealers Aim\u00E9 and Marguerite Maeght, Fondation Maeght with its large collection of paintings, sculptures and drawings is one of Europe\u2019s finest museums of modern art, with paintings by artists such as Bonnard, Braque, Kandinsky and Chagall \u2013 built on a rocky outcrop and surrounded by ramparts built on the orders of Francois I, the medieval village of Saint-Paul-de-Vence is one of the most beautiful villages in Provence, inspiring numerous famous artists, writers and poets \u2013 continue to Mus\u00E9e Renoir in Cagnes-sur-Mer where Renoir lived for much of the later years of his life and where he took up sculpting for the first time, assisted by Richard Guino and Louis Morel.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Mus\u00E9e des Beaux-Arts, Mus\u00E9e Matisse \u0026amp; Mus\u00E9e Marc Chagall\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Mus\u00E9e des Beaux- Arts located in the former home of a Ukrainian princess explores works sent to Nice by Napoleon after Italy ceded the city to France in 1860 and a fine collection of Impressionist and Post-Impressionist paintings by artists such as Renoir, Monet and Dufy \u2013 guided tour at the Mus\u00E9e Matisse with a wonderful collection of works left by Henri Matisse to the city of Nice where he lived from 1918 to 1954 \u2013 a guided tour of the Mus\u00E9e Marc Chagall reveals large paintings, sculptures, stained glass windows, mosaics and tapestries depicting various biblical scenes.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Villa and Gardens of Ephrussi de Rothschild, Villefranche \u0026amp; Chapelle St Pierre\u003C/h3\u003E\n\u003Cp\u003EThrough the art dealers and experts she befriended, Baroness Ephrussi de Rothschild sought out artworks all over the world, transforming the Villa and Gardens of Ephrussi de Rothschild at Saint-Jean-Cap-Ferrat into a collector\u2019s paradise \u2013 Chapelle St Pierre at Villefranche, created in 1295 by Charles II d\u2019Anjou, is dedicated to the fishermen\u2019s patron saint and decorated by Jean Cocteau.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Nice\u003C/h3\u003E\n\u003Cp\u003ETime at leisure in Nice this morning \u2013 transfer to Nice airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
