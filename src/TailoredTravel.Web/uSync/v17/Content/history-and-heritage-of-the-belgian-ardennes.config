    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "174b6d40-991e-4cee-8618-125889cada80",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn P\u0026amp;O Ferries Channel crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "a41bbeb2-cc27-464d-9594-f84bf6721f42",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the 3* Ibis Styles Hotel on the outskirts of Namur. Facilities at the hotel include a restaurant and bar. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "93858ca1-f705-408f-ba1c-656913361dca",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ENamur\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFortress of Sedan\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBouillon Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDurbuy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETopiary Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECaves of Han - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBastogne War Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELa-Roche-en-Ardenne - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGardens of Annevoie\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "54d45fcc-ca0b-479e-9ccc-9c0378fe4730",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECanal du Centre - cruise on the Canal followed by a visit to the UNESCO listed Hydraulic Boat Lifts built at the beginning of the 19th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Jehay - distinguished by its famous checkerboard patterned walls, the Ch\u00E2teau is a stunning, rare example of Mosane Renaissance style from the mid-16th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECaves of Remouchamps - first opened to the public in 1912, the hall was occupied by Palaeolithic hunters 8,000 years ago and a boat trip glides without a sound along a winding subterranean river\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "e33dab36-388d-40c3-85d5-2d455d424a75",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Namur\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 continue to Namur and check in to the 3* Ibis Styles Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Fortress of Sedan \u0026amp; Bouillon Castle\u003C/h3\u003E\n\u003Cp\u003EThe Fortress of Sedan, completed in 1424 by Evrard de La Marck, the first Prince of Sedan, is the largest medieval fortress in Europe \u2013 with its stunning vaulted rooms and maze of underground galleries, Bouillon Castle overlooking the River Semois is one of the oldest and most impressive feudal buildings in Belgium.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Durbuy \u0026amp; Topiary Park\u003C/h3\u003E\n\u003Cp\u003EDurbuy is the smallest city in the world and during a walking guided tour there is the opportunity to taste local products including cheese, beer, charcuterie, pralines and jam \u2013 the Topiary Park at Durbuy covers one hectare and is home to over 250 plants and clipped hedges depicting animal and human figures.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Caves of Han \u0026amp; Bastogne War Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Caves of Han begins with a nostalgic tram journey to the entrance of one of the most beautiful caves in Europe with highlights of the caves being the gigantic Hall of the Dome and the Hall of the Draperies \u2013 the Bastogne War Museum focuses on the Second World War from its origins up to autumn 1944, specifically focusing on the Battle of the Bulge.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 La-Roche-en-Ardenne guided tour\u003C/h3\u003E\n\u003Cp\u003EA guided tour of La-Roche-en- Ardenne on board the Petit Train this morning contemplates the Battle of the Bulge which during a heavy bombing of the city between 21st December 1944 and 11th January 1945 resulted in the death of 114 people and the destruction of 350 houses \u2013 afternoon at leisure in La- Roche-en-Ardenne where you may choose to explore the remains of the feudal castle dating back to the 9th century.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Gardens of Annevoie\u003C/h3\u003E\n\u003Cp\u003EThe classical Gardens of Annevoie, designed and laid out between 1758 and 1776 by Charles-Alexis de Montpellier, blend French 17th century rigour with English fantasy and Italian charm and are widely regarded as one of the best gardens in Belgium \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
