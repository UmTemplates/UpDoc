    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "32e118e7-c4ba-4a18-9d31-c15db84d317b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Austria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "13321e90-2ebc-4fb5-ac4d-436be4d4cc65",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the family run 4* Hotel R\u00F6sslwirt in the idyllic village of Kirchberg. Facilities include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "b9ef8f17-4b87-400d-9604-13d4bf88e2ee",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESalzburg \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EInnsbruck \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERattenberg\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETratzberg Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPertisau \u0026amp; Lake Achensee\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EZell am See \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKirchberg\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "45bce10a-9ccf-4cae-a231-c5aee240b004",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EZiller Valley Steam Train - nostalgic steam train journey through the scenic Ziller Valley from Fugen to the resort of Mayrhofen\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKitzb\u00FChel - wander through the narrow cobbled streets, chic designer shops, coffee and cake houses and restaurants or take the cable to the top of the magnificent Hahnenkamm Mountain\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHellbrunn Palace - built by Prince-Archbishop Markus Sittikus who ruled Salzburg in the early 17th century and renowned for the \u2018Sound of Music\u2019 pavilion where Liesl and Franz secretly met\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "93bf65b8-c7df-43c5-9713-b31f4afe89a7",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Kirchberg\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Hotel R\u00F6sslwirt in Kirchberg.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Salzburg guided tour\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Salzburg, the home of Mozart and the \u2018Sound of Music\u2019, takes in the Hohensalzburg Fortress, the Cathedral, Mozart\u2019s birthplace and the Mirabell Palace and Gardens \u2013 free time at leisure to explore.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Innsbruck \u0026amp; Rattenberg\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Innsbruck, an enchanting medieval town set against the backdrop of the Austrian Alps and home to many art treasures such as the \u2018Golden Roof\u2019, the Cathedral St Jacob, the Imperial Palace and Ambras Castle \u2013 free time at leisure in the delightful medieval town of Rattenberg, the oldest in the Tyrol and famous for its glass crystal ware \u2013 dinner in the hotel this evening is followed by the option of a night of traditional culture and dance at the Tyrolean evening.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Tratzberg Castle, Pertisau \u0026amp; Lake Achensee\u003C/h3\u003E\n\u003Cp\u003ESitting atop a massive rock ledge with breathtaking views of the Inn Valley, a small train takes us to the entrance to the romantic medieval Tratzberg Castle and inside are the stunning Hapsburg Rooms, the Fugger Room with Renaissance art and a wonderful armoury collection \u2013 time to relax at Pertisau on Lake Achensee or an optional boat cruise on the Lake with a romantic steam journey on the Achensee train which dates back 120 years and offers breathtaking views of the surrounding mountain ranges.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Zell am See\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the picturesque lakeside resort of Zell am See taking in sights such as Constable\u2019s Tower and Castle Rosenberg \u2013 rest of the day is at leisure to explore the town.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Kirchberg\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before we transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
