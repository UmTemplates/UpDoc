    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "e4c49d4b-c35f-41c8-bdd6-30cd8a1c4a88",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECentral 4* Florence hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "1679c029-bb97-4546-912c-0e466d63fdd0",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the centrally located 4* Hotel Berchielli. Overlooking the Arno River and just a short distance from the Ponte Vecchio, facilities at the hotel include a bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "beb89292-5a44-46c7-97a8-626190b4383e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EOspedale degli Innocenti\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGalleria dell\u2019Accademia - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalazzo Medici Riccardi\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUffizi Gallery - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBasilica of Santa Maria del Santo Spirito\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECappella Branacacci\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Bargello\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Duomo \u0026amp; Museo dell\u2019Opera del Duomo\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "95fb190e-3812-457c-aa17-73d866ac3de0",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESiena \u0026amp; San Gimignano - leave Florence for a day by adding an extra day or removing a day from this itinerary to visit Siena and San Gimignano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Medici Chapels - in the vast complex of the Basilica of San Lorenzo, the parish church of the Medici family, Michelangelo designed the tombs of Lorenzo and Giuliano de\u0026#39; Medici, creating one of the masterpieces of the Italian Renaissance\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPitti Palace - formerly the residence of the grand dukes of Tuscany and the King of Italy, now home to important collections of paintings, sculpture and porcelain and a costume gallery, and located in the Boboli Gardens, one of the earliest Italian gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo di San Marco - housed in a former monastery erected between 1437 and 1452, it boasts frescoes by Ghirlandaio, Fra\u2019 Bartolomeo, while the dormitory cells are decorated with frescoes by Beato Angelico\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "b8113d0a-7bd4-4c85-8d61-3f178190ff98",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Florence\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Hotel Berchielli in central Florence.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Ospedale degli Innocenti, Galleria dell\u2019Accademia \u0026amp; Palazzo Medici Riccardi\u003C/h3\u003E\n\u003Cp\u003EOspedale degli Innocenti, originally an orphanage, is home to a collection of fifty works of art from the 14th to 18th centuries including Renaissance masterpieces such as the \u2018Adoration of the Magi\u2019 by Domenico del Ghirlandaio and \u2018Madonna and Child\u2019 by Sandro Botticelli \u2013 guided tour at Galleria dell\u2019Accademia, founded in 1563, explores a fine collection of art by an array of artists including Botticelli, Filippino Lippi and Fra Bartolomeo, and of course, Michelangelo\u2019s \u2018David\u2019 \u2013 Palazzo Medici Riccardi is the oldest Renaissance building in Florence.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Uffizi Gallery, Basilica of Santa Maria del Santo Spirito \u0026amp; Cappella Brancacci\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Uffizi Gallery, one of the world\u2019s finest art galleries housing Renaissance art from the 14th to 18th century and originally established by the Medici family \u2013 the Basilica of Santa Maria del Santo Spirito, designed by Brunelleschi in 1435, has 38 side altars decorated with 15th and 16th century Renaissance paintings \u2013 Cappella Brancacci contains wonderful frescoes on \u2018The Life of St Peter\u2019 commissioned by the Florentine merchant Felice Brancacci around 1424.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 The Bargello, the Duomo \u0026amp; Museo dell\u2019Opera del Duomo\u003C/h3\u003E\n\u003Cp\u003EIn a building dating back to 1255, a guided tour at The Bargello explores a wonderful medley of applied arts and Italy\u2019s finest collection of Renaissance sculpture \u2013 at the richly decorated Duomo, Europe\u2019s fourth largest church, we see the Campanile designed by Giotto and Brunelleschi\u2019s dome \u2013 the Museo dell\u2019Opera del Duomo is dedicated to the history of Florence\u2019s most famous landmark.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Florence\u003C/h3\u003E\n\u003Cp\u003EMorning free to explore the city at your leisure before the transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
