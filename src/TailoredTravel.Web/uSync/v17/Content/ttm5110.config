      "values": []
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "b1f4a907-3d62-4e85-9c31-7a06d5e28f14",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Kynren \u2013 An Epic Tale of England"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EYour tour includes reserved 3rd Category Superior Seats for the performance of \u2018Kynren \u2013 An Epic Tale of England\u2019. More details of the performance can be found at \u003Ca href=\u0022https://www.kynren.com\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Ewww.kynren.com\u003C/a\u003E\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "880a1707-d674-4f33-a100-39de922f9de8",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EKynren \u2013 An Epic Tale of England\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEntrance fees to non-National Trust properties included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGratuities \u0026amp; porterage included\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "ca3feed3-14b5-4ee8-be0c-78152bf45136",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay four nights on a half board basis at the 3* Gibside Hotel (\u003Ca href=\u0022https://www.gibside-hotel.co.uk\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Ewww.gibside-hotel.co.uk\u003C/a\u003E) at Whickham, four miles south west of Newcastle. Located in the centre of this historic village, facilities at the hotel include Paco\u2019s Restaurant that offers a high standard of cuisine and the Egyptian style Sphinx Bar with its superb panoramic views over the Tyne Valley. All rooms are en suite and feature telephone, television, tea \u0026amp; coffee making facilities and a hairdryer.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "3e57fcd7-d1e6-4a9d-8495-ebc84c3d25f6",
      "values": [
