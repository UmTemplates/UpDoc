    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "f3d10e0a-6b08-4132-bcae-4b508b84f2b6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEntrance fee to Sandringham Estate included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "2f80ed4b-4caa-4609-a5e0-b16b8fd5f781",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay four nights on a half board basis at the boutique 3* George Hotel in Norwich (\u003Ca href=\u0022https://georgehotel.co.uk/\u0022\u003Ehttps://georgehotel.co.uk/\u003C/a\u003E). Located a fifteen minute walk from the centre of Norwich, facilities at the hotel include a restaurant and bar. All rooms are en suite and feature telephone, television, hairdryer, and tea \u0026amp; coffee making facilities.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "79f73bc8-4b4d-41c7-952e-0cb1352938f6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organiser"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For more information on this tour contact your Group Organiser"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "725eb4dc-66a6-42c6-844e-49a570a40c7c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBeth Chatto\u2019s Gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENorwich \u2013 guided city tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENorwich Cathedral\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENorwich\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlickling Hall, Garden \u0026amp; Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFelbrigg Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESandringham Estate\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScenic drive along the North Norfolk coast road\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt Edmundsbury Cathedral at Bury St Edmunds\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "fcd6c6b5-a392-44ae-9bd2-a30a6679620f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "fda9c59e-c434-4514-9e0e-0f0312d27a52",
            "f3d10e0a-6b08-4132-bcae-4b508b84f2b6",
            "2f80ed4b-4caa-4609-a5e0-b16b8fd5f781",
            "725eb4dc-66a6-42c6-844e-49a570a40c7c",
            "e4dec3c8-03df-48b0-bca1-267a9dcd0f27",
            "3279fa4f-4fc9-4c95-80d9-a3d3328f1604",
            "79f73bc8-4b4d-41c7-952e-0cb1352938f6"
          ]
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "fda9c59e-c434-4514-9e0e-0f0312d27a52",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe depart in our private executive coach from our designated pick up point. En route to our hotel we visit Beth Chatto\u2019s Gardens in Essex. Began in 1960 from an overgrown wasteland with poor gravel soil and boggy hollows, it has been transformed into an informal garden harmonising with the surrounding countryside. We continue to the the 3* George Hotel for a four night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EOur Blue Badge guide meets us at our hotel this morning and accompanies us throughout the day. We firstly enjoy a guided coach and walking tour of Norwich, England\u2019s best preserved medieval city, taking in sights such as the Norman castle. During our guided tour we visit Norwich Cathedral, one of the finest in England with its magnificent cloisters and Cathedral Close. The afternoon is at leisure in Norwich and on an individual basis you may choose to visit the Sainsbury Centre for Visual Arts, shortlisted for the Art Fund Prize of Museum of the Year 2014. Modern European paintings and sculpture (including examples by Henry Moore, John Davies, Alberto Giacometti and Francis Bacon) sit alongside pieces from around the globe, sculpture from the ancient world and studio ceramics.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EWith our Blue Badge guide this morning we visit the National Trust\u2019s Blickling Hall, Garden and Park. One of England\u2019s great Jacobean houses, Blickling is famed for its spectacular long gallery, superb plasterwork ceilings and fine collections of furniture, pictures, books and tapestries. This afternoon we visit the National Trust\u2019s Felbrigg Hall, a 17th century country house containing original 18th century furniture and one of the largest collections of Grand Tour paintings by a single artist.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EThe Sandringham Estate is our destination today, set in 60 acres of splendid gardens and the much loved country retreat of the late Her Majesty the Queen. Built for Edward VII in 1870 the property was once described as \u2018Britain\u2019s most comfortable house\u2019 and the museum houses extraordinary collections of royal vehicles, rare ceramics, photographs and memorabilia. With our Blue Badge guide this afternoon we enjoy a scenic drive along the North Norfolk coast road.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EAfter checking out of our hotel and en route home we visit St Edmundsbury Cathedral at Bury St Edmunds, a place of worship for nearly 1,000 years. Taking carefully selected comfort stops en route, we return back to our original pick up point.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility concerns.\u003C/p\u003E\n"
          }
        }
      ]
    },
