    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "29b9adc9-cc0c-4729-9cd5-5d14bd690150",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "87ca2a88-9af0-4cc9-876b-794207845783",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights at the 4* Hotel Touring, located in central Bologna. The hotel has a terrace bar and all rooms are en suite. Dinner is served in the hotel on the first night and the remaining nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "acfdd40a-2c71-4775-804b-348b458f8e7c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Bologna\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPinacoteca Nazionale, Bologna - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Ferrara\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of 14th century Castello Estense\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Ravenna\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMosaics of St Vitale \u0026amp; the Mausoleo di Galla Placidia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMantova - Palazzo Ducale \u0026amp; Palazzo Te\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "de5ba2cd-db78-4659-9a70-229be7a7bc9f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EUrbino - set against a magnificent backdrop of medieval and Renaissance streets, Casa Natale di Raffaello was home to the painter Raphael and the Oratorio di San Giovanni Battista displays 15th century frescoes of the Crucifixion and the Life of John the Baptist by Giacomo and Lorenzo Salimbeni\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAnatomical Museum, Bologna - designed in an amphitheatre form in 1637 for the anatomy lessons by Bologna\u0026#39;s artist Antonio Paolucci and decorated with statues of celebrated doctors such as Hippocrates and Bartoletti\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELucca - visit the house in which Giacomo Puccini was born or the 11th century cathedral, an outstanding example of the exuberant Pisan-Romanesque style\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPinacoteca Nazionale, Ferrara - located in the Palazzo dei Diamanti and housing paintings from the Ferrara school from the Middle Ages up to the 18th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUniversity city of Parma - the Baroquestyle Farnese Theatre dates from 1618 and frescoes by Antonio da Correggio decorate the dome in the Cathedral and the Camera di San Paolo.\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EModena - the birthplace of Luciano Pavarotti and the Galleria Estense includes paintings by Bernini, Tintoretto and Veronese\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBasilica di Sant\u2019Andrea, Mantova - one of the major works of 15th century Renaissance architecture\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPisa - begun in 1173 on sandy silt subsoil, the Leaning Tower started to tilt even before the second storey was finished!\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPadova - one of Italy\u2019s oldest university towns and the setting for Shakespeare\u2019s \u2018Taming of the Shrew\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECappella degli Scrovegni, Padova - Giotto\u2019s beautiful frescoes depicting the life of Christ which became a powerful influence on the development of European art\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "21b5b7fc-3dd9-4abc-94fd-634adec66935",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Bologna\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the 4* Hotel Touring in Bologna \u2013 dinner at a local restaurant.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Bologna guided tour \u0026amp; Pinacoteca Nazionale\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the buildings and porticoed streets of Bologna, home to medieval palaces and the oldest university in Europe \u2013 afternoon guided tour of one of Northern Italy\u2019s finest galleries, the Pinacoteca Nazionale housing works of the great Northern Italian artists including Giotto, Raphael and Perugino.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Ferrara guided tour \u0026amp; Castello Estense\u003C/h3\u003E\n\u003Cp\u003ECity tour of Ferrara introduces us to one of the region\u2019s greatest walled towns and one of Italy\u2019s hidden gems with many attractive streets and medieval houses, a 12th century cathedral and the palaces of the d\u2019Este dynasty \u2013 afternoon guided tour of the 15th century frescoes, dungeons and the wonderful views from the Torre dei Leoni of the 14th century Castello Estense.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Guided tour of Ravenna\u003C/h3\u003E\n\u003Cp\u003EA full day in Ravenna, once the capital of Rome\u2019s Western Empire and one of the great seats of Byzantine art in Europe, and a guided tour takes in the burial place of Dante, the great Italian writer and politician, the magnificent Neonian Baptistery and the mosaics of Basilica di San Vitale and the Mausoleo di Galla Placidia.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Mantova - Palazzo Ducale \u0026amp; Palazzo Te\u003C/h3\u003E\n\u003Cp\u003EThe day is spent in Mantova \u2013 guided tour of the Palazzo Ducale, once one of Europe\u2019s largest palaces and now housing a wonderful art collection including the frescoes in the \u2018Camera degli Sposi\u2019 by Mantegna \u2013 visit the magnificent Palazzo Te and Giulio Romano\u2019s \u2018Room of Giants\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Bologna\u003C/h3\u003E\n\u003Cp\u003EMorning free in Bologna before the transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
