    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "825bbd20-915c-430a-9cf4-cab083f0b0e7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "4b905a1c-1bdd-41b5-bf74-0515f515977a",
            "def204cf-8c79-41e0-9953-811bd228da9e",
            "259eda7b-5767-4a19-a342-d2e378f8aca7",
            "f772bd4c-a581-4fbf-866d-3f0ef50420ee",
            "aaccea5d-667b-4054-94e1-b77a4fa2884f",
