    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "3f0b5d99-d87d-461e-8de2-cb6e3b1716b0",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "54a58519-30c1-4371-9948-5043b8249b69",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EONE FREE PLACE PER 10 PAYING PASSENGERS\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "710e96d2-e1e0-4125-95cd-a65b19fec910",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the 3* Peebles Hydro Hotel on the outskirts of Peebles. Facilities include a restaurant, bar and an indoor swimming pool. All rooms are en suite.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "1866d205-cb0c-4f29-bf8e-2d66a1f3b6ef",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EDrumlanrig Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBowhill House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAbbotsford House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETraquair House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMellerstain House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EManderston\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFloors Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDumfries House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESizergh Castle \u0026amp; Gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "59b3f85e-7560-49b3-8585-816a0c1ca1ca",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EFord and Etal Estate - home to the Joicey family for over 100 years, the estate is centred on the villages of Ford and Etal in the valley of the River Till between the Scottish Borders and the Cheviot Hills and a guided tour takes in Lady Waterford Hall, commissioned in 1860 by Louisa Anne, Marchioness of Waterford, and the 14th century Etal Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPaxton House - built for a German princess in 1756 by John and James Adam, this is one of the finest Palladian houses in Britain containing the preeminent Scottish collection of Chippendale furniture and acting as an outstation of the National Galleries of Scotland\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "345215cd-c8e1-4020-8265-594e245a5153",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Drumlanrig Castle\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 en route we visit the ancient Douglas stronghold of Drumlanrig Castle, perhaps the most romantic of Scotland\u2019s great houses with a fine collection of silver, porcelain, French furniture and art \u2013 check in to the 3* Peebles Hydro Hotel on the outskirts of Peebles.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Bowhill House \u0026amp; Country Estate and Abbotsford House\u003C/h3\u003E\n\u003Cp\u003EBowhill House and Country Estate is home to the Duke and Duchess of Buccleuch and Queensberry and a part of the internationally renowned Buccleuch art collection \u2013 Abbotsford House, built and lived in by the 19th century novelist Sir Walter Scott, is stunningly located by the banks of the River Tweed in the heart of a landscape that inspired the poetry and novels of its creator.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Traquair House \u0026amp; Mellerstain House\u003C/h3\u003E\n\u003Cp\u003EDating back to 1107, Traquair House is said to be the oldest inhabited house in Scotland and has been visited by 27 monarchs, including Mary Queen of Scots \u2013 Mellerstain House is an exquisite Robert Adam stately home built between 1725 and 1778 with the library being regarded as one of Robert Adam\u2019s finest creations.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Manderston \u0026amp; Floors Castle\u003C/h3\u003E\n\u003Cp\u003EManderston, completely rebuilt between 1903 and 1905, boasts not only sumptuous State rooms and bedrooms, decorated in the Adam manner, but also all the original domestic offices and a truly \u2018upstairs downstairs\u2019 atmosphere \u2013 Floors Castle, originally built for the 1st Duke of Roxburghe in 1721, is home to a fine collection of priceless European paintings, tapestries and furnishings.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Dumfries House\u003C/h3\u003E\n\u003Cp\u003EDesigned 250 years ago by architect brothers John, Robert and James Adam, Dumfries House is an imposing Palladian mansion nestled within 2,000 acres of scenic Ayrshire countryside and is widely acknowledged as one of the most architecturally significant stately homes within the United Kingdom.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Sizergh Castle \u0026amp; Gardens\u003C/h3\u003E\n\u003Cp\u003EEn route home we visit the National Trust\u2019s Sizergh Castle and Gardens in Cumbria, a medieval house extended in Elizabethan times and surrounded by beautiful grounds.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember this itinerary is just our suggestion. "
          }
        }
      ]
