      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "49c66e54-af59-47c5-a28b-ca0ee7a4081d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Budapest hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Budapest\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Hungary\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "7b0d81d7-8f3a-469a-a3c7-929b35b4b49a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights at the 4* Mercure Korona Hotel, located opposite the National Museum and a few minutes walk from the River Danube. Facilities at the hotel include a restaurant and bar and all rooms are en suite. A welcome dinner is served in our hotel on the first evening and the remaining three nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "3dfa34f9-3c75-430c-a8d5-4952d847cf43",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBudapest guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EParliament House - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDohany Synagogue\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EJewish Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESzentendre\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHungarian Open Air Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERiver Danube cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDanube Bend\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEsztergom\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVisegrad\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESissi Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "ae2087d1-a095-4175-9bc2-32d980d1966e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Fine Arts - home to reputedly the best Spanish collection outside Spain and an excellent Venetian collection (particularly Titian and Giorgioni)\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHouse of Hungarian Art Nouveau - a collection of furniture, pottery and paintings in Secession style gives an insight into the atmosphere of bourgeois life of Budapest before the First World War\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHungarian National Museum - dedicated to the history of Hungary from the first three hundred years (1000-1301) of the Hungarian kingdom up to the rise and fall of the Communist system in Hungary\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Hungarian State Opera House - with its neo-Classical and neo-Renaissance design was one of the most imposing opera houses of its day\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHungarian National Gallery - tracing the development of Hungarian art from the 10th century with an impressive collection of paintings dating from 19th and 20th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFrans Liszt Academy - the only music academy in the world that was founded by Liszt himself and one of the most impressive examples of Central European Art Nouveau architecture\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "5d39e86a-67e1-4e52-b1e8-c35b4f86b423",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Budapest\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Budapest from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the 4* Mercure Korona Hotel in Budapest \u2013 dinner in our hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Budapest guided tour \u0026amp; Parliament House\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Budapest, a city full of Baroque and Art Nouveau architecture, reveals the characters of the once rival cities of Buda and Pest separated by the Danube and takes in the Buda Castle, Matthias Church and Fisherman\u2019s Bastion \u2013 guided tour of the magnificent neo-Gothic Parliament House, one of Budapest\u0026#39;s finest architectural achievements and the home of the Holy Hungarian Crown, the splendid Session Room, the impressive central staircase and the wonderful Great Vaulted Hall.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Dohany Synagogue, Jewish Museum, Szentendre, Hungarian Open Air Museum \u0026amp; River Danube cruise\u003C/h3\u003E\n\u003Cp\u003EDohany Synagogue, built in 1859 in the Moorish Revival style, seats nearly 3,000 people, and is the second largest synagogue in the world \u2013 the rich and vast collection of the neighbouring Jewish Museum makes it the second largest Jewish museum in Europe \u2013 time at leisure for lunch in Szentendre \u2013 the Hungarian Open Air Museum is a 60 acre complex contemplating the architecture and culture of rural Hungary \u2013 included scenic one way cruise on the River Danube between Szentendre and Budapest.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Danube Bend, Esztergom \u0026amp; Visegrad\u003C/h3\u003E\n\u003Cp\u003EA day exploring the Danube Bend begins at the imposing hilltop Basilica in Esztergom, a town whose history stretches back to the days of Saint Stephen \u2013 at Visegrad visit the Upper Castle, the remains of the Early Renaissance summer palace of King Matthias Corvinus of Hungary and the museum in the Solomon Tower to see exhibitions on the history of the palace.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Sissi Palace\u003C/h3\u003E\n\u003Cp\u003ESissi Palace in G\u00F6d\u00F6ll\u00F3, built in the 1760s and given as a coronation gift to Emperor Franz Joseph and Queen Elizabeth (affectionately known as Sissi) in the 1870s, is a beautiful Baroque castle \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
