@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using TailoredTravel.Web.Models

@{
    Layout = null;
    var siteSettings = Model.Root().FirstChild<SiteSettings>();

    string styleAttribute = "";

    // Get the background image from pageSettingsBackgroundImagePicker
    var backgroundImage = Model.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("pageSettingsBackgroundImagePicker");

    if (backgroundImage != null)
    {
        styleAttribute = $"background-image: url({backgroundImage.GetCropUrl("content12Col")}&format=webp);";
    }

    // Country palette identifier (Phase E).
    //
    // TEMPORARY on two counts:
    //   1. Country slug is derived from a page Name (slugified). Editors
    //      renaming a destination would break the slug → SCSS selector
    //      linkage silently. To be replaced with a stable property
    //      identifier once the content-architecture review lands. #335.
    //   2. For Group Tour pages, the country comes from the first item in
    //      the destinations MultiNodeTreePicker, which is currently
    //      hardcoded on groupTour rather than carried by a composition.
    //      Reading the property by alias works regardless — but the
    //      composition refactor is the proper structural fix.
    //
    // Page types that emit the attribute:
    //   - Destination pages (parent is "destinations") — slug from own Name.
    //   - Group Tour pages — slug from first destination's Name.
    //
    // Group Tours index, Home, About, etc. emit nothing (no country scope).
    string? countrySlug = null;
    IPublishedContent? countrySource = null;

    if (Model.Parent<IPublishedContent>()?.ContentType.Alias == "destinations")
    {
        countrySource = Model;
    }
    else if (Model.ContentType.Alias == "groupTour" || Model.ContentType.Alias == "tailoredTour")
    {
        countrySource = Model
            .Value<IEnumerable<IPublishedContent>>("destinations")?
            .FirstOrDefault();
    }

    if (countrySource is not null)
    {
        countrySlug = countrySource.Name?
            .ToLowerInvariant()
            .Replace("&", "and")
            .Replace(" ", "-");
    }
}

<!doctype html>
<html lang="en"@(countrySlug is null ? null : Html.Raw($" data-theme-country=\"{countrySlug}\""))>
<head>
    <script>
        // Apply stored theme preferences before first paint to prevent FOUC
        (function() {
            var mode = localStorage.getItem('theme') || 'auto';
            var palette = localStorage.getItem('palette') || 'tailored-travel';
            if (mode === 'auto') {
                mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', mode);
            document.documentElement.setAttribute('data-bs-theme-palette', palette);
        })();
    </script>
    <partial name="Head/_meta" model="new MetaViewModel(Model, siteSettings)" />

    @*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">*@
    <link href="~/css/index.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://use.typekit.net/pxg4txn.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">


    <!-- START HIGHLIGHT JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.8.0/build/styles/github-dark.min.css">
    <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.8.0/build/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    <!-- END HIGHLIGHT JS -->
    <!-- START HIGHLIGHT JS COPY APP (https://github.com/arronhunt/highlightjs-copy) -->
    <script src="https://unpkg.com/highlightjs-copy@1.0.3/dist/highlightjs-copy.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/highlightjs-copy@1.0.3/dist/highlightjs-copy.min.css">
    <script>hljs.addPlugin(new CopyButtonPlugin());</script>
    <!-- END HIGHLIGHT JS COPY APP -->
    <!-- Start Google Fonts - Lato -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    <!-- End Google Fonts - Lato -->

    @* Umbraco Forms client-side validation framework (ASP.NET Client Validation) *@
    @Html.RenderUmbracoFormDependencies(Url)

</head>
<body data-bgimage="@backgroundImage?.GetCropUrl("content12Col")" style="@styleAttribute" class="bg-body-tertiary">
    @* <div class="bg-indigo-500 p-2 text-dark bg-opacity-50" style="width: auto; height: 320px; display: block">xxxxxxxxxxxx</div> *@
    <div class="document d-flex flex-column justify-content-between">
    <!-- START HEADER -->
    <partial name="FeaturesGlobal/header" model="siteSettings" />
    <!-- END HEADER -->
    <!-- START NAVBAR -->
    <partial name="FeaturesGlobal/navbar" model="siteSettings" />
    <!-- END NAVBAR -->
    <main role="main" class="pb-3 flex-grow-1">
        @RenderBody()
    </main>
    <!-- START FOOTER -->
    <partial name="FeaturesGlobal/footer" model="siteSettings" />
    <!-- END FOOTER -->
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <!-- Add Bootstrap Icons CDN if not already included -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">


    <script src="~/js/theme-toggler.js"></script>
    <script src="~/js/image-rotator.js" defer></script>
    <script src="~/js/share.js" defer></script>
</body>
</html>