    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "be2443db-c064-491a-99ec-31baf0faae07",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "66a5fe0a-9fac-4639-93bb-356cc3475eb1",
            "e7eed7a7-6877-4d26-81d0-d19d8a11c274",
