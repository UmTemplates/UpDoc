    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "4e673f06-0509-4179-97c5-7c1f2b7e5d6b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in Portugal\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Porto\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Portugal\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "3bda0446-c6ba-4cab-a32e-3391726c25fb",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the centrally located 3* Grande Hotel do Porto. Facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "07fa35f3-6ad5-4575-9cad-551fa3eb0f64",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Porto\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseu Soares dos Reis\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERiver Douro cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDinner at Taylor\u2019s Port Lodge\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBraga \u0026amp; Bom Jesus do Monte\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuimar\u00E3es\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECasa da M\u00FAsica \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMajestic Caf\u00E9\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBritish Factory House\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "b67d4f39-d1db-42ef-99f4-eb3c26b46b71",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAmarante - rows of 17th century mansions with brightly painted wooden balconies line its narrow streets and the spectacular S\u00E3o Gon\u00E7alo Bridge dates back to the 13th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIgreja do Carmo - a magnificent example of late Baroque architecture by master Francisco Pereira Campanh\u00E3 and an extraordinary outside wall covered in blue and white azulejo tiles\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESantiago de Compostela - combine with a two to three night stay in Santiago de Compostela which in the Middle Ages was Christendom\u2019s third most important place of pilgrimage after Jerusalem and Rome\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "c887fc6e-7f34-4671-ada9-15c395a598a8",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Porto\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Porto from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the centrally located 3* Grande Hotel do Porto.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Porto, Museu Soares dos Reis, River Douro cruise \u0026amp; dinner at Taylor\u2019s Port Lodge\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Porto, Portugal\u2019s second largest city and one of the most ancient in Europe, takes in the S\u00E3o Francisco Church, the Pal\u00E1cio da Bolsa (the Stock Exchange Palace) including the truly lavish Arab Room where heads of state are received, and the azulejo tile panels depicting scenes of Portuguese history at S\u00E3o Bento Railway Station \u2013 named after the country\u2019s leading 19th century sculptor, Museu Soares dos Reis is home to a fine collection of art, including paintings by the 16th century master, Frey Carlos and the Impressionist, Henrique Pous\u00E3o \u2013 a 50 minute cruise on the River Douro allows us to see the city from a different perspective \u2013 dinner and a port tasting are included at Taylor\u2019s Port Lodge this evening.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Braga, Bom Jesus do Monte \u0026amp; Guimar\u00E3es\u003C/h3\u003E\n\u003Cp\u003EIn Braga, the seat of Portugal\u2019s archbishops and the country\u2019s religious capital since the 12th century, Bom Jesus do Monte stands as Portugal\u2019s most spectacular religious sanctuary and is famous for its giant Baroque Escadaria stairway of Bom Jesus which was designed by the Archbishop of Braga in 1722 \u2013 framed by gently rising hills and celebrated as the birthplace of the nation, King Afonso Henriques chose Guimar\u00E3es as his capital in 1139 and a guided tour takes in the narrow streets of the medieval quarter, the cobbled Rua de Santa Maria and the Castelo de S\u00E3o Miguel.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Casa da M\u00FAsica, Majestic Caf\u00E9 \u0026amp; the British Factory House\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Casa da M\u00FAsica, conceived in 2001 to mark Porto\u2019s year as Cultural Capital of Europe and a 2007 winner of the European Award of the Royal Institute of British Architects \u2013 time for tea at the Majestic Caf\u00E9, a traditional hang out for intellectuals and voted the sixth most beautiful coffee house in the world \u2013 the British Factory House was originally founded in 1654 as a commercial association between merchants in Porto engaged in trading wool, cod and wine with Britain and a guided tour explores the present building that was designed in Palladian style and opened in 1790 by the British Consul, John Whitehead.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Porto\u003C/h3\u003E\n\u003Cp\u003EMorning at leisure to enjoy Porto \u2013 transfer to Porto airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
