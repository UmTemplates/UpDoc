    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "5ad78fe1-d7d4-479f-b677-fb09f9f78091",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "94390ef3-9f16-4b1e-98d8-722674a5a5af",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Bruges hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "d8593b97-e422-4153-94e5-dc65743a2c99",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights at the centrally located 4* Academie Hotel in Bruges. Located under a fifteen minute walk from the market square, facilities at the hotel include a breakfast room and bar and all rooms are en suite. Dinner is included in a local restaurant on the first evening and the remaining nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "bde354b5-349d-49a3-bf70-f8aec2fd8d92",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAntwerp - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERockox House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECruise of the Port of Antwerp\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBruges - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChoco Story\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGhent - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGhent Museum of Fine Arts\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EYpres\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E\u2018In Flanders Field\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "f993a311-43d8-4048-b14c-966615c23641",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBrussels - a guided tour takes in the Grand Place, the Royal District and the Louise District\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGhent canal cruise - to see the splendid Gothic merchants\u2019 houses from their best side\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELille - a guided tour, time at leisure or visit the Palais des Beaux Arts, one of France\u2019s most important galleries\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "b3106f9a-bcf9-41dc-bcb8-097759c03fd2",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Bruges\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 continue to the 4* Academie Hotel in Bruges \u2013 dinner in a local restaurant.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Antwerp guided tour, Rockox House \u0026amp; cruise of the Port of Antwerp\u003C/h3\u003E\n\u003Cp\u003EFull day in Antwerp \u2013 guided city tour of the Great Market Square, Town Hall, Butchers Guild House and the Cathedral of our Lady \u2013 Rockox House, the 17th century home of Antwerp mayor, Nicolaas Rockox, a friend of Rubens, contains a fine collection of paintings by artists such as van der Weyden, Memling, van Eyck, Rubens and van Dyck \u2013 a ninety minute cruise through the Port of Antwerp, the second largest port in Europe.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Bruges guided tour \u0026amp; Choco Story\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Bruges, famous for lace making, chocolate and its picturesque network of canals and whose historic city centre is included on UNESCO\u2019s World Heritage List \u2013 visit Choco Story, a museum dedicated to chocolate \u2013 an optional short cruise on the picturesque canals of Bruges to see the city from a different perspective.\u003C/p\u003E\n\u003Cp\u003EDay 4 \u2013 Ghent guided tour \u0026amp; Ghent Museum of Fine Arts\u003C/p\u003E\n\u003Cp\u003EGuided tour of Ghent, once the ancient capital of Flanders and birthplace of Emperor Charles V, includes a visit St Bavo Cathedral with the famous 24-panel altarpiece \u2018The Adoration of the Mystic Lamb\u2019 \u2013 the collection at Ghent Museum of Fine Arts ranges from 19th century Realism, Romanticism, Impressionism, Symbolism and Expressionism to 20th century Surrealism including two works by Hieronymus Bosch.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Ypres \u0026amp; \u2018In Flanders Field\u2019\u003C/h3\u003E\n\u003Cp\u003EAt Ypres you may choose to visit the arch of the Menin Gate which bears the names of almost 55,000 men lost in First World War and whose bodies were never found \u2013 the \u2018In Flanders Field\u2019 interactive museum creates an impression of life during the First World War through the use of historical objects, documentary films, audio visual reminders and scale models \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
