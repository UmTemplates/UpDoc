    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "937a64f4-a635-4aa9-b347-d84e77804980",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "a1053e8f-9a6c-491e-a8a8-0133334e6271",
            "b5870db4-9a48-40f6-9a97-6f3b917d215b",
            "c8bb195b-f956-476b-84b0-64a86744b347",
            "d8d7f413-a206-49cf-92ac-2f70f670c2ef",
