    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "8e3d0c9b-89c1-4464-9c0e-8d8f3360082d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tours at every venue\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Prague\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in the Czech Republic\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "3726f876-9f9f-4711-b35c-e22b6c78ae9f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Majestic Plaza Hotel. Located 300 metres from St Wenceslas Square, facilities include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "3383f388-87c7-4417-bb87-073d9d3c97bb",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Prague\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EConvent of St Agnes of Bohemia - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPrague Castle Complex\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt George\u2019s Basilica - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKonopiste Castle - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESternberg Palace - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "8ea47e9d-d14b-4bc6-8463-c260ca41ab36",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EObecni Dum (Municipal House) - a national cultural landmark and one of the best Art Nouveau buildings in Prague, Jan Preisler and Mikol\u00E1\u0161 Ale\u0161, the most significant Czech painters and sculptors of the time, participated in its decoration\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERiver Vltava cruise - with coffee and cake on board to see the city from a different perspective\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EStaromestske Namesti - Romanesque, Baroque and Gothic style buildings and the 15th century Astronomical Clock have made this one of the most beautiful squares in Europe\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "41e7c863-2a94-4047-b513-8db3cb7bda39",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Prague\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Prague from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the 4* Majestic Plaza Hotel in central Prague.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Prague guided tour \u0026amp; Convent of St Agnes of Bohemia\u003C/h3\u003E\n\u003Cp\u003EGuided walking tour of Prague taking in sights such as Wenceslas Square, the Jewish Quarter and Charles Bridge \u2013 guided tour of the 13th century Convent of St Agnes of Bohemia, now home to the National Gallery\u2019s collection of \u2018Medieval Art in Bohemia and Central Europe\u2019 with works from 14th century Czech artists as well as 15th and 16th century works by central European artists.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Prague Castle \u0026amp; St George\u2019s Basilica\u003C/h3\u003E\n\u003Cp\u003EOriginally the residence of Bohemian kings and today the seat of the Czech president, our guided tour of Prague Castle Complex takes in some of Prague\u2019s best sights, including the Cathedral of St Vitus, the Powder Tower, the Old Royal Palace and the Golden Lane as well as wonderful views out over the Vltava River with the old town in the background \u2013 guided tour of St George\u2019s Basilica, established in 920 as Bohemia\u2019s first convent and the best preserved Romanesque church in Prague.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Konopiste Castle\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Konopiste Castle, once the palatial residence of the illfated Archduke Franz Ferdinand, and whose richly decorated chambers are adorned with collections he inherited from Modena\u0026#39;s house of d\u0026#39;Este and numerous trophies testifying to his passion for hunting \u2013 return to Prague for the rest of the day at leisure.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Sternberg Palace\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Sternberg Palace, named after Franc Josef Sternberg who founded the Society of Patriotic Friends of the Arts in Bohemia in 1796, and home to the National Gallery\u0026#39;s valuable collection of 14th to 18th century European art, including works by Goya, Rembrandt, Rubens and Donatello \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
