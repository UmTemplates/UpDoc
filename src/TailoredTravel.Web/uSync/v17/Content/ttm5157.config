    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "c7ed4639-2968-4ef9-8cce-177d7dd832b1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe meet at Bristol Airport for our direct scheduled flight to Lisbon. On arrival in Lisbon we are met by our professional guide who will accompany us on all transfers and included daily excursions. We then transfer by private executive coach to the centrally located 4* Sana Metropolitan Hotel in Lisbon for a five night stay. A welcome drink is included in our hotel before dinner this evening.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EOur full day in Lisbon begins with a guided city tour taking in sights such as the Belem Tower, Pedro Square, the Medieval Quarter of Alfama and the Hieronymite Cathedral. During our tour we visit the beautiful 16th century Mosteiro dos Jer\u00F3nimos, the most impressive symbol of Portugal\u2019s power and wealth during the Age of Discovery which was constructed in 1502 to commemorate Vasco da Gama\u2019s voyage to India. We then visit the Pal\u00E1cio dos Marqueses de Fronteira, one of the most beautiful residences in Lisbon, and its Room of the Battles is adorned with glazed tiles representing scenes of the Portuguese Restoration War while the stunning gardens boast some of the country\u0026#39;s finest tiles depicting hunting, battles and religious scenes.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EThis morning we visit the idyllic mountain town of Sintra, adored by artists and writers from all over the world. On arrival we visit the UNESCO listed Pal\u00E1cio Nacional da Pena at Sintra, one of the best examples of 19th century Romanticism in the world. Pal\u00E1cio Nacional de Queluz is our destination this afternoon. Commissioned in 1747, the architect Mateus Vicente de Oliveira transformed Prince Dom Pedro\u2019s occasional hunting lodge into a special summer palace now known as the \u2018Portuguese Versailles\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EThis morning we have a guided tour at the Museu Gulbenkian in Lisbon. One of Europe\u0026#39;s unsung treasures, it houses a magnificent collection of Egyptian, Greek, Roman, Islamic, Asian and European art. Our guided tour introduces us to masterpieces by Frans Hals, Rubens, Rembrandt, Fragonard and Gainsborough. The rest of the day is at leisure in Lisbon.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EThis morning we visit Sesimbra, a picturesque fishing village once occupied by the Romans and later the Moors until King Sancho II conquered its heavily defended forts in 1236. Here we visit the Moorish Castle, offering wonderful panoramic views from the ramparts. We continue to the small hill town of Palmela where you have time at leisure to explore sights such as the Church of S\u00E3o Pedro with its 18th century tiles depicting scenes from the life of St Peter. We then enjoy an included tour and tasting at a carefully selected wine cellar in Palmela. We return to Lisbon this afternoon via the scenic Parque Natural da Arr\u00E1bida, established to protect the wild, beautiful landscape. A farewell dinner is included in our hotel this evening.\u003C/p\u003E\n\u003Ch3\u003EDay 6\u003C/h3\u003E\n\u003Cp\u003EWe return to Lisbon Airport for our direct scheduled flight back to Bristol.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
