    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "a0c4200f-60ff-45b9-8c6d-50d64bc9c82a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Vienna hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETwo dinners included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EA full programme of included excursions \u0026amp; guided tours\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll entrance fees included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIncluded River Danube cruise on Day 3\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour at every gallery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights from Heathrow to Vienna\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELocal professional guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Austria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAudio headsets included on Days 2 to 5\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "4dcfb4b5-deef-4c8a-b202-9cffe94b2b2a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay five nights at the 4* Parkhotel Sch\u00F6nbrunn in Vienna (\u003Ca href=\u0022http://www.austria-trend.at/en/hotels/parkhotel-\u0022\u003Ewww.austria-trend.at/en/hotels/parkhotel-\u003C/a\u003E schonbrunn). Located in close proximity to Hietzing underground station which is seven stops away from Karlsplatz in central Vienna, facilities at the hotel include a restaurant and a bar. All of our allocated Classic Rooms are ensuite and feature television, telephone, and a minibar. A set three course dinner without drinks is included at our hotel on Day 1, and at a carefully selected local restaurant on Day 5. The remaining 3 nights are on a bed and breakfast basis.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "1676b74f-4d29-4d24-b6ed-084763a9fa96",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
