    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "84336a1c-0365-454f-be6d-0dd365bde408",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECentral 4* Rome hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Rome\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "446d6955-8e7d-426b-b735-93afa6a3f2f0",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Della Conciliazione Hotel. Located a short walk from St Peter\u2019s Basilica, the hotel has a bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "363ebc77-f392-4244-b7f7-31ca7b38a04c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Ancient Rome\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGalleria Borghese - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVatican Museum - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESistine Chapel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt Peter\u2019s Basilica\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECastel Sant\u2019Angelo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalazzo Doria Pamphilj\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChurch of San Luigi dei Francesi\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Pantheon\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECatacombs - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "835efca8-3341-4ec2-af82-5e53d2dea560",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Nazionale Etrusco - housed in the Villa Giulia is the world\u0026#39;s outstanding collection of Etruscan art, jewellery and artefacts including the terracotta funerary monument and the Sarcophagus of the Spouses dating from 530BC\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESanta Maria Sopra Minerva - one of Rome\u0026#39;s most beautiful churches holds the body of St Catherine of Siena who convinced the popes to return to Rome from Avignon in 1377\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECarafa Chapel - boasts frescoes by Filippino Lippi\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGalleria Nazionale d\u0026#39;Arte Antica - houses works from the 12th to 17th centuries including paintings by Caravaggio, Andrea del Sarto, the famous \u2018La Fornarina\u2019 by Raphael, a portrait of Henry VIII by Hans Holbein and a bust of Urban VIII by Bernini\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETivoli - a favourite retreat for poets and Rome\u2019s wealthier citizens, a tour of the ruins of Hadrian\u2019s Villa explores one of the largest and most spectacular villas ever built in the Roman Empire\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChurch of Santa Maria del Popolo - on the elegant Piazza del Popolo, its walls and ceilings are decorated with paintings by Pinturicchio, Raphael, Carracci, Caravaggio and Bernini\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "0a4ea306-92e8-4918-ab8a-40cb958e9dbf",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Rome\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Rome \u2013 transfer with our tour manager in our private executive coach to the 4* Della Conciliazione Hotel in central Rome.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Ancient Rome \u0026amp; Galleria Borghese\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Ancient Rome taking in such sights as the Forum, Circus Maximus and the Colosseum \u2013 a guided tour of Galleria Borghese, one of Rome\u2019s most beautiful galleries, introduces a marvellous collection of paintings, sculptures and antiquities amassed by Cardinal Scipione Borghese in the early 17th century, including Bernini\u2019s sculpture \u2018Apollo and Daphne\u2019 and paintings by Rubens, Caravaggio, Titian and Bassano.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Vatican Museum, Sistine Chapel, St Peter\u2019s Basilica \u0026amp; Castel Sant\u2019Angelo\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Vatican Museum including Michelangelo\u2019s ceiling fresco at the Sistine Chapel \u2013 wander around St Peter\u2019s Square with its 248 colonnades, before visiting St Peter\u2019s Basilica to see Michelangelo\u2019s magnificent \u2018La Pieta\u2019 and the splendid tombs of the Popes \u2013 walk up to Castel Sant\u2019Angelo, the tomb of the Roman emperor Hadrian.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Palazzo Doria Pamphilj, Church of San Luigi dei Francesi \u0026amp; The Pantheon\u003C/h3\u003E\n\u003Cp\u003EPalazzo Doria Pamphilj boasts a wonderful collection of works by a vast array of renowned artists including Rubens, Titian, Velazquez and Caravaggio \u2013 the Church of San Luigi dei Francesi, designed by Giacomo della Porta and built by Domenico Fontana between 1518 and 1589, is home to three Caravaggio\u2019s: \u2018The Calling of St Matthew\u2019, \u2018The Inspiration of Saint Matthew\u2019 and \u2018The Martyrdom of Saint Matthew\u2019 \u2013 The Pantheon is the most extraordinary and best preserved ancient building in Rome with the present structure built and possibly designed by Emperor Hadrian in AD 118.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Catacombs\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Rome\u0026#39;s catacombs, the ancient underground cemeteries that began in the second century as Christian burial places, then during the persecutions as places of refuge and finally in the time of Pope Saint Damascus (366-384) as centres of devotion and pilgrimage for Christians from every part of the empire \u2013 transfer to Rome Airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
