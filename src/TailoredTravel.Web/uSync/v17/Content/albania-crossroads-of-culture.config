      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "5ed69856-0146-4422-b4ae-a2d83b5dd32b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotels\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions, entrance fees \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Tirana\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Albania\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "76a52758-ea18-437e-802b-7b6e1e91ebcb",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay one night at each of the 4* Portik Hotel in Berat and the 4* Hotel Partner in Vlora, two nights at the 4* Hotel Bineri in Gjirokastra and three nights at the 4* Tirana International Hotel in Tirana. Facilities at all hotels include a restaurant and a bar and all rooms are en suite. Dinner is included at each hotel every night.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "07cff31a-1e55-467a-a061-a5273369a4bd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBerat - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EApollonia - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVlora - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELlogara National Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECastle of Porto Palermo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EArchaeological site of Butrint\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGjirokastra\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELabove e Kryqit\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDurr\u00EBs\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETirana - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EShkodra walking tour Kruja\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "4689daa9-d59e-4be4-a826-ed132bdef6eb",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "e58efdb8-19f7-409a-98ef-e385ff482d34",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Berat\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Tirana from your preferred airport \u2013 transfer with our professional guide to Berat, a UNESCO world heritage site \u2013 a guided tour of the lower part of the town includes the 15th century mosque and the 18th century Halveti Tekke \u2013 check in at the 4* Portik Hotel in Berat.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tours of Berat and Apollonia \u0026amp; Vlora\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the upper part of Berat takes in the Kalaja Fortress with 4th century BC fortifications and 15th century mosques including the Church of St Mary, home to the Onufri Iconographic Museum \u2013 guided tour of the ancient city of Apollonia of Illyria founded at the beginning of the 6th century BC and the Museum of Apollonia located in a 16th century Byzantine monastery \u2013 panoramic tour of the coastal city of Vlora where the first parliament convened following the declaration of independence in 1912 \u2013 check in at the 4* Hotel Partner in Vlora.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Llogara National Park, Castle of Porto Palermo \u0026amp; Butrint\u003C/h3\u003E\n\u003Cp\u003EFrom the Llogara Pass enjoy dramatic views of the coast below before a leisurely walk at Llogara National Park \u2013 continue to the stunning Albanian Riviera and the picturesque Castle of Porto Palermo, built by Ali Pasha of Ioannina in the early 19th century \u2013 the archaeological site of Butrint, settled by Greeks in the 6th century BC, prospered as a holiday resort under Roman rule \u2013 check in at the 4* Hotel Bineri in Gjirokastra.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Gjirokastra \u0026amp; Labove e Kryqit\u003C/h3\u003E\n\u003Cp\u003EThe UNESCO listed town of Gjirokastra, known as the City of Stone, is dominated by a vast castle dating from the 13th century \u2013 visit the beautiful Byzantine church built in 554 at the nearby village of Labove e Kryqit (Labova of the Cross).\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Durr\u00EBs \u0026amp; Tirana\u003C/h3\u003E\n\u003Cp\u003EThe city of Durr\u00EBs, a key port for both the Greeks and the Romans, boasts ancient city walls and a Roman forum and baths \u2013 continue to Tirana and check in at the 4* Tirana International Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Tirana guided tour\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Tirana takes in the underground palace of BunkArt Museum, the National Gallery, the Mosque of Et\u2019hem Bay and a Roman house dating back to the 3rd century AD.\u003C/p\u003E\n\u003Ch3\u003EDay 7 \u2013 Shkodra walking tour \u0026amp; Kruja\u003C/h3\u003E\n\u003Cp\u003EOn the banks of a lake and at the foot of the mountains of High Albania, a walking tour of Shkodra includes a visit to the mighty fortress of Rozafa and Marubi Museum \u2013 continue to Kruja, Albania\u2019s medieval capital, and visit the Ethnographic Museum, the caste ruins and wander through the old medieval bazaar.\u003C/p\u003E\n\u003Ch3\u003EDay 8 \u2013 Tirana\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before we transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
