          "segment": null,
          "value": "Tailor your accommodation"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "If you\u0027d prefer different accommodation, perhaps a different hotel standard, location, or basis of accommodation, here are some alternative choices:"
        },
        {
