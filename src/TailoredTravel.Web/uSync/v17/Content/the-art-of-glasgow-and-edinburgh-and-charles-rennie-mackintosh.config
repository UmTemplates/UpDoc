      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "d3fc1809-b292-4e4c-ba72-63e86d9a6a56",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "edd05482-6582-46b9-bf57-be3734fde36a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 4* Glasgow Westerwood Hotel in Cumbernauld near Glasgow. Set in its own 400 acres of woodland, facilities at the hotel include a restaurant, bar, indoor swimming pool and sauna. All rooms are en suite.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "b6a828dc-a30f-4935-87d6-492dda42f394",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Glasgow\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKelvingrove Art Gallery and Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHouse for an Art Lover\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENational Gallery of Scotland - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERoyal Yacht Britannia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Kelpies\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Hunterian\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBurrell Collection\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDumfries House\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "c0dd9275-646d-47e0-a902-8b32360e5c59",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHopetoun House - set in 150 acres of rolling parkland and one of the most splendid examples of the work of Scottish architects Sir William Bruce, William Adam and his sons John and Robert\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt Mungo\u2019s Cathedral - on the site where St Mungo, the first bishop of Strathclyde, was buried in AD 612, the present cathedral dates from the 13th century and is the only one on the Scottish mainland to have survived complete the 1560 Reformation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalace of Holyroodhouse, Edinburgh - the Queen\u2019s official residence in Scotland and the Queen\u2019s Gallery, built in the shell of the former Holyroodhouse Free Church and Duchess of Gordon\u2019s School\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPollok House - lavish family rooms packed full of period furniture and furnishings and vast servants\u2019 quarters show the realities of running a country house in the 1930s\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHill House - one of Charles Rennie Mackintosh\u2019s finest domestic creations and, decorated with the help of Mackintosh\u2019s wife, the feel of the house is of restrained elegance combined with dazzling architecture\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETarbet \u0026amp; Loch Lomond - a picturesque village once described by Queen Victoria as being blessed with \u2018splendid passes, richly wooded with the highest mountains behind\u2019 with an optional cruise on the beautiful loch\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "df98386a-e7da-4560-817b-c17dc92207b0",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Tatton Park\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 stop at a convenient property en route such as Tatton Park in Cheshire, an opulently decorated early 19th century house with the theme of Victorian grandeur extending into the garden \u2013 continue to the 4* Glasgow Westerwood Hotel in Cumbernauld near Glasgow.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Glasgow, Kelvingrove Art Gallery and Museum \u0026amp; House for an Art Lover\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Glasgow includes a visit to the medieval cathedral of St Mungo\u2019s, consecrated in 1197 and home to one of the finest post war collections of stained glass windows in Britain \u2013 Kelvingrove Art Gallery and Museum in Glasgow, Scotland\u2019s most visited museum, is home to one of Europe\u2019s greatest civic art collections \u2013 built in Glasgow between 1989 and 1996 to a 1901 Charles Rennie Mackintosh design, the exhibition at the House for an Art Lover compares the decoratively furnished rooms against his original drawings.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 National Gallery of Scotland, Royal Yacht Britannia \u0026amp; The Kelpies\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the National Gallery of Scotland in Edinburgh, home to Scotland\u2019s greatest collection of European paintings and sculpture from the Renaissance to Post- Impressionist eras with paintings by artists such as Titian, Van Dyck and Tiepolo \u2013 the Royal Yacht Britannia served the Royal Family for over forty years and played a leading role in some of the defining moments of recent history with highlights being the State Dining Room, the Bridge and the Queen\u2019s Sitting Room \u2013 continue to The Kelpies, 30 metre high horse head sculptures by sculptor Andy Scott, standing next to a new extension to the Forth and Clyde Canal and a monument to horse powered heritage across Scotland.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 The Hunterian \u0026amp; Burrell Collection\u003C/h3\u003E\n\u003Cp\u003EThe Hunterian is home to the world\u2019s largest permanent display of the work of James McNeill Whistler, the largest single holding of the work of Charles Rennie Mackintosh, and The Mackintosh House, the reassembled interiors from his Glasgow home \u2013 the newly refurbished Burrell Collection houses an extensive collection of over 9,000 works including medieval art, tapestries, alabasters, stained glass, English oak furniture and European paintings by such notable artists such as Degas and C\u00E9zanne.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Dumfries House\u003C/h3\u003E\n\u003Cp\u003EDesigned 250 years ago by renowned 18th century architect brothers John, Robert and James Adam, a guided tour of Dumfries House explores this imposing Palladian mansion nestled within 2,000 acres of scenic countryside in Ayrshire and widely acknowledged as one of the country\u2019s most architecturally significant stately homes.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember this itinerary is just our suggestion. "
          }
        }
      ]
