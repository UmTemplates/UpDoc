    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "f2da7bc8-e897-4bec-8cdd-9cf3c0bbb8d0",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* central Avignon hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "96fb3b25-5e08-46cb-9589-8b26acb401be",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights at the centrally located 4* Bristol H\u00F4tel in Avignon. Located within the city walls and a ten minute walk from Le Palais des Papes, facilities at the hotel include a lounge and bar and all rooms are en suite. Dinner is included the first night and the remaining five nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "0784829f-957b-4150-9f23-453f8fe9125f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Avignon\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELe Palais des Papes - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPont d\u2019Avignon\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Aix-en-Provence - \u2018In C\u00E9zanne\u2019s footsteps\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Granet - audio guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Arles\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEspace Van Gogh\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EClinique Van Gogh\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EN\u00EEmes\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELa Maison Carr\u00E9e\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPont du Gard\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWalking tour of Marseilles\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Cantini\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "15689408-2c2b-4bca-93af-219024414322",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de la Barben - the painter Marius Granet described La Barben as \u2018the most ancient and the most picturesque castle in Provence\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau d\u2019Ansouis - this lovely ch\u00E2teau and fortress gardens have been owned by the same family since the 11th century\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELa Camargue - a National Park and area of outstanding natural beauty, and famous for its flamingos and wild horses\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e du Petit Palais, Avignon - an outstanding collection of Italian and Proven\u00E7al paintings\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "15cf45a4-0eca-430b-9314-ccbaac1b9bc5",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Avignon\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to France \u2013 transfer with our tour manager in our private executive coach to the 4* Mercure Avignon Centre Palais Des Papes in Avignon \u2013 dinner at a local restaurant.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Avignon, Le Palais des Papes \u0026amp; Pont d\u2019Avignon\u003C/h3\u003E\n\u003Cp\u003EGuided walking tour of the UNESCO listed town of Avignon takes in the ramparts, the Petit Palais and the Cathedral \u2013 guided tour of Le Palais des Papes, the Pope\u2019s Palace, the largest and most important Gothic palace in Europe testifying to the leading role played by Avignon in 14th century Christian Europe \u2013 Pont St B\u00E9nezet, or Pont d\u2019Avignon, was built in the 12th century and put out of use by a flood in 1668 and today only four of the original 22 arches remain.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Aix-en-Provence, \u2018In C\u00E9zanne\u2019s footsteps\u2019 \u0026amp; Mus\u00E9e Granet\u003C/h3\u003E\n\u003Cp\u003EGuided walking tour of Aix-en- Provence, C\u00E9zanne\u2019s birthplace, introduces us to its beautiful buildings and magnificent squares and follows \u2018In C\u00E9zanne\u2019s footsteps\u2019, discovering his life and the landscapes that inspired the great painter including a visit to his studio which has been preserved as he left it \u2013 an audio guided tour of Mus\u00E9e Granet introduces us to one of France\u2019s richest provincial art galleries with works by French painters from the 16th to 20th centuries (including works by C\u00E9zanne).\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Arles, Espace Van Gogh \u0026amp; Clinique Van Gogh\u003C/h3\u003E\n\u003Cp\u003EGuided walking tour of Arles takes in the magnificent Romanesque cathedral of Sainte-Troph\u00EEme, the two-tiered Roman Amphitheatre, one of the best preserved monuments of Roman Provence, and the remains of the Roman Theatre \u2013 it was in Arles that Vincent van Gogh experienced his first bout of insanity and we visit the Espace Van Gogh, the hospital where he painted some of his most famous works \u2013 in 1888 in St R\u00E9my de Provence Vincent van Gogh institutionalised himself at the asylum at St Paul de Mausole, now known as the Clinique Van Gogh, and during his year there produced 146 oil paintings and 150 drawings!\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 N\u00EEmes, La Maison Carr\u00E9e \u0026amp; Pont du Gard\u003C/h3\u003E\n\u003Cp\u003EMorning at leisure in N\u00EEmes, a town with 2,000 years of history, architecture and art \u2013 explore the stunning Roman temple known as La Maison Carr\u00E9e, one of the finest remaining examples of a Roman temple in the world \u2013 reaching a height of 49 metres, the Pont du Gard is the major structure along the N\u00EEmes Aqueduct and is the highest aqueduct bridge ever built by the Romans.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Marseilles \u0026amp; Mus\u00E9e Cantini\u003C/h3\u003E\n\u003Cp\u003EAfter a short walking tour of Marseilles this morning, visit Mus\u00E9e Cantini, housing the 20th century art collection of sculptor Jules Cantini, and Surrealist, Cubist and Fauve paintings \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
