    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "bd63398d-2f21-4556-9133-32c6dd2a8088",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Madrid hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Madrid\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Spain\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "915a1664-9be2-4a86-99dc-8c3f38f16fc4",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on bed and breakfast basis at the 4* Claridge Hotel in Madrid. Facilities include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "f0a68f09-e928-47b2-863a-54e7cbb5e626",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EIntroductory tour of Madrid\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Royal Palace \u0026amp; Puerta del Sol\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo del Prado - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Thyssen-Bornemisza - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReina Sof\u00EDa Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EToledo - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESegovia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAvila\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESan Lorenzo de El Escori\u00E1l\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "14d48733-7736-4286-a9a5-988f5a143ba8",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Sorolla - Joaquin Sorolla was an Impressionist from the city of Valencia and his former studiomansion in Madrid has been converted into a museum reproducing perfectly a typical early 20th century house\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalacio Real de La Granja, near Segovia - commissioned by the Bourbon king Felipe V in 1719, the palace and magnificent gardens have been described as the first great building of the Spanish Bourbon dynasty\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESalamanca - add a two night stay in Salamanca, one of Spain\u2019s most beautiful cities, taking in its two cathedrals, the university, the best Plaza Mayor in Spain and the beautiful Art Deco museum of Casa Lis\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "ad2c53d8-1ad2-4588-b4ae-a9aecd7a2c08",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Madrid\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Madrid from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Claridge Hotel in Madrid.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Madrid guided tour \u0026amp; Museo del Prado\u003C/h3\u003E\n\u003Cp\u003EGuided coach orientation tour through the Habsburg and Bourbon Quarters of Madrid taking in the Royal Palace and Puerta del Sol, marking the centre of Madrid and Spain \u2013 guided tour of the Museo del Prado housing the world\u2019s greatest assembly of Spanish paintings including works by El Greco, Goya and Vel\u00E1zquez as well as Italian and Flemish masters.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Museo Thyssen- Bornemisza \u0026amp; Reina Sof\u00EDa Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Museo Thyssen- Bornemisza housed in the Palacio de Villahermosa and, with a collection of some 800 paintings including masterpieces by El Greco, Caravaggio, Van Gogh and Picasso, regarded by many as the most important privately assembled art collection in the world \u2013 home to Picasso\u2019s \u2018Guernica\u2019, and other works by Picasso, Salvador Dal\u00ED and Joan Mir\u00F3, Reina Sof\u00EDa Museum houses Madrid\u2019s premier collection of contemporary art.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Toledo guided tour\u003C/h3\u003E\n\u003Cp\u003EFull day in the World Heritage listed walled city of Toledo, known as the \u2018city of the three cultures\u2019 because Christians, Arabs and Jews lived together here for centuries \u2013 guided tour explores the city\u2019s artistic and cultural legacy in the form of churches, palaces, fortresses, mosques and synagogues including the magnificent 13th century cathedral, one of the largest in modern Christianity.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Segovia \u0026amp; Avila\u003C/h3\u003E\n\u003Cp\u003EThe World Heritage Site of Segovia with its narrow streets and beautiful mansions is best known for its Romanesque churches, two tier Roman aqueduct built circa 50 AD and its 16th century cathedral and plaza \u2013 the beautiful city of Avila is surrounded by the finest preserved medieval walls in Europe with 88 turrets and nine gateways protecting its beautiful palaces and churches.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 San Lorenzo de El Escori\u00E1l\u003C/h3\u003E\n\u003Cp\u003ESan Lorenzo de El Escori\u00E1l, set in the foothills of the Sierra de Guadarrama and declared a World Heritage Site in 1984, contains museums, chapterhouses, a basilica, the Royal Crypt and sumptuous apartments and houses some of the most important works of art of the royal Habsburg collections \u2013 transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
