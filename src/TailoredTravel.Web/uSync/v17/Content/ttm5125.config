    },
    {
      "contentTypeKey": "f170b29c-338f-4ab8-a5c4-f72c90826f69",
      "key": "7134ddbd-c9eb-45b4-bf36-5c196a6bbee0",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "d37cb9a3-64d6-49f3-b731-0f06234bbbab",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E4* central Nice hotel\u003C/li\u003E\n\u003Cli\u003ETwo dinners included\u003C/li\u003E\n\u003Cli\u003EAll excursion travel, entrance fees \u0026amp; guided tours included\u003C/li\u003E\n\u003Cli\u003EReturn UK airport coach transfers included\u003C/li\u003E\n\u003Cli\u003EDirect scheduled flights to Nice\u003C/li\u003E\n\u003Cli\u003EProfessional tour manager in France\u003C/li\u003E\n\u003Cli\u003EPrivate coach throughout\u003C/li\u003E\n\u003Cli\u003ELocal accommodation tax included\u003C/li\u003E\n\u003Cli\u003EAudio headsets included on Days 2 to 5\u003C/li\u003E\n\u003Cli\u003EGratuities included\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "c996cc24-c067-40f8-81c6-30916b89eaa4",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay five nights at the centrally located 4* Splendid Hotel (\u003Ca href=\u0022https://www.splendid-nice.com/\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Ewww.splendid-nice.com/\u003C/a\u003E) in Nice. Facilities at the hotel include a bar, restaurant, gymnasium, and a sauna. All of our allocated Premium Rooms are ensuite and feature television, hairdryer, mini-bar, tea \u0026amp; coffee making facilities, and an in-room safe. A set 3 course dinner with a quarter of a bottle of house wine per person, coffee and water is included in our hotel on the first and last evenings, and the remaining 3 nights are on a bed and breakfast basis. A limited number of Deluxe Rooms are available (please refer to the booking form for the cost of staying in this particular room type), and will be allocated on a first come first served basis.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "9885bc46-13b7-4ba3-acc4-19885704f19e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organiser"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For more information on this tour contact your Group Organiser"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "97863cf6-3705-40ef-8488-eae685c70efd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003EVilla \u0026amp; Gardens of Ephrussi de Rothschild \u2013 guided tour\u003C/li\u003E\n\u003Cli\u003EVilla E-1027\u003C/li\u003E\n\u003Cli\u003EMus\u00E9e Renoir\u003C/li\u003E\n\u003Cli\u003EFondation Maeght\u003C/li\u003E\n\u003Cli\u003EBiot\u003C/li\u003E\n\u003Cli\u003EMus\u00E9e des Beaux Arts \u2013 guided tour\u003C/li\u003E\n\u003Cli\u003EMus\u00E9e Marc Chagall \u2013 guided tour\u003C/li\u003E\n\u003Cli\u003EFranciscan Church \u0026amp; Monastery of Cimiez\u003C/li\u003E\n\u003Cli\u003EAntibes\u003C/li\u003E\n\u003Cli\u003EMus\u00E9e Picasso\u003C/li\u003E\n\u003Cli\u003EVilla Kerylos\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "7a56ca4c-e7cf-4f5a-a54e-58c1ae23f150",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        },
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "31cf146f-63c8-4a0e-b08f-8cf2082313c0",
            "d37cb9a3-64d6-49f3-b731-0f06234bbbab",
            "c996cc24-c067-40f8-81c6-30916b89eaa4",
            "97863cf6-3705-40ef-8488-eae685c70efd",
            "09ece6f6-83a9-4860-8b22-b9ed7e45be18",
            "6fab8abc-7d19-47c8-a7f3-8ff1a5f67b1f",
            "9885bc46-13b7-4ba3-acc4-19885704f19e"
