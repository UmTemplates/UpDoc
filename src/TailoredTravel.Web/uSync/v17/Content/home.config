      "values": []
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "10588de4-a543-4dc2-9f51-03037cd0e522",
      "values": [
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor Made Tours Exclusively for Groups"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESo\u2026\u003C/p\u003E\u003Cul\u003E\u003Cli\u003E\u003Cp\u003Ewherever your group want to go\u2026\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003Ewhenever your group want to go\u2026\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003Ewhatever your group want to do when you get there\u2026\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003Ewe will tailor make your group\u0027s tour to your exact requirements.\u003C/p\u003E\u003Cp\u003ESee something you like? Give us a call and in close consultation with you we will incorporate any changes you require to tailor the tour to your group\u2019s exact requirements. Don\u2019t see a tour to your preferred destination? No problem. We\u2019d love to hear from you so that we can turn your idea into reality.\u003C/p\u003E\u003Cp\u003EEstablished in 1998, we have become one of the leading group travel specialists through a commitment to excellent customer service and good quality tours. Let us combine our experience and your understanding of the interests and profile of your members, so that together we can tailor make the perfect tour at the right price for your group.\u003C/p\u003E\u003Cp\u003ESo give us a call on 020 7064 4970 to discuss your ideas and let us tailor make your group\u2019s tour to your exact requirements.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "a95117b0-b6c8-4d1b-9b32-ba2ed67f4c5e",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u0022Everyone on the Budapest tour was so enthusiastic about what a wonderful time they had had; all saying it was the best holiday yet. Everything about this trip went well. However, without all your groundwork, and all the thought you put into the itinerary it could have been a totally different tour. Thank you very much from all of us, we would have no hesitation in recommending the Budapest tour, but only organised by Tailored Travel.\u0022\u003C/p\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "MR, Stourbridge"
          }
        }
      ]
    },
    {
      "contentTypeKey": "d5bfea49-0733-48ff-9ee0-d83c01a4cbf4",
      "key": "577a14e1-ccf5-46bf-a0e2-53cf16233391",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EEvery single one of our tours is individually designed exclusively for your group and your group alone. So\u2026\u003C/p\u003E\u003Cul\u003E\u003Cli\u003E\u003Cp\u003Ewherever you want to go\u2026\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003Ewhenever you want to go...\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003Ewhatever you want to do when you get there\u2026\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003Ewe will tailor make your group\u2019s tour to your exact requirements.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Group Tours"
        }
      ]
    },
