    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "9b699163-d2a3-4805-b0c1-87022480ea15",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included daily excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E\u2018Big Five\u2019 game drive\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Cape Town, returning from Johannesburg\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in South Africa\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 15 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "77af8c6d-92a8-492b-873f-691256cfc8d6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EGood quality hotels on bed \u0026amp; breakfast basis (half board at the Kruger National Park):\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECapetonian, Cape Town - two nights\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProtea Stellenbosch Hotel - one night\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProtea Riempie Estate Hotel, Oudtshoorn - one night\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProtea Knysna Quays - two nights\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProtea Tsitsikamma Village - one night\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWestcliff Hotel, Johannesburg - two nights\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProtea Kruger Gate Lodge - three nights (half board)\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003EAll rooms have en suite private facilities.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "94dec8a7-7083-490d-9e95-c8182fa36a49",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECape Town\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECape Peninsula\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECape Winelands\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOudtshoorn \u0026amp; BBQ dinner at an ostrich farm.\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECango Caves \u0026amp; Outeniqua Mountain Pass\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKnysna\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFeatherbed Nature Reserve\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPlettenberg Bay \u0026amp; Tsitsikamma National Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPort Elizabeth\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EJohannesburg\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPilgrim\u2019s Rest\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESightseeing tour of Mpumalanga\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKruger National Park \u0026amp; \u2018Big 5\u2019 game drive\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECity tour of Pretoria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOptional\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESunset cruise on board the Nauticat\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOpen top game viewing in the Kruger National Park\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETour of Soweto\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "343ed3ad-29a8-4ef2-a672-2e9ae0fbf89a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "42681d5e-8c55-42af-8f5a-2aac81f78376",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Depart UK\u003C/h3\u003E\n\u003Cp\u003EOvernight scheduled flight to Cape Town from your preferred airport.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Cape Town\u003C/h3\u003E\n\u003Cp\u003EMorning arrival in Cape Town where we are met by our tour manager who will accompany us throughout our tour \u2013 coach tour of the city, a cable car to the top of Table Mountain and tour along Camps Bay, Clifton and Sea Point \u2013 check in to the Capetonian Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Cape Peninsula\u003C/h3\u003E\n\u003Cp\u003ETour along Cape Peninsula, one of the world\u2019s great marine drives \u2013 drive to the fishing village of Hout Bay for a short boat ride to see the hundreds of seals at Seal Island \u2013 continue to Simon\u2019s Town to Boulder\u0026#39;s Beach to see the African Penguin \u2013 drive through the Cape of Good Hope Nature Reserve with its flowering plants and antelope to Cape Point, where the Indian and Atlantic Oceans merge \u2013 visit the beautiful Kirstenbosch Botanical Gardens on the eastern slopes of Table Mountain \u2013 optional sunset cruise on board the Nauticat.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Cape Winelands\u003C/h3\u003E\n\u003Cp\u003EFull day excursion to the Cape Winelands with visits to Paarl, Franschoek and Stellenbosch and an included cellar tour and two wine tastings during the day \u2013 check in to the Protea Stellenbosch Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Oudtshoorn\u003C/h3\u003E\n\u003Cp\u003ETravel via Montague along Route 62 to Oudtshoorn \u2013 check in to the Protea Riempie Estate Hotel in Oudtshoorn \u2013 visit an ostrich farm in the Little Karoo where we have a BBQ dinner.\u003C/p\u003E\n\u003Ch3\u003EDay 6 - Cango Caves \u0026amp; Knysna\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Cango Caves, a fabulous collection of dripstone formations \u2013 travel through the awe inspiring Outeniqua Mountain Pass through to Knysna \u2013 check in to the Protea Knysna Quays.\u003C/p\u003E\n\u003Ch3\u003EDay 7 \u2013 Featherbed Nature Reserve\u003C/h3\u003E\n\u003Cp\u003EMorning visit to Featherbed Nature Reserve which includes a boat ride from Knysna \u2013 evening free to enjoy the setting of the Knysna Quays.\u003C/p\u003E\n\u003Ch3\u003EDay 8 \u2013 Tsitsikamma National Park\u003C/h3\u003E\n\u003Cp\u003EContinue along the Garden Route, past Plettenberg Bay \u2013 Tsitsikamma National Park is an almost untouched natural landscape with indigenous Yellowood trees and diverse birdlife \u2013 check in to the Protea Tsitsikamma Village.\u003C/p\u003E\n\u003Ch3\u003EDay 9 \u2013 Port Elizabeth \u0026amp; Johannesburg\u003C/h3\u003E\n\u003Cp\u003ECross over the Storms River Bridge and on to Port Elizabeth for our flight to Johannesburg \u2013 on arrival at Johannesburg International Airport, we are met by our coach and transfer to the Westcliff Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 10 \u2013 Pilgrim\u2019s Rest \u0026amp; Mpumalanga\u003C/h3\u003E\n\u003Cp\u003EEn route to Mpumalanga we stop at Pilgrim\u2019s Rest, a finely restored original gold mining village retracing the wagon routes of Percy Fitzpatrick and his famous dog, Jock of the Bushveld \u2013 continue on a scenic sightseeing tour of Mpumalanga, via the Panorama Route taking in God\u0026#39;s Window, Bourke\u0026#39;s Luck Potholes and the Blyde River Canyon \u2013 check in to the Protea Kruger Gate Lodge and dinner in the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 11 \u2013 Kruger National Park\u003C/h3\u003E\n\u003Cp\u003EEarly morning departure for the Kruger National Park for one of the highlights of our tour, a full day game viewing by coach \u2013 today we will be tracking the \u2018Big 5\u2019 but hunting only for great photographs and extraordinary wildlife memories \u2013 return to the Lodge in the late afternoon for dinner.\u003C/p\u003E\n\u003Ch3\u003EDay 12 \u2013 Kruger National Park\u003C/h3\u003E\n\u003Cp\u003ESpend full day at leisure or optional second day of game viewing in the Kruger National Park but this time on an open top safari vehicle, a whole new experience \u2013 dinner at the Lodge.\u003C/p\u003E\n\u003Ch3\u003EDay 13 \u2013 Pretoria \u0026amp; Johannesburg\u003C/h3\u003E\n\u003Cp\u003ETravel to Pretoria for a city tour taking in the Voortrekker Monument, the Union Buildings, the administrative headquarters of the government, Church Square and Melrose House and Kruger House \u2013 travel on to Johannesburg and check in to Westcliff Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 14 \u2013 Johannesburg to UK\u003C/h3\u003E\n\u003Cp\u003EMost of the day free or time to take an optional tour of Soweto \u2013 late afternoon transfer to the airport for our scheduled flight home.\u003C/p\u003E\n\u003Ch3\u003EDay 15 \u2013 Arrive UK\u003C/h3\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
