    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "7dd29599-1fe9-4b0f-87ce-612d10b5e64f",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "ff592cfe-86da-4fcb-a88a-8f77511d0044",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EONE FREE PLACE PER 10 PAYING PASSENGERS\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "9f612c5d-836c-414f-a9b1-e99d362b1df3",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the 4* Tettuccio Hotel in Montecatini Terme. Facilities include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "ae2e7368-dc2b-4934-8cff-4d7a68e35a95",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EPisa \u0026amp; its Leaning Tower\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFlorence - the River Arno, the Ponte Vecchio \u0026amp; the Duomo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMichelangelo\u2019s \u2018David\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPanoramic Volterra\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDefensive towers of San Gimignano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELucca\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETour \u0026amp; olive oil tasting at Fattoria il Poggio\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "b20a3564-ebe5-4ab9-a98b-3e5ad210aad8",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESiena - the Campo is where the Palio horse race is run and the Gothic Duomo is one of the finest in all Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPienza - in the charming small town where \u2018The English Patient\u2019 was filmed take the time to walk the walls to enjoy the wonderful views and relax in the central square where the cathedral and town hall are located\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAbbey of Monte Oliveto Maggiore - guided tour with one of the monks of the magnificent 41 frescoes of the Life of St Benedict by Signorelli and Sodoma\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "c3ba1e62-0842-47b4-8f60-c668a92aaca5",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Montecatini Terme\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Tettuccio Hotel in the village of Montecatini Terme.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Pisa\u003C/h3\u003E\n\u003Cp\u003EOptional guided tour of Pisa \u2013 rest of the day free to explore at your leisure the many splendid buildings, including the Baptistry, the Duomo and, of course, the Leaning Tower.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Florence\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Florence to introduce us to the sights of the capital city of Renaissance art including the River Arno, the Ponte Vecchio and the magnificent Duomo followed by free time to explore the Uffizi or see Michelangelo\u2019s \u2018David\u2019 at the Accademia.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Volterra \u0026amp; San Gimignano\u003C/h3\u003E\n\u003Cp\u003ESituated on a high plateau and surrounded by the original Etruscan walls, Volterra offers fine views of the surrounding hills \u2013 its 13 defensive medieval towers in the Chianti wine growing region give San Gimignano the name \u2018the Small Manhattan\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Lucca \u0026amp; tour and olive oil tasting at Fattoria il Poggio\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Lucca, the birthplace of Puccini, takes in the 11th century Duomo of San Martino whose main portals contain outstanding 13th century carvings by Nicola Pisano and Guidetto da Como \u2013 guided tour of the farm at Fattoria il Poggio is followed by an olive oil tasting with the option of lunch.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Pisa to UK\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before our transfer to your preferred airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
