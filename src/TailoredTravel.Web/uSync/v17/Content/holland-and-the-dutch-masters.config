    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "f86bc803-db58-4071-9a34-43bdb9a8f38f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* The Hague hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "76cd6deb-6943-4dcf-b9ba-aa0dc1206500",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the centrally located 4* Voco Hotel in The Hague. Based in the Royal Quarter, facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "e9d3a02f-5bd6-4ebc-a743-d8bc547b3038",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGhent\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Mauritshuis\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPanorama Mesdag\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKoninklijke Porcleyne Fles - lunch \u0026amp; guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVan Gogh Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERijksmuseum - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAmsterdam canal cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELeiden\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDelft\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Vermeer Centre\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBruges\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "0e0957e4-8848-46bd-a917-0150235cafac",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ERembrandthuis, Amsterdam - Rembrandt\u2019s home between 1639 and 1660 houses almost every etching he made (around 250) and a collection of the master\u2019s possessions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFrans Hals Museum, Haarlem - Hals was a contemporary of Rembrandt and this museum, housed in a 17th century building round a courtyard, is home to wonderful collection of paintings and craft objects from the Golden Age\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKr\u00F6ller-M\u00FCller Museum - the private collection of late 19th century and early 20th century paintings includes 278 works by Van Gogh, an outstanding collection of Chinese porcelain and many hundreds of Delftware items\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "d4688fab-a3a3-4771-98fe-abc62ed2857f",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Ghent \u0026amp; The Hague\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 originally the capital of Flanders, Ghent has retained more historical buildings than any other Flemish city, including St Bavo\u2019s Cathedral, home to Van Eyck\u2019s famous 24 panel altarpiece \u2018The Adoration of the Mystic Lamb\u2019 \u2013 continue with our tour manager to the 4* Voco Hotel in The Hague.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 The Mauritshuis, Panorama Mesdag \u0026amp; Koninklijke Porcleyne Fles\u003C/h3\u003E\n\u003Cp\u003EThe newly refurbished Mauritshuis is home to a marvellous collection from the 17th and 18th century old masters with \u2018Girl with a Pearl Earring\u2019 by Johannes Vermeer the stunning highlight of the museum \u2013 painted by Hendrik Willem Mesdag, the most famous painter at The Hague School, the Panorama Mesdag is a cylindrical painting over 14m high and 120m in circumference depicting the vista of the sea, the dunes and Scheveningen village \u2013 at Koninklijke Porcleyne Fles in Delft, the only remaining factory of the 32 earthenware factories that were established in Delft in the 17th century, after an included two course Dutch lunch our guided tour sees a master painter at work, visits the dining room of Vermeer and the Dutch Royal Family Chamber, the museum with antique Delft pieces, the historical courtyard and visit the factory.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Amsterdam, Van Gogh Museum, Rijksmuseum \u0026amp; canal cruise\u003C/h3\u003E\n\u003Cp\u003ETravel to Amsterdam to see the wonderful collection at the Van Gogh Museum, home to the world\u2019s largest collection of paintings by Vincent van Gogh \u2013 guided tour of the newly refurbished Rijksmuseum whose world famous art collection includes many Dutch Old Masters such as Jan Steen, Frans Hals, Vermeer and Rembrandt\u2019s \u2018The Night Watch\u2019 \u2013 enjoy a relaxing canal cruise to admire some of Amsterdam\u2019s stunning architecture from a different perspective.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Leiden, Delft \u0026amp; the Vermeer Centre\u003C/h3\u003E\n\u003Cp\u003EMorning at leisure in Leiden, the birthplace of Rembrandt and home to a wonderful 17th century book collection at the Bibliotheca Thysiana and one of the world\u2019s oldest botanical gardens \u2013 time at leisure in the lovely old town of Delft, one of the principal artistic centres of the Northern Netherlands and famous for the works of Fabritius, de Hooch and Vermeer, born here in 1632 \u2013 a visit to the Vermeer Centre introduces us to Vermeer\u2019s mastery of light, composition and colour.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Bruges\u003C/h3\u003E\n\u003Cp\u003EBruges, whose historic city centre is included on UNESCO\u2019s World Heritage List, is famous for lace making, chocolate and its picturesque network of canals \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
