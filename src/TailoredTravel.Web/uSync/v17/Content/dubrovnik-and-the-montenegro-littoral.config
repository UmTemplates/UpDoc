      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "31c892bf-6c52-4a18-b8cf-95b0ffbd5bac",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Dubrovnik\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Croatia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "21c897df-faf0-466c-8417-60b84eb559c7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESix nights on half board basis at the 3* Komodor Hotel in Dubrovnik. Situated on the Dubrovnik waterfront, just a short stroll from Lapad Beach, facilities at the hotel include a restaurant, bar and outdoor swimming pool and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "ee2485bc-1302-4526-8b44-dbb845ce5591",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EDubrovnik \u2013 guided walking tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Dominican Monastery \u0026amp; Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFranciscan Monastery Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMostar\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EArboretum at Trsteno\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESton\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERector\u0026#39;s Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDubrovnik Cathedral\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOld Synagogue\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMontenegro Littoral\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "4d911322-f65d-4e92-924a-123357bad256",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EDubrovnik\u2019s cable car - whisk from the city walls to Mount Srdj for a wonderful perspective of the terracotta-tiled rooftops of the old town and the crystal clear Adriatic\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPile Gate - the grand entrance into Dubrovnik\u0026#39;s Old Town, this fabulous city gate was built in 1537 and every evening the drawbridge at the gate\u2019s entrance was lifted, the gate closed and the key handed to the prince\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESponza Palace - this 16th century structure is a mixture of Gothic and Renaissance styles housing the State Archives which contain a collection of manuscripts dating back nearly a thousand years\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "de11139a-4cd0-4286-817f-60ce40737dbe",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Dubrovnik\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Dubrovnik from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the 3* Komodor Hotel in Dubrovnik.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Dominican Monastery and Museum \u0026amp; Franciscan Monastery Museum\u003C/h3\u003E\n\u003Cp\u003ECoach drive along the coastal highway for a panoramic view of Dubrovnik\u2019s city walls and ancient rooftops \u2013 guided walking tour through the UNESCO listed ancient town, a treasure trove of architectural and cultural masterpieces, scrupulously preserved over the centuries, with visits to The Dominican Monastery and Museum and The Franciscan Monastery Museum with its 14th century pharmacy.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Mostar\u003C/h3\u003E\n\u003Cp\u003EFull day tour to Mostar introducing us to the varied cultures and religions that have left their mark over the centuries \u2013 coastal drive to the town of Neum, and then turn inland through the mountainous areas of Herzegovina before a brief stop above the Deransko Lake \u2013 drive along the Neretva River Valley to Mostar where a guided tour explores the city\u2019s highlights including an old Bazaar and the Mosque \u2013 return drive takes us to Pocitelj, a picturesque fortress town rich in oriental architecture.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Arboretum at Trsteno \u0026amp; Ston\u003C/h3\u003E\n\u003Cp\u003ELeisurely stroll through the botanical garden of the Arboretum at Trsteno with its exotic vegetation and plants including giant plane trees, palms and camphor trees \u2013 head for Ston, one of the first towns in Europe to be built to a definite urban plan including 5 kilometre long stone walls \u2013 other attractions include the ancient Saltpan where salt is still being produced and Ston\u2019s famous oyster and mussel farm \u2013 return to Dubrovnik after a snack in a Dalmatian cellar.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Rector\u0026#39;s Palace, Dubrovnik Cathedral \u0026amp; the Old Synagogue\u003C/h3\u003E\n\u003Cp\u003ESecond guided tour of Dubrovnik focuses on its cultural heritage and rich history with visits to the 15th century Rector\u0026#39;s Palace, the Cathedral and its Treasury, the Old Synagogue and a walk along the city walls.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Montenegro Littoral\u003C/h3\u003E\n\u003Cp\u003EThe Montenegro Littoral provides stunning natural beauty and an abundance of historical sites and our drive takes us through the most beautiful parts of the Bay of Kotor to the towns of Risan and Perast, boasting some of the best Baroque architecture on the Adriatic \u2013 time at leisure at Kotor, a wonderful medieval town dating from the 12th century and now a UNESCO site \u2013 descending from the heights and returning to the coast we visit Budva and make a short stop above Sveti Stefan before a ferry ride back across the bay to Dubrovnik.\u003C/p\u003E\n\u003Ch3\u003EDay 7 \u2013 Dubrovnik\u003C/h3\u003E\n\u003Cp\u003EMorning free to relax \u2013 transfer to Dubrovnik airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
