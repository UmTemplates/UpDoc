    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "16d533ec-cb39-4c07-bebf-e759d591738b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Delft hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "73e4a74f-4168-4fe5-b2e4-f16260b557d4",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the centrally located 4* Arsenaal Hotel in Delft. Facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "8c2ccb78-6abe-418e-abab-f85a9d6cd9c1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBeautiful Ghent\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDelft\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of the Koninklijke Porceleyne Fles in Delft\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMadurodam Model Village\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAmsterdam\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EZaanse Schans on the banks of the River Zaan\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKeukenhof Flower Festival (entrance fee included)\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHistoric city of Bruges\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "0b2633a5-8f74-4734-af64-e52bbd801cc9",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ELeiden - the birthplace of Rembrandt is home to a wonderful 17th century book collection at the Bibliotheca Thysiana and one of the world\u2019s oldest botanical gardens\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EZundert Flower Parade - using only dahlias, local communities compete each September to build the best floral float for the parade\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPanorama Mesdag - a cylindrical painting over 14 metres high and 120 metres in circumference depicting the vista of the sea, the dunes and Scheveningen village\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMauritshuis, The Hague - known as the \u2018Royal Gallery of Paintings\u2019 and home to an outstanding collection including Vermeer\u2019s famous \u2018Girl with a Pearl Earring\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "fbea322d-456e-4ef8-87ee-04b115c8886d",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Ghent \u0026amp; Delft\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points \u2013 take the cross Channel ferry from your preferred port \u2013 continue to Ghent for free time to explore its beautiful canals and wonderful Cathedral, home to the famous \u2018The Adoration of the Mystic Lamb\u2019 \u2013 continue to the 4* Arsenaal Hotel in Delft.\u003C/p\u003E\n\u003Ch3\u003EDay 2 - Koninklijke Porceleyne Fles \u0026amp; Madurodam Model Village\u003C/h3\u003E\n\u003Cp\u003EA tour of the Koninklijke Porceleyne Fles in Delft guides us through the history of Blue Delft and Royal Delft, including seeing a master painter at work and visiting the dining room of Vermeer and the Dutch Royal family Chamber, the museum with antique Delft pieces, the historical courtyard and the factory itself \u2013 visit the Madurodam Model Village, a miniature city built in 1952 and composed of typical Dutch buildings and landmarks found at various locations in the country.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Amsterdam\u003C/h3\u003E\n\u003Cp\u003EOptional cruise to admire some of Amsterdam\u2019s stunning architecture from the picturesque canals \u2013 free time to relax and explore Amsterdam or to visit the newly refurbished Rijksmuseum, the Van Gogh Museum or Stedelijk Museum Amsterdam.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Zaanse Schans \u0026amp; Keukenhof Flower Festival\u003C/h3\u003E\n\u003Cp\u003EZaanse Schans is an old hamlet on the banks of the River Zaan with characteristic wooden houses, small bridges, tradesmen\u2019s workshops and historic windmills \u2013 the afternoon is spent at the Keukenhof Flower Festival (entrance fee included) \u2013 set in 77 acres of wooded park and one of the world\u0026#39;s most spectacular flower gardens, Keukenhof was established in 1949 as a showcase for Dutch bulb growers and now, every spring, more than seven million bulbs are planted resulting in a spectacular display of flowering splendour.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Bruges\u003C/h3\u003E\n\u003Cp\u003EFamous for lace making, chocolate and its picturesque network of canals, Bruges\u2019 historic city centre is included on UNESCO\u2019s World Heritage List \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
