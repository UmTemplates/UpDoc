    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "69e2bc5c-d566-4310-9bf8-6c86abe2141d",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "2d65ec30-0c8c-480f-b53a-b323e14bd05f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in Croatia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Croatia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Croatia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "2aeaf0aa-603a-4a1e-b702-0abbc16d8092",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESeven nights on half board basis at the 4* Hotel Eden in the coastal town of Rovinj in the north of Croatia. The hotel is in a beautiful setting with attractive seafront paths leading into the heart of Rovinj. All rooms have private facilities with air conditioning.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "5779544c-f819-4d80-9abe-112bff5d8da7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAncient resort of Rovinj\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EArena at Pula\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOld fashioned resort of Opatija\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUNESCO listed old Roman town of Porec\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPostojna Caves \u0026amp; Lipica Stud Farm\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBoat trip to the Brijuni Islands\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "ea5bdb2b-b9c2-4ecf-8a7c-1f14b1dcc439",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "a0ecc697-dd6b-44cc-8293-994dd4aff383",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Rovinj\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Croatia from your preferred airport \u2013 transfer with our guide in our private executive coach to the 4* Hotel Eden in the beautiful coastal town of Rovinj.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Rovinj\u003C/h3\u003E\n\u003Cp\u003EFree day to explore the fascinating ancient resort of Rovinj, one of Croatia\u2019s most picturesque coastal towns featuring narrow medieval alleyways and many shops, restaurants and cafes.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Pula\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the arena at Pula \u2013 free time to relax and explore this historic destination with its fascinating Roman ruins including the impressive amphitheatre.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Slovenia\u003C/h3\u003E\n\u003Cp\u003EOptional day visiting Slovenia \u2013 wonder at the stalactites and stalagmites at one of the world\u2019s largest caves at Postojna \u2013 Lipica is home of the stud farm where pure blooded Lippizaner horses are bred for equestrian sports and classic riding.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Opatija\u003C/h3\u003E\n\u003Cp\u003EThe old fashioned resort of Opatija, with its narrow and labyrinthine streets, is placed at the beginning of the splendid Hapsburg Walk that for 25 kilometres goes along the promenade across luxuriant gardens of exotic trees, parks, courtyards and 19th century villas.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Brijuni Islands\u003C/h3\u003E\n\u003Cp\u003EOptional boat trip to the National Park consisting of the beautiful Brijuni Islands, an archipelago known for its mild climate and rich vegetation that has been inhabited since Roman and Byzantine times and where the ruins of Roman villas can still be found.\u003C/p\u003E\n\u003Ch3\u003EDay 7 \u2013 Porec\u003C/h3\u003E\n\u003Cp\u003ETime to explore the UNESCO listed old Roman town of Porec, famous for its beautiful natural landscape, where you may choose to visit the Basilica or take a stroll through the old town.\u003C/p\u003E\n\u003Ch3\u003EDay 8 \u2013 Rovinj\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before we transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
