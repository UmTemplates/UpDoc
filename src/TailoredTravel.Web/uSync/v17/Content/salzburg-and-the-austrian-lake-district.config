      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "5c8e7fdd-8ce7-4404-8a1e-1169c26feb31",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in Germany\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Austria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "358797e7-7588-412c-bc0b-e31d32de4da3",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the family run 3* Attergauhof Hotel in the centre of the village of St Georgen im Attergau. Ideally placed for our itinerary, facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "da131249-cbb0-4a42-9be9-fdebf8d403c0",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EKaiservilla at Bad Ischl\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt Wolfgang\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECruise on Lake Wolfgangsee\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESalzburg \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHellbrunn Palace \u2013 audio tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHitler\u2019s Eagle\u2019s Nest\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHallstatt\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPrien\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHerrenchiemsee Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "7ee3adc3-1f36-4a88-9edd-0d6d2eb22673",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "ddb2363e-d3df-4837-8360-94b41e744883",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 St Georgen im Attergau\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport \u2013 transfer with our guide in our private executive coach to the 3* Attergauhof Hotel in the village of St Georgen im Attergau.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Kaiservilla at Bad Ischl, St Wolfgang \u0026amp; cruise on Lake Wolfgangsee\u003C/h3\u003E\n\u003Cp\u003EKaiservilla at Bad Ischl, the former summer capital of the great Austro-Hungarian monarchy and associated with the Hapsburgs for at least 700 years, was described by Franz Josef I as \u2018heaven on earth\u2019 and it was here on 28th July 1914 that he signed the declaration of war on Serbia that descended into World War I \u2013 time at leisure in St Wolfgang or join our optional excursion on the Schafbergbahn, the steepest cogwheel railway in Austria that famously featured in the \u2018Sound of Music\u2019 \u2013 one way cruise from St Wolfgang to St Gilgen on picturesque Lake Wolfgangsee.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Guided tour of Salzburg \u0026amp; Hellbrunn Palace\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the old city of Salzburg, the home of Mozart and the \u2018Sound of Music\u2019, takes in sights such as the Hohensalzburg Fortress, the Cathedral, Mozart\u2019s birthplace and the Mirabell Palace and Gardens \u2013 Hellbrunn Palace, commissioned by Salzburg\u2019s Prince Archbishop Matkus Sittikus von Hohenems in 1612, is one of the most magnificent Renaissance buildings north of the Alps.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Hitler\u2019s Eagle\u2019s Nest \u0026amp; Hallstatt\u003C/h3\u003E\n\u003Cp\u003EAt Berchtesgaden there is an opportunity to visit Hitler\u2019s Eagle\u2019s Nest, given to Hitler as a 50th birthday present \u2013 the picturesque town of Hallstatt, often referred to as \u2018the pearl of Austria\u2019, was the site of an early Iron Age culture from 800 to 400 BC and is considered to be the oldest, continuously inhabited settlement in Europe \u2013 you may choose to visit the Cultural Heritage Museum, displaying 7,000 years of Hallstatt history, or enjoy a cruise on Lake Hallstattersee.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Prien \u0026amp; Herrenchiemsee Castle\u003C/h3\u003E\n\u003Cp\u003ETime at leisure in the Bavarian resort of Prien \u2013 continue to King Ludwig II\u2019s fairytale Herrenchiemsee Castle sitting magnificently on Lake Chiemsee and constructed to rival the Palace of Versailles \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
