    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "9794c66d-d048-42fe-8de5-02d7e2f89af1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E4* hotel\u003C/li\u003E\n\u003Cli\u003EHalf board accommodation\u003C/li\u003E\n\u003Cli\u003EAll excursions, entrance fees \u0026amp; guided tours included\u003C/li\u003E\n\u003Cli\u003EIncluded cruise on Day 3\u003C/li\u003E\n\u003Cli\u003EFerry tickets on Day 5 included\u003C/li\u003E\n\u003Cli\u003EReturn UK airport coach transfers included\u003C/li\u003E\n\u003Cli\u003EDirect scheduled flights from Bristol\u003C/li\u003E\n\u003Cli\u003EProfessional local guide\u003C/li\u003E\n\u003Cli\u003EPrivate coach for all excursions \u0026amp; transfers in Malta\u003C/li\u003E\n\u003Cli\u003EAudio headsets included on Days 2 to 5\u003C/li\u003E\n\u003Cli\u003ELocal accommodation tax included\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "72114729-974c-44cc-b8d4-b1a3c79f01ca",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay five nights on a half board basis at the 4* AX The Victoria Hotel at Sliema (\u003Ca href=\u0022http://www.victoriahotel.com\u0022\u003Ewww.victoriahotel.com\u003C/a\u003E). Located a five minute walk from the promenade, facilities at the hotel include a restaurant, bar, swimming pool, sauna, steam room and a gymnasium. All rooms are en suite and feature a hairdryer, television, telephone, mini bar, an in-room safe, and tea \u0026amp; coffee making facilities. A cold plate of food will be served at the restaurant on the first evening (due to the arrival time of our flight). A buffet dinner with a limited volume of wine (this includes \u00BD a bottle of house wine per person, \u00BD a bottle of water per person \u0026amp; coffee) is included on the remaining four evenings of our tour.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "9d563807-9842-498e-8830-1366f4af7fc5",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organiser"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For more information on this tour contact your Group Organiser"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "c4ed5aed-8db1-495f-bf5f-b50b6e4a72a7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003EValletta \u2013 guided tour\u003C/li\u003E\n\u003Cli\u003ESt John\u2019s Cathedral\u003C/li\u003E\n\u003Cli\u003EGrandmaster\u2019s Palace\u003C/li\u003E\n\u003Cli\u003ENational Museum of Fine Arts\u003C/li\u003E\n\u003Cli\u003ETemples of Tarxien\u003C/li\u003E\n\u003Cli\u003EGhar Dalam\u003C/li\u003E\n\u003Cli\u003EMarsaxlokk\u003C/li\u003E\n\u003Cli\u003EGrand Harbour cruise\u003C/li\u003E\n\u003Cli\u003EChurch of St Mary in Mosta\u003C/li\u003E\n\u003Cli\u003EMdina \u2013 guided tour\u003C/li\u003E\n\u003Cli\u003ESt Peter and St Paul\u2019s Cathedral\u003C/li\u003E\n\u003Cli\u003EPalazzo Falson Historic House Museum\u003C/li\u003E\n\u003Cli\u003EIsland of Gozo \u2013 guided tour\u003C/li\u003E\n\u003Cli\u003EGgantija Temples\u003C/li\u003E\n\u003Cli\u003ECalypso\u2019s Cave\u003C/li\u003E\n\u003Cli\u003EXlendi\u003C/li\u003E\n\u003Cli\u003EVictoria \u0026amp; the Citadel\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "5886e630-cd14-47ee-aea2-fa21f23f36bd",
      "values": [
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "a9e832a2-4079-4d6b-b6e0-2db2e470cc50",
            "9794c66d-d048-42fe-8de5-02d7e2f89af1",
            "72114729-974c-44cc-b8d4-b1a3c79f01ca",
            "c4ed5aed-8db1-495f-bf5f-b50b6e4a72a7",
            "14757805-f5a3-4dce-a468-24c414657c40",
            "d16eaa48-784c-456d-a5c9-1c5e74b2235d",
            "9d563807-9842-498e-8830-1366f4af7fc5"
          ]
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "a9e832a2-4079-4d6b-b6e0-2db2e470cc50",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe meet at our designated pick up points and transfer by private coach to Bristol Airport for our direct scheduled Easyjey flight to Malta. On arrival in Malta we are met by our guide and transfer by private coach to the 4* AX The Victoria Hotel at Sliema for a five night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EOur guide meets us at our hotel this morning and accompanies us throughout the day. Valetta, the capital city of Malta is our destination today, with its fine array of Baroque buildings, palaces and churches. We firstly visit the Upper Barracca Gardens for a panoramic view of the Grand Harbour. We continue to St John\u2019s Cathedral to see the famous Caravaggio painting \u2018The Beheading of St John\u2019. Our visit to the Grandmaster\u2019s Palace, which houses Parliament and the offices of the President of Malta, includes a visit to the Tapestry Chamber. We visit the National Museum of Fine Arts this afternoon, located in a palace and home to a fine collection of paintings, including works by Guido Reni, Jusepe Ribera and William Turner.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EWe visit the Three Megalithic Temples of Tarxien with our guide this morning, first discovered in 1915 and dating back to 3000 BC. The Tarxien Temples are notable for their fine workmanship and decorative carvings, including domestic animals carved in relief and exquisite spiral designs. We continue to Ghar Dalam, \u2018the Cave of Darkness\u2019, and its fossilised remains of prehistoric animals from the glacial period. We then spend some time at leisure for lunch in the nearby picturesque fishing village of Marsaxlokk, with its colourful \u2018Luzzus\u2019, traditional Maltese fishing boats. On arrival in Sliema this afternoon we enjoy an included Grand Harbour cruise, taking in the two natural harbours on either side of Valetta.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EFirstly we visit the Church of St Mary in Mosta. Built in 1860, the church is renowned for its dome which is the third largest in Europe. We continue to Mdina, the ancient capital city of Malta. Locally known as the \u2018Silent City\u2019, our guided tour takes in the defence bastions dating back to the 9th century and St Peter and St Paul\u2019s Cathedral. We then spend some free time in Mdina, and on an individual basis you may choose to visit the Mdina Glass Shop. Mdina Glass is Malta\u2019s original and leading producer of handmade glass. We finally visit the Palazzo Falson Historic House Museum, the former home of Captain Olof Frederick Gollcher, the son of a prosperous shipping merchant of Swedish descent. Gollcher was an artist, scholar and philanthropist, but also a discerning collector of objets d\u2019art and historical objects. Palazzo Falson was not only his home, but also a setting for his works of art and antiques.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EOur guide accompanies us on our full day excursion to the island of Gozo, meaning \u2018joy\u2019 in Castlian. We drive to Cirkewwa where we embark on a ferry crossing to Gozo, the legendary abode of Calypso, daughter of Atlas. We firstly visit the Ggantija Temples, one of the most important archaeological sites in Malta. Round in shape and containing statues of full figured goddesses, the Ggantija Temples were dedicated to the Great Mother Earth and probably included an oracle. One of the Ggantija Temples is the oldest stone structure in the world, predating Stonehenge and the Great Pyramids by hundreds of years. We continue to Calypso\u2019s Cave, the legendary home of Ulysses for breathtaking views of the red sands of Ramla Bay. We then spend some time at leisure in the picturesque resort of Xlendi. We continue to Victoria, the capital of Gozo. Time is at leisure to explore the town, or you may choose to accompany our guide on an uphill walk to the Citadel, to visit St Mary\u2019s Cathedral, erected shortly after the earthquake of 1693. We return by ferry back to Cirkewwa.\u003C/p\u003E\n\u003Ch3\u003EDay 6\u003C/h3\u003E\n\u003Cp\u003EWe transfer to Malta Airport for our direct scheduled Easyjet flight to Bristol, and onwards private coach travel back to our original pick up points.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
