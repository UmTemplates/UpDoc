    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "7b09dcd4-e348-4113-9a22-d3467f33bda7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* Vienna hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions \u0026amp; guided tours\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Vienna\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Austria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "95c0dff9-adcc-4182-8fc9-930d787efcde",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Renaissance Hotel in Vienna. Located 100 metres from the nearest Metro station, the historic centre of Vienna is under fifteen minutes away. Facilities at the hotel include a restaurant, bar and swimming pool and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "20435fba-1c8f-4b5d-b3df-0256f80a66fa",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EVienna - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKarlskirche\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESt Stephen\u2019s Cathedral\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESch\u00F6nbrunn Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMelk Abbey\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScenic Danube River cruise\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKrems\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EImperial Apartments at The Hofburg\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKunsthistorisches Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EUpper Belvedere Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "0f996d0b-e923-4364-8377-19d5b8e644f6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESecession Building - foremost amongst the Secession Movement was Gustav Klimt who in 1897, with 19 others, broke away from the conservative art establishment and the following year the Secession Building with its enormous golden sphere was born\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELeopold Museum - the art collection of Rudolph Leopold encompasses over 5,000 works of art, including major pieces by Gustav Klimt, together with the world\u2019s largest Egon Schiele collection\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Albertina - a grand Viennese palace tracing the progression from Impressionism to Modernism with artists ranging from Monet and Picasso to the abstract expressionists, Mark Rothko and Sam Francis\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "fcad430a-a8d6-4369-9a39-6a33f2d202e8",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Vienna\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Vienna from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the 4* Renaissance Hotel in Vienna.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Vienna guided tour, Karlskirche, St Stephen\u2019s Cathedral \u0026amp; Sch\u00F6nbrunn Palace\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Vienna taking in the imperial and architectural beauty of the city, a reminder of the great wealth of the Habsburgs and the splendour of the Austro-Hungarian Empire \u2013 the tour takes in Karlskirche, the largest Baroque cathedral north of the Alps, and St Stephen\u2019s Cathedral, dating back to 1147 and for a long time uncontested as the tallest building in Europe \u2013 after time for lunch the tour finishes at the Sch\u00F6nbrunn Palace, the residence of the Habsburg Empress, Maria Theresa.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Melk Abbey, River Danube cruise \u0026amp; Krems\u003C/h3\u003E\n\u003Cp\u003EFull day exploring the UNESCO listed Danube Valley with its rich history and magical scenery \u2013 the famous Benedictine Melk Abbey is one of Europe\u2019s finest examples of Baroque architecture \u2013 time at leisure for lunch in Melk which dates back to 831 \u2013 cruise along the scenic River Danube to the town of Krems with its colourful array of historical buildings.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Imperial Apartments at The Hofburg \u0026amp; Kunsthistorisches Museum\u003C/h3\u003E\n\u003Cp\u003EAn audio tour of Hofburg Palace, the residence of the Habsburgs for over 600 years, takes in the authentically furnished Imperial Apartments, the Sisi Museum and the Silver Collection \u2013 the 16th century Kunst-und Wunderkammer (art and treasure chambers) of Archduke Ferdinand and of Emperor Rudolph II, together with the Baroque collections of Archduke Leopold Wilhelm, form the nucleus of Kunsthistorisches Museum\u2019s magnificent collection \u2013 this evening you have the option of attending a concert at the Kursalon from the very place where Mozart directed his orchestra.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Upper Belvedere Palace\u003C/h3\u003E\n\u003Cp\u003EUpper Belvedere Palace is home to a fine collection of Austrian art dating from the Middle Ages to the present day, including the world\u2019s largest Gustav Klimt collection \u2013 transfer to Vienna airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
