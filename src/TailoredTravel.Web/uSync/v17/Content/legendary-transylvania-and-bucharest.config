    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "c9b30026-adef-4a7f-8c4b-96453f7a3982",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "80330302-ccfd-46ba-9fb7-0148107ae643",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotels\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions, entrance fees \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIncluded lunch \u0026amp; wine tasting on Day 3\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in Romania\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Bucharest\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Romania\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "1cf1967d-f3f6-4b8a-83d7-586556ddbad1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ETwo nights at the 4* Hilton Garden Inn in Bucharest and three nights at the 4* International Hotel in Sinaia. Facilities at both hotels include a restaurant and bar and all rooms are en suite. Dinner is included on the first evening and the remaining nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "10b00b6d-678b-4cde-a832-e32a4a6d138d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Bucharest\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENational Art Museum - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVillage Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELunch \u0026amp; wine tasting at Domnita Ralu winery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBrasov - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBran Castle (Dracula\u2019s Castle)\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPeles Castle\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESinaia Monastery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScenic cable car ride\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "b04c31ff-7835-4618-92bc-32239653f051",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EPainted monasteries of Bucovina add on - extend your tour and fly to Bucovina to explore the monasteries painted in the 15th and 16th centuries and featuring vivid mural frescoes created to educate and entertain the illiterate soldiers and peasants\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EStavropoleos Church - behind an Arabesque fa\u00E7ade is a richly decorated interior with ornate carvings and colourful frescoes\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENational Art Museum in Bucharest - housed in The Royal Palace, the collection includes an impressive European gallery with works by Rembrandt, El Greco and Breughel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESnagov Palace - dating back to 1364, the monastery is located on an island on Lake Snagov\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESighi\u0219oara - a UNESCO listed medieval city whose city walls encircle cobbled streets lined with 16th century burghers\u2019 houses and churches\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "2f8dcb6c-fcbb-427c-ba92-bb0693bfd3d7",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Bucharest\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Bucharest from your preferred airport \u2013 transfer with our guide in our private executive coach to the 4* Hilton Garden Inn in Bucharest for a two night stay \u2013 dinner in our hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Bucharest \u0026amp; National Art Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Bucharest, taking in sights such as the Royal Palace and the Palace of Parliament, the third largest building in the world after the Pentagon and the Potala Palace in Tibet \u2013 guided tour of the National Art Museum introduces an impressive European gallery with works by Rembrandt, El Greco and Breughel.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Village Museum \u0026amp; lunch \u0026amp; wine tasting at a Dealu Mare u winery\u003C/h3\u003E\n\u003Cp\u003EMorning visit to the open air Village Museum, a vast park displaying buildings from every region of Romania and showcasing traditional Romanian village life \u2013 an included lunch and a tasting of three wines in the Dealu Mare wine region \u2013 continue to the 4* International Hotel in Sinaia for a three night stay.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Brasov \u0026amp; Bran Castle (Dracula\u2019s Castle)\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the medieval town of Brasov with ornate Saxon churches and townhouses \u2013 Bran Castle is known the world over as Dracula\u2019s Castle and was created by the Saxons in the late 14th century to defend Brasov from invasion by the Turks.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Peles Castle, Sinaia Monastery \u0026amp; cable car ride\u003C/h3\u003E\n\u003Cp\u003EVisit Peles Castle in the Carpathian Mountains, built in the late 19th century for Romania\u2019s first monarch, King Carol I, to resemble a Bavarian Schloss and whose rooms are richly decorated in ebony, mother of pearl and leather \u2013 Sinaia Monastery was founded by Prince Mihail Cantacuzino in 1695 and named after the great Saint Catherine\u0026#39;s Monastery on Mount Sinai in Egypt \u2013 enjoy an included round trip scenic cable car ride.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Sinaia\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure in Sinaia before we transfer to Bucharest airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
