      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "4669ddfe-39d2-45cf-88c0-75298f41e448",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003E4* hotels throughout\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003ETwo dinners included\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EFull programme of included excursions \u0026amp; guided tours\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EScheduled flights to Spain\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EExecutive coach in Spain\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003E\u003Cstrong\u003EOne free place per 10 paying passengers\u003C/strong\u003E\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "ec5e9c5b-7dbc-476f-8d41-bc28e7d12cca",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ETwo nights in Granada at the 4* Gran Hotel Luna, located a ten minute walk from the historical centre, and three nights in Seville at the 4* Hotel MA Sevilla Congreso, just a short bus or taxi ride from the Cathedral. Facilities at both hotels include a restaurant and a bar and all rooms are en suite. Dinner is served on the first night at each hotel and the remaining nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "3cdb9677-78ea-48d0-9900-ade06a8f70b7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EIntroductory tour of Granada\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E14th century Alhambra Palace - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGardens of the Generalife\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECordoba \u0026amp; The Mezquita\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIntroductory tour of Seville\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReales Alcazares - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo de Bellas Artes - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EJerez de la Frontera \u0026amp; Tio Pepe bodegas - tour \u0026amp; tasting\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERonda \u0026amp; the extraordinary Tajo\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "7872e1f5-6818-4304-b153-8d0779c0e07f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGranada Cathedral - built by Queen Isabella immediately after the conquest of Granada on the site of a mosque, the cathedral is a masterpiece of Spanish Renaissance style\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERoyal Chapel, Granada - in September 1504, Queen Isabella and King Ferdinand decided that Granada was to be their final resting place and signed a Warrant for a royal chapel to be built and the result was a masterpiece of Gothic art by Enrique de Egas\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIt\u00E1lica - this ancient Roman city just outside Seville is the birthplace of two Roman emperors, Trajan and Hadrian\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "fd4b4366-f788-48bf-87ce-fad3132075b5",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Granada guided tour\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Spain from your preferred airport \u2013 transfer with our tour manager in our private executive coach to Granada \u2013 a short orientation tour of the delightful maze of winding streets in its old Christian and Gypsy quarters \u2013 check in at the 4* Gran Hotel Luna \u2013 dinner in the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Alhambra Palace \u0026amp; Gardens of the Generalife\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the 14th century Alhambra Palace, the home of many of the Arabic Sultans who ruled the whole province and recognised as the world\u2019s greatest Moorish monument, with gardens, fortifications and sumptuous palaces \u2013 adjacent to The Alhambra, the UNESCO listed Gardens of the Generalife were the former rural residence of the emirs who ruled this part of Spain in the 13th and 14th centuries \u2013 afternoon free to explore Granada.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Cordoba \u0026amp; The Mezquita\u003C/h3\u003E\n\u003Cp\u003ELeave Granada and travel to Seville \u2013 en route visit the Moorish capital of Cordoba, once famous for its Jewish community and now known for The Mezquita, the grandest Mosque ever constructed by the Moors \u2013 travel on to Seville and check in to the 4* Hotel MA Sevilla Congreso \u2013 dinner in the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Seville guided tour \u0026amp; Reales Alcazares\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Seville, the capital of Andaluc\u00EDa made famous by the Conquistadors, was once one of the richest cities in the world and is now home to the world\u2019s largest cathedral \u2013 afternoon guided tour of the Reales Alacazares, a stunning Moorish palace which was the Spanish kings\u2019 royal residence for seven centuries.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Museo de Bellas Artes, Jerez de la Frontera \u0026amp; Flamenco evening\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Museo de Bellas Artes, one of Spain\u2019s finest galleries with a particular focus on artists from Seville including works by Goya, Murillo, Millan, Zurbaran and Ribera \u2013 tour and tasting at the Tio Pepe bodegas in Jerez de la Frontera, the capital of sherry production \u2013 optional Flamenco evening.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Ronda\u003C/h3\u003E\n\u003Cp\u003ELying within an amphitheatre of limestone hills and standing above 120 metre cliffs, our guided tour of Ronda explores one of the most dramatically sited towns in Spain with the Moorish part of the town divided from the modern part by the extraordinary Tajo, a 90 metre gorge with the river flowing below \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
