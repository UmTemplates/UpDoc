    {
      "contentTypeKey": "6d7aa5eb-5edc-40c3-8013-2d4d4016f601",
      "key": "90bbf98c-4dcd-44d1-9617-c540d4c6b8b0",
      "values": [
        {
          "alias": "featurePropertyFeatureHTML",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\u003Cform id=\u0022quoteForm\u0022 method=\u0022post\u0022 action=\u0022/brochure_request_new.php\u0022 class=\u0022needs-validation\u0022 novalidate\u003E\n\n    \u003Cp\u003ETo request a brochure, complete your contact details and select your brochure(s) from the list.\u003C/p\u003E\n\n    \u003C!-- ============ Your details ============ --\u003E\n    \u003Ch2 class=\u0022h4 border-bottom pb-2 mb-4\u0022\u003EYour details\u003C/h2\u003E\n\n    \u003Cdiv class=\u0022grid mb-4\u0022\u003E\n        \u003Cdiv class=\u0022g-col-12 g-col-md-6\u0022\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022title\u0022\u003ETitle\u003C/label\u003E\n                \u003Cselect class=\u0022form-select w-auto\u0022 id=\u0022title\u0022 name=\u0022title\u0022\u003E\n                    \u003Coption selected value=\u0022\u0022\u003E\u003C/option\u003E\n                    \u003Coption\u003EMr\u003C/option\u003E\n                    \u003Coption\u003EMrs\u003C/option\u003E\n                    \u003Coption\u003EMiss\u003C/option\u003E\n                    \u003Coption\u003EMs\u003C/option\u003E\n                    \u003Coption\u003EDr\u003C/option\u003E\n                    \u003Coption\u003ERev\u003C/option\u003E\n                \u003C/select\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022firstname\u0022\u003EFirst name\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022firstname\u0022 name=\u0022firstname\u0022 required\u003E\n                \u003Cdiv class=\u0022invalid-feedback\u0022\u003EPlease enter your first name.\u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022lastname\u0022\u003ELast name\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022lastname\u0022 name=\u0022lastname\u0022 required\u003E\n                \u003Cdiv class=\u0022invalid-feedback\u0022\u003EPlease enter your last name.\u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022address1\u0022\u003EAddress line 1\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022address1\u0022 name=\u0022address1\u0022 required\u003E\n                \u003Cdiv class=\u0022invalid-feedback\u0022\u003EPlease enter the first line of your address.\u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022address2\u0022\u003EAddress line 2\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022address2\u0022 name=\u0022address2\u0022\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022town\u0022\u003ETown\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022town\u0022 name=\u0022town\u0022 required\u003E\n                \u003Cdiv class=\u0022invalid-feedback\u0022\u003EPlease enter your town/city.\u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022county\u0022\u003ECounty\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022county\u0022 name=\u0022county\u0022\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022postcode\u0022\u003EPostcode\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022postcode\u0022 name=\u0022postcode\u0022 required\u003E\n                \u003Cdiv class=\u0022invalid-feedback\u0022\u003EPlease enter your postcode.\u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-md-6\u0022\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022phone\u0022\u003EPhone\u003C/label\u003E\n                \u003Cinput type=\u0022tel\u0022 class=\u0022form-control\u0022 id=\u0022phone\u0022 name=\u0022phone\u0022 autocomplete=\u0022tel\u0022\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022email\u0022\u003EEmail\u003C/label\u003E\n                \u003Cinput type=\u0022email\u0022 class=\u0022form-control\u0022 id=\u0022email\u0022 name=\u0022email\u0022 autocomplete=\u0022email\u0022\u003E\n                \u003Cdiv class=\u0022invalid-feedback\u0022\u003EPlease enter a valid email address.\u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022hear_about_us\u0022\u003EHow did you hear about Tailored Travel?\u003C/label\u003E\n                \u003Cselect class=\u0022form-select w-auto\u0022 id=\u0022hear_about_us\u0022 name=\u0022hear_about_us\u0022\u003E\n                    \u003Coption selected value=\u0022\u0022\u003E\u003C/option\u003E\n                    \u003Coption\u003ENADFAS Review\u003C/option\u003E\n                    \u003Coption\u003EU3A News\u003C/option\u003E\n                    \u003Coption\u003EProbus Magazine\u003C/option\u003E\n                    \u003Coption\u003EGroup Travel Organiser\u003C/option\u003E\n                    \u003Coption\u003EGroup Leisure\u003C/option\u003E\n                    \u003Coption\u003EOther advert\u003C/option\u003E\n                    \u003Coption\u003ERecommendation\u003C/option\u003E\n                    \u003Coption\u003EExisting client\u003C/option\u003E\n                    \u003Coption\u003ESearch engine\u003C/option\u003E\n                    \u003Coption\u003ECRE 2017\u003C/option\u003E\n                \u003C/select\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022other_advert\u0022\u003EOther (please specify)\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022other_advert\u0022 name=\u0022other_advert\u0022\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022form-check mb-3\u0022\u003E\n                \u003Cinput class=\u0022form-check-input\u0022 type=\u0022checkbox\u0022 id=\u0022group_organiser\u0022 name=\u0022group_organiser\u0022\u003E\n                \u003Clabel class=\u0022form-check-label\u0022 for=\u0022group_organiser\u0022\u003EAre you a Group Travel Organiser?\u003C/label\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022organisation\u0022\u003EGroup Name\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022organisation\u0022 name=\u0022organisation\u0022\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022group_type\u0022\u003EType of group\u003C/label\u003E\n                \u003Cselect class=\u0022form-select w-auto\u0022 id=\u0022group_type\u0022 name=\u0022group_type\u0022\u003E\n                    \u003Coption selected value=\u0022\u0022\u003E\u003C/option\u003E\n                    \u003Coption\u003EU3A\u003C/option\u003E\n                    \u003Coption\u003ENADFAS\u003C/option\u003E\n                    \u003Coption\u003ENational Trust\u003C/option\u003E\n                    \u003Coption\u003EBAFM\u003C/option\u003E\n                    \u003Coption\u003ESchool/college\u003C/option\u003E\n                    \u003Coption\u003EDance club\u003C/option\u003E\n                    \u003Coption\u003ECompany\u003C/option\u003E\n                    \u003Coption\u003EWI\u003C/option\u003E\n                    \u003Coption\u003EChurch\u003C/option\u003E\n                    \u003Coption\u003EProbus\u003C/option\u003E\n                    \u003Coption\u003EOther\u003C/option\u003E\n                \u003C/select\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022mb-3\u0022\u003E\n                \u003Clabel class=\u0022form-label\u0022 for=\u0022other_group\u0022\u003EOther (please specify)\u003C/label\u003E\n                \u003Cinput type=\u0022text\u0022 class=\u0022form-control\u0022 id=\u0022other_group\u0022 name=\u0022other_group\u0022\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n\n    \u003C!-- ============ Brochures ============ --\u003E\n    \u003Ch2 class=\u0022h4 border-bottom pb-2 mb-4\u0022\u003EBrochures\u003C/h2\u003E\n\n    \u003Cp\u003EPlease tick which of the following brochures you would like to receive\u003C/p\u003E\n\n    \u003C!-- \u0022At least one brochure\u0022 message \u2014 toggle d-none from your custom script --\u003E\n    \u003Cdiv class=\u0022text-danger mb-3 d-none\u0022 id=\u0022brochure-error\u0022\u003EPlease tick at least one brochure.\u003C/div\u003E\n\n    \u003C!--\n        GTO-only disclaimer (was a per-card CSS-checkbox popup hack \u2014 every card\n        carried the same text). Kept once here; show it from your custom script,\n        e.g. on change of any .brochure-check, or wire it to a Bootstrap modal.\n    --\u003E\n    \u003Cdiv class=\u0022d-none\u0022 id=\u0022gto-disclaimer\u0022\u003E\n        This brochure is for group travel organisers who do or hope to organise tours\n        for a group as the brochure contains only suggested tours which are designed\n        to provide inspiration for your group\u0026rsquo;s own bespoke tour \u0026ndash; it is\n        not for individual travel.\n    \u003C/div\u003E\n\n    \u003Cdiv class=\u0022grid mb-4\u0022\u003E\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Cimg src=\u0022/uploads/images/catalog_src/group-traveller-brochure_src_1.jpg\u0022 class=\u0022card-img-top\u0022 alt=\u0022Group Traveller brochure cover\u0022\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-group-traveller\u0022 name=\u0022list[]\u0022 value=\u0022Group Traveller brochure\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-group-traveller\u0022\u003E\n                            Group Traveller\u003Cbr\u003E\n                            \u003Cstrong\u003E(Group Travel Organisers only)\u003C/strong\u003E\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Cimg src=\u0022/uploads/images/catalog_src/art-culture-brochure_src_1.jpg\u0022 class=\u0022card-img-top\u0022 alt=\u0022Art \u0026amp; Culture brochure cover\u0022\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-art-culture\u0022 name=\u0022list[]\u0022 value=\u0022Art \u0026amp; Culture brochure\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-art-culture\u0022\u003E\n                            Art \u0026amp; Culture\u003Cbr\u003E\n                            \u003Cstrong\u003E(Group Travel Organisers only)\u003C/strong\u003E\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/glyndebourne-2026\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/glyndebourne-2026_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-glyndebourne-2026\u0022 name=\u0022list[]\u0022 value=\u0022Glyndebourne 2026\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-glyndebourne-2026\u0022\u003E\n                            Glyndebourne\u003Cbr\u003E\n                            Autumn season 2026\u003Cbr\u003E\n                            \u003Cstrong\u003EGroup Travel Organisers only\u003C/strong\u003E\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/madrid-toledo-avila-salamanca-segovia\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/madrid-toledo-avila-salamanca-segovia_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-madrid-segovia\u0022 name=\u0022list[]\u0022 value=\u0022Madrid, Toledo, Avila, Salamanca \u0026amp; Segovia\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-madrid-segovia\u0022\u003E\n                            Madrid, Toledo, Avila,\u0026nbsp;Salamanca \u0026amp; Segovia with Paul Richardson\u003Cbr\u003E\n                            Departing 18th October 2026\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100 ober-brochure-before\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/peter-medhurst-glyndebourne-181026\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/peter-medhurst-glyndebourne-181026_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-medhurst-glyndebourne\u0022 name=\u0022list[]\u0022 value=\u0022Peter Medhurst - Glyndebourne 181026\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-medhurst-glyndebourne\u0022\u003E\n                            Opera at Glyndebourne\u003Cbr\u003E\n                            with Peter Medhurst\u003Cbr\u003E\n                            Departing 18 October 2026\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/_petermedhurst_umbria\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/_petermedhurst_umbria_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-medhurst-umbria\u0022 name=\u0022list[]\u0022 value=\u0022Peter Medhurst Umbria 031126\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-medhurst-umbria\u0022\u003E\n                            A Journey\u0026nbsp;through Umbria\u003Cbr\u003E\n                            Peter Medhurst with Tom Abbott\u003Cbr\u003E\n                            Departing 3rd November 2026\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/peter-medhurst-vienna-2026\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/peter-medhurst-vienna-2026_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-medhurst-vienna\u0022 name=\u0022list[]\u0022 value=\u0022Peter Medhurst Vienna 2026\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-medhurst-vienna\u0022\u003E\n                            Vienna in Advent\u003Cbr\u003E\n                            Peter Medhurst with Tom Abbott\u003Cbr\u003E\n                            Departing 22nd \u0026amp; 27th November 2026\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/medhurst-open-venice-160126\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/medhurst-open-venice-160126_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-medhurst-venice\u0022 name=\u0022list[]\u0022 value=\u0022Medhurst Open - Venice 150127\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-medhurst-venice\u0022\u003E\n                            The Music \u0026amp;\u0026nbsp;Art of Venice\u003Cbr\u003E\n                            Peter Medhurst \u0026amp; Viviana Marchesin\u003Cbr\u003E\n                            Departing 15 January 2027\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n\n        \u003Cdiv class=\u0022g-col-12 g-col-sm-6\u0022\u003E\n            \u003Cdiv class=\u0022card h-100\u0022\u003E\n                \u003Ca href=\u0022https://www.tailored-travel.co.uk/peter-medhurst-dresden-2027\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003E\n                    \u003Cimg src=\u0022/uploads/images/catalog_src/peter-medhurst-dresden-2027_src_1.jpg\u0022 class=\u0022card-img-top\u0022 title=\u0022Click to download brochure\u0022 alt=\u0022Click to download brochure\u0022\u003E\n                \u003C/a\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022form-check\u0022\u003E\n                        \u003Cinput class=\u0022form-check-input brochure-check\u0022 type=\u0022checkbox\u0022 id=\u0022brochure-medhurst-dresden\u0022 name=\u0022list[]\u0022 value=\u0022Peter Medhurst - Dresden 2027\u0022\u003E\n                        \u003Clabel class=\u0022form-check-label\u0022 for=\u0022brochure-medhurst-dresden\u0022\u003E\n                            The Music \u0026amp; Art of Dresden\u003Cbr\u003E\n                            Peter Medhurst with Tom Abbott\u003Cbr\u003E\n                            Departing 14th March 2027\n                        \u003C/label\u003E\n                    \u003C/div\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n\n    \u003C!-- ============ Personal Data ============ --\u003E\n    \u003Ch2 class=\u0022h4 border-bottom pb-2 mb-4\u0022\u003EPersonal Data\u003C/h2\u003E\n\n    \u003Cp\u003EWe would like to send you future editions of the brochure(s) you have requested and to email you about future tours which may be of interest to you. Please confirm whether you are happy to be contacted by post and email:\u003C/p\u003E\n\n    \u003Cfieldset class=\u0022mb-2\u0022\u003E\n        \u003Cdiv class=\u0022d-flex align-items-center flex-wrap gap-3\u0022\u003E\n            \u003Clegend class=\u0022fs-6 w-auto m-0 float-none\u0022\u003EAre you happy to be contacted by post?\u003C/legend\u003E\n            \u003Cdiv class=\u0022form-check form-check-inline m-0\u0022\u003E\n                \u003Cinput class=\u0022form-check-input\u0022 type=\u0022radio\u0022 id=\u0022personaldatapost-yes\u0022 name=\u0022personaldatapost\u0022 value=\u0022personal-data-yes\u0022 required\u003E\n                \u003Clabel class=\u0022form-check-label\u0022 for=\u0022personaldatapost-yes\u0022\u003EYes\u003C/label\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022form-check form-check-inline m-0\u0022\u003E\n                \u003Cinput class=\u0022form-check-input\u0022 type=\u0022radio\u0022 id=\u0022personaldatapost-no\u0022 name=\u0022personaldatapost\u0022 value=\u0022personal-data-no\u0022 required\u003E\n                \u003Clabel class=\u0022form-check-label\u0022 for=\u0022personaldatapost-no\u0022\u003ENo\u003C/label\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/fieldset\u003E\n\n    \u003Cfieldset class=\u0022mb-3\u0022\u003E\n        \u003Cdiv class=\u0022d-flex align-items-center flex-wrap gap-3\u0022\u003E\n            \u003Clegend class=\u0022fs-6 w-auto m-0 float-none\u0022\u003EAre you happy to be contacted by email?\u003C/legend\u003E\n            \u003Cdiv class=\u0022form-check form-check-inline m-0\u0022\u003E\n                \u003Cinput class=\u0022form-check-input\u0022 type=\u0022radio\u0022 id=\u0022personaldataemail-yes\u0022 name=\u0022personaldataemail\u0022 value=\u0022personal-data-yes\u0022 required\u003E\n                \u003Clabel class=\u0022form-check-label\u0022 for=\u0022personaldataemail-yes\u0022\u003EYes\u003C/label\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022form-check form-check-inline m-0\u0022\u003E\n                \u003Cinput class=\u0022form-check-input\u0022 type=\u0022radio\u0022 id=\u0022personaldataemail-no\u0022 name=\u0022personaldataemail\u0022 value=\u0022personal-data-no\u0022 required\u003E\n                \u003Clabel class=\u0022form-check-label\u0022 for=\u0022personaldataemail-no\u0022\u003ENo\u003C/label\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/fieldset\u003E\n\n    \u003Cp\u003EWe will not pass your details to companies outside the Tailored Travel group of companies without your consent.\u003C/p\u003E\n\n    \u003Cbutton class=\u0022btn btn-primary mt-4\u0022 id=\u0022submit\u0022 type=\u0022submit\u0022\u003ERequest your brochures\u003C/button\u003E\n\u003C/form\u003E"
        }
      ]
