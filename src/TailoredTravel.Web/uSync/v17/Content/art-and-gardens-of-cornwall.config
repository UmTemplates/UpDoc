    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "dfb276c5-a43e-47a6-ac96-a652f7c0e52e",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "0e8fbe57-aaa1-4010-b641-e742ed2064d7",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "bc1aa3bf-903c-4a77-a299-127e18e0ba12",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 3* New Continental Hotel. Situated in the heart of Plymouth, this Grade II listed Victorian hotel has a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "b295a346-3e1c-4688-afb3-34078d28a9ab",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ERoyal Albert Memorial Museum \u0026amp; Art Gallery\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEden Project\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELanhydrock\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Lost Gardens of Heligan\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETrelissick Garden\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPencarrow House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPrideaux Place\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EKingston Lacy Mansion\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "340b42b6-5ad4-4350-9c63-893f3b9a1c61",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBuckland Abbey - a 700 year old National Trust building with rich associations with Elizabethan seafarers Sir Francis Drake and Sir Richard Grenville\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESaltram - created between the 1740s and 1820s by three generations of the Parker family, it features some of Robert Adam\u2019s finest rooms, exquisite plasterwork ceilings, original Chinese wallpapers and an exceptional collection of paintings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGreenway House \u0026amp; Gardens - cruise from Dartmouth along the Dart Estuary to the house that was bought by Agatha Christie in 1938 and boasts an atmosphere of wildness and timelessness and wonderful views of the Dart Estuary\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "If you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "37173e4c-8809-4edd-921a-64831cb48a42",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Royal Albert Memorial Museum \u0026amp; Art Gallery\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 stop at a convenient property en route such as Royal Albert Memorial Museum and Art Gallery, a museum devoted to Devon and Exeter\u2019s rich history and global connections and, following a \u00A324 million transformation, is home to a fine collection of paintings by British artists dating from the 16th to 20th century \u2013 travel on to the 3* New Continental Hotel in Plymouth.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Eden Project \u0026amp; Lanhydrock\u003C/h3\u003E\n\u003Cp\u003EA guided tour of the Eden Project explores the plants, crops and landscapes from the humid tropics and warm temperate regions including olives, vines and citrus fruit from the Mediterranean, South Africa and California \u2013 the National Trust\u2019s Lanhydrock property, one of the most complete late 19th century houses in England, offers period atmosphere and extensive servants\u2019 quarters and the garden features a stunning collection of magnolias, rhododendrons and camellias.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 The Lost Gardens of Heligan \u0026amp; Trelissick Garden\u003C/h3\u003E\n\u003Cp\u003EThe Lost Gardens of Heligan comprises over two hundred acres of superb working Victorian gardens including some eighty acres of walled gardens, summerhouses, lawns, lakes and ponds, huge productive gardens and fruit houses and a twenty-two acre subtropical jungle - the National Trust\u2019s Trelissick Garden, beautifully positioned at the head of the Fal Estuary, commands panoramic views over the area, and at its heart is the garden which offers year round colour.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Pencarrow House \u0026amp; Prideaux Place\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Georgian Pencarrow House, the family home of the Molesworth-St Aubyns, with a fine collection of pictures, furniture and porcelain and whose grounds include a beautifully proportioned sunken Italian garden and over 700 different varieties of rhododendrons \u2013 guided tour of Prideaux Place, the home of the Prideaux family for over 400 years and filled with royal and family portraits, fine furniture and the Prideaux Porcelain Collection.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Kingston Lacy Mansion\u003C/h3\u003E\n\u003Cp\u003EGuided tour en route home of another National Trust property such as Kingston Lacy Mansion in Wimborne dating from the 17th century with one of the greatest family picture collections in the UK and with beautiful interiors and garden.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and the profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
