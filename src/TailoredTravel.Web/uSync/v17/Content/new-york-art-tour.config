    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "04962b7c-0a6e-42d8-a463-87685e899767",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "a09acc48-cd3e-435c-8f52-c9c65096479f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EFirst class central hotel with porterage\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour at every venue\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to New York\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in New York\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 20 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "a64ab70c-9373-4ced-9151-2eaa80ab294c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on room only basis at the first class Park Central Hotel on Seventh Avenue. The hotel is across the street from Carnegie Hall and just a few steps from the Museum of Modern Art, the Rockefeller Center and Central Park. All rooms have en suite facilities and the hotel has both a bistro style restaurant and atmospheric cocktail bar.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "a2a3a1af-b196-4dbc-951e-dab55b0c6b43",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf day guided tour of Manhattan\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWall Street, Central Park \u0026amp; the Empire State Building\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Frick Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMetropolitan Museum of Art\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuggenheim Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWhitney Museum of American Art\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERockefeller Center\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EStage Door Tour at Radio City Music Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "b4ea36e4-d8f1-4bb5-a66c-dae7a728bd6d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EEllis Island - from 1892 to 1954 over twelve million immigrants entered the US through Ellis Island under the shadow of the magnificent Statue of Liberty and today the Island hosts a museum of immigration\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum of Modern Art - one of the city\u2019s most popular museums is home to more than 100,000 pieces of modern artwork, by the likes of Van Gogh, Matisse, Picasso, Warhol, Lichtenstein, Rothko, Pollock, Bourgeois and many others\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E9/11 Memorial - twin reflecting pools, each nearly an acre in size and featuring the largest manmade waterfalls in North America, sit within the footprints where the Twin Towers once stood completed in 2011\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "a35a1bcd-b318-4b6c-bf04-4ab37f2ecb78",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 New York\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to New York from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the first class Park Central Hotel on Seventh Avenue.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Manhattan guided tour \u0026amp; The Frick Museum\u003C/h3\u003E\n\u003Cp\u003EGuided coach tour of Manhattan taking in Wall Street, Central Park and the Empire State Building \u2013 guided tour of The Frick Museum, home to the many masterpieces from the Renaissance to the end of the 19th century that industrialist Henry Clay Frick bequeathed to the public \u2013 optional opera performance at The Metropolitan.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Metropolitan Museum of Art \u0026amp; Guggenheim Museum\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Metropolitan Museum of Art for an introduction to the collection after which you have free time to enjoy the gallery at your leisure \u2013 walking the spiral walkway that dominates Frank Lloyd Wright\u2019s masterpiece, the Guggenheim Museum, our guided tour introduces us to great works from artists of the 19th and 20th century including Brancusi, Braque, Calder, Chagall, Giacometti, Kandinsky, Klee, Miro, Picasso and Van Gogh.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Whitney Museum of American Art \u0026amp; Manhattan Island Cruise\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Whitney Museum of American Art whose collection has grown since its opening in 1931 to more than 12,000 paintings, sculptures, prints, drawings, and photographs representing nearly 2,000 individual artists and providing the most complete overview of the 20th century American art of any museum in the world \u2013 optional cruise around Manhattan Island beneath the Brooklyn, Manhattan and Williamsburg bridges taking in views of the world\u2019s premier skyline and a close up of the Statue of Liberty.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Rockefeller Center \u0026amp; Radio City Music Hall\u003C/h3\u003E\n\u003Cp\u003EBuilt in 1939 as a contemporary and innovative addition to the city by John D Rockefeller Junior, the nearby Rockefeller Center complex covers 22 acres between 48th and 51st Streets was completed \u2013 a Stage Door Tour at Radio City Music Hall goes behind the scenes to explore the lounges and corridors of the most iconic theatre in New York \u2013 return to the hotel to collect our bags and transfer to the airport for our overnight flight back home.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 New York to UK\u003C/h3\u003E\n\u003Cp\u003EEarly morning arrival into UK.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
