    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "76b3398c-c729-4887-bfd7-166eaae0e7dd",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel in Spoleto\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "674690cf-960a-40f7-a379-6d597c172d21",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights at the 4* Hotel San Luca, centrally located inside the historic medieval walls of Spoleto. Dinner is included the first night and the remaining four nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "da554eee-4c59-4a55-be31-71825f4052eb",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Spoleto\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAncient hill town of Spello\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMedieval town of Gubbio \u0026amp; Palazzo dei Consoli - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo Civico in Sansepolcro\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EArezzo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECasa Di Vasari - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETodi\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPanoramic Montefalco \u0026amp; a guided tour of the Museo Civico\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Orvieto\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "ab96b219-c584-4f53-bffb-59172dd09451",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EUrbino - Galleria Nazionale delle Marche features works by Paolo Uccello, Piero della Francesca, Raphael and the magnificent intarsia work in the study of Duke Frederico, while the Palazzo Ducale is one of Italy\u2019s most beautiful Renaissance palaces\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECitt\u00E0 delle Pieve - medieval town home to a wonderful selection of art by its very own Renaissance painter, Il Perugino\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPerugia - guided tour of the wonderful collection of Umbrian art at Galleria Nazionale dell\u2019Umbria in Perugia, a delightful town dating from Etruscan times Assisi - guided tour of the Basilica and Giotto\u2019s stunning frescoes of the life of St Francis\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAssisi - guided tour of the Basilica and Giotto\u2019s stunning frescoes of the life of St Francis\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "ced99125-2e2e-48c8-9e3f-bab1cca1ce94",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Spoleto\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 4* Hotel San Luca in Spoleto \u2013 dinner at a local restaurant.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Spoleto \u0026amp; Spello\u003C/h3\u003E\n\u003Cp\u003EMorning guided tour of Spoleto taking in sights such as the 14th century Ponte delle Torri and the magnificent Duomo \u2013 the ancient fortified hill town of Spello boasts the 13th century Church of Santa Maria Maggiore with wonderful works by Il Perugino and frescoes by Il Pinturicchio in the Baglioni Chapel.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Gubbio \u0026amp; Palazzo dei Consoli\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the 14th century Palazzo dei Consoli in Gubbio, one of the finest expressions of medieval city architecture in Italy and home to the 2nd century BC bronze Eugubine Tablets \u2013 afternoon free to enjoy one of the most beautiful and best preserved towns in Italy.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Sansepolcro, Arezzo \u0026amp; Casa Di Vasari\u003C/h3\u003E\n\u003Cp\u003EThe Museo Civico in Sansepolcro, the birthplace of Piero della Francesca, houses some of his exquisite paintings including the polyptych of the \u2018Virgin of Mercy\u2019 and his fresco of the Resurrection \u2013 Arezzo is famous for its hanging flower baskets and Pierro della Francesca\u2019s fresco cycle \u2018The Legend of the True Cross\u2019 in the Basilica San Francesco \u2013 a guided tour of Casa Di Vasari explores the house built by the artist in 1540 and richly decorated with frescoes and a priceless collection of Mannerist paintings.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Todi \u0026amp; Montefalco\u003C/h3\u003E\n\u003Cp\u003EMorning visit to Todi whose principal sights include the main square, Piazza del Popolo, the delightful plain faced 13th century Duomo and the Museo Etrusco Romano \u2013 continue to panoramic Montefalco and a guided tour of the Museo Civico with works by an array of leading Umbrian artists including Benozzo Gozzoli\u2019s \u2018Life of St Francis\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Orvieto\u003C/h3\u003E\n\u003Cp\u003EGaining access into the town by cable car, our guided tour of the charming Etruscan town of Orvieto takes in the stunning 13th century Duomo with its huge fa\u00E7ade adorned with frescoes by Lorenzo Maitani \u2013 transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
