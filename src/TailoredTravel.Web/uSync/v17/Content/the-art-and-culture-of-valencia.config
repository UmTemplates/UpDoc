      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "52112760-a88d-4edb-9866-45969ee1bde3",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* central Valencia hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Valencia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Spain\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "da0ac84b-99be-4cca-8ce0-db6bb7a01bbc",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Hotel Ayre Astoria Palace. Located in the centre of Valencia, just 100 metres from the Town Hall and near the Cathedral, the hotel has a bar and restaurant and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "aa27d42d-87b7-4a52-8ea6-9a4fc2e9f44b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Valencia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EJos\u00E9 Benlliure Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPaella lunch\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECity of Arts and Sciences complex - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo de Bellas Artes - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESagunto - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalau de la Musica concert hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo de la Cer\u00E1mica\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "4077888c-f003-4400-8c83-9ce365593758",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ETorre de Serranos - Europe\u2019s largest Gothic city gateway constructed at the end of the 14th century by Pere Balaguer affords splendid views of the city and the River Turia from its terraces\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo del Patriarca - this museum of the Corpus Christi Seminary School is home to an extensive collection of paintings including works by Francisco Ribalta, Juan Sari\u00F1ena and Luis de Morales\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EQuart Towers - dating from 1444 and the surviving parts of the medieval defensive walls that once guarded the city, the two towers, cylindrical on the outside and flat behind, are a clear example of late Gothic military architecture\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "6470b819-e15f-479c-9aa7-d623177ce7e7",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Valencia guided tour\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Valencia from your preferred airport \u2013 transfer with our professional tour manager in our private executive coach to the 4* Ayre Hotel Astoria Palace \u2013 after lunch a guided walking tour of Valencia, Spain\u2019s third largest city, takes in the 13th century cathedral, the Plaza del Ayuntamiento, the city\u2019s triangular main square and home to the town hall, the Old Silk Exchange (La Lonja de la Seda) and the Colegio del Patriarca, built in the mid-16th century.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Jos\u00E9 Benlliure Museum \u0026amp; Paella lunch\u003C/h3\u003E\n\u003Cp\u003EDedicated to the life and times of this famous Valencian painter, the Jos\u00E9 Benlliure Museum also displays his personal collection of art, and recreates the atmosphere of a middle to high class bourgeoisie home during the time of the Spanish Restoration \u2013 enjoy an included Paella lunch at a typical rural Valencian restaurant followed by a horse and carriage ride through the surrounding farmland.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 City of Arts and Sciences complex \u0026amp; Museo de Bellas Artes\u003C/h3\u003E\n\u003Cp\u003EHalf day guided tour of the City of Arts and Sciences complex, a futuristic \u2018city within a city\u2019 made up of five main areas: the Hemisf\u00E8ric (IMAX cinema and digital projections), the Umbracle (a landscaped vantage point), the Pr\u00EDncipe Felipe Science Museum (interactive science), the Oceanogr\u00E1fic (aquarium) and the Palau de les Arts Reina Sof\u00EDa (operatic and ballet programmes) \u2013 guided tour of the Museo de Bellas Artes renowned for its collection of primitive Valencian painters plus works by El Greco, Vel\u00E1zquez, Murillo and Goya.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Sagunto \u0026amp; Palau de la Musica\u003C/h3\u003E\n\u003Cp\u003EMorning guided tour of Sagunto, a walled and fortified town 25km outside Valencia, contemplates the town\u2019s history including the bloody siege by Hannibal in the 3rd century BC which set in motion the Second Punic War and the several reminders of the Roman occupation \u2013 on our return to Valencia in the afternoon we stop at the port to view the Palau de la Musica, Valencia\u2019s prestigious concert hall.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Museo de la Cer\u00E1mica\u003C/h3\u003E\n\u003Cp\u003ELocated in the 15th century Palace of the Marquis of Dos Aguas, the Museo de la Cer\u00E1mica contains an important collection of ceramics including prehistoric, Roman, Greek and Arab items and contemporary works including some by Picasso \u2013 transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
