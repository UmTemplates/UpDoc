    },
    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "11959b26-6016-4149-acbe-f3f910eb65e7",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "957a5e74-85ca-4d1b-b6c3-fbbc7bf0c35e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn Channel ferry crossings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "cc5136f4-b17e-43c0-9820-5018cff52af1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the good quality 3* Hotel Magellan in Paris. Located in the 17th District in a quiet residential area near the Arc de Triomphe, the hotel is close to the Metro and there are many restaurants in the immediate vicinity.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "44f87d66-2518-4ea9-9f21-ef8854d419ad",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Paris\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Louvre - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Fontainebleau\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Vaux-le-Vicomte\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e d\u2019Orsay - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e de l\u0026#39;Orangerie - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMonet\u2019s Garden at Giverny\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "52821bcf-6c13-4f54-a93b-7dbeb3596d46",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Versailles - see the Kings Apartments, the bedroom of Marie-Antoinette and the Hall of Mirrors lined on one side by 70 metres of mirrors in the splendour of Louis XIV\u2019s 18th century palace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMus\u00E9e Rodin - the workshop of Auguste Rodin from 1908, the museum houses his complete collection donated to the French State on his death including The Thinker, The Kiss and The Gates of Hell\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECath\u00E9drale de Notre Dame - begun in 1163 according to the design of Bishop Maurice de Sully and largely completed by the early 14th century, Notre Dame is a masterpiece of French Gothic architecture\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "0257bec5-10f4-4e10-af39-8e8c4ca008f7",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Paris\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your designated pick up points with our tour manager \u2013 take the cross Channel ferry from your preferred port (or travel by Eurostar from London St Pancras or Ashford International to Paris - supplement payable) \u2013 continue to Paris and check in to the excellent 3* Hotel Magellan.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Paris guided tour \u0026amp; The Louvre\u003C/h3\u003E\n\u003Cp\u003EGuided coach tour taking in the major sights of Paris such as the Eiffel Tower, Champs Elysees, Arc de Triomphe and Notre Dame \u2013 guided tour of The Louvre, one of the largest, oldest and most famous art galleries in the world with a wonderful collection including Alexandros of Antioch\u2019s \u2018Venus de Milo\u2019 and Leonardo da Vinci\u2019s \u2018Mona Lisa\u2019 and \u2018The Virgin and Child with St Anne\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Ch\u00E2teaux de Fontainebleau \u0026amp; de Vaux-le-Vicomte\u003C/h3\u003E\n\u003Cp\u003EVisit with our guide to Ch\u00E2teau de Fontainebleau, one of the largest royal ch\u00E2teau dating back to the 12th century and used by French monarchs from the Middle Ages until the French Revolution \u2013 Ch\u00E2teau de Vaux-le-Vicomte, built in the 17th century for the king\u2019s treasurer, Nicholas Fouquet, and in many ways the most lavish and refined castle to be built in Europe during the mid-17th century.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Mus\u00E9e d\u2019Orsay \u0026amp; Mus\u00E9e de l\u0026#39;Orangerie\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Mus\u00E9e d\u2019Orsay collection of works by the great impressionists dating from 1848-1914 including famous canvases from Monet, Manet, Renoir, van Gogh and C\u00E9zanne \u2013 guided tour of the Mus\u00E9e de l\u0026#39;Orangerie containing impressionist and post-impressionist paintings by notable artists such as Monet, Picasso and Sisley.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Monet\u2019s Garden\u003C/h3\u003E\n\u003Cp\u003EVisit Monet\u2019s Garden at Giverny where the artist came repeatedly through his life, letting his imagination Chateaurove amid the complex interplay of water and light to paint his magnificent waterlilies series \u2013 continue for our Channel crossing back to the UK and then return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
