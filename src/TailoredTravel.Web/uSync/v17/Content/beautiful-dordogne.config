    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "46bae780-cec9-4704-a085-8f2615eca815",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide in France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in France\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "9864d113-bd9d-4926-aac8-0a5e9dcb963d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the 3* Hotel La Promenade in Souillac. Facilities at the hotel include a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "89dffdf3-e314-4842-8c8d-2e455c00290e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESouillac\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMartel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETruffadou Train\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERocamadour \u0026amp; caves at Gouffre de Padirac\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECh\u00E2teau de Castelnaud\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDomme\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECro-Magnon Shelter Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPalaeolithic paintings at Lascaux \u0026amp; Sarlat-la-Can\u00E9da\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBeynac-et-Cazenac\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELa Roque-Gageac\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECruise the Dordogne\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "21e7cef9-1177-45ad-9a9b-e7a79017b31c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ERemember that this tour is just our suggestion to provide inspiration and whet your appetite. Every one of our tours is tailor made exclusively for your group and your group alone. So if you like the look of this tour but want to alter it to suit your group, that\u2019s fine. Tell us how you want to change it and we\u2019ll send you a proposal that meets the exact requirements for your group tour. Then, combining our experience with your understanding of the profile and interests of your members, together we can fine tune the itinerary so that you get the perfect tour at the right price for your group.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "85f60be8-36ac-4fcc-8103-251e7805c195",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Souillac\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to France from your preferred airport \u2013 transfer with our guide in our private executive coach to the 3* Hotel La Promenade in Souillac.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Martel, Truffadou Train, Rocamadour \u0026amp; caves at Gouffre de Padirac\u003C/h3\u003E\n\u003Cp\u003EExplore the village of Martel, the medieval \u0026#39;city\u0026#39; of seven towers \u2013 the restored Truffadou Train travels along a scenic line, formerly used to transport truffles, to the village of St Denis \u2013 the pilgrimage site of Rocamadour is built into the face of a limestone cliff topped by the abbey of l\u0026#39;Hospitalet \u2013 an underground river trip reveals the beauty of the caves at Gouffre de Padirac.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Ch\u00E2teau de Castelnaud \u0026amp; Domme\u003C/h3\u003E\n\u003Cp\u003EFounded in the 12th century and built on a rocky outcrop, a guided tour of Ch\u00E2teau de Castelnaud takes in its collection of weapons and armour and magnificent panoramic views over the Dordogne Valley \u2013 founded by Philippe III of France in 1281 as a bastion against the English, Domme retains much of its original medieval ramparts and its imposing clifftop position offers wonderful views across the valley.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Cro-Magnon Shelter Museum, Palaeolithic paintings at Lascaux \u0026amp; Sarlat-la-Can\u00E9da\u003C/h3\u003E\n\u003Cp\u003EThe Cro-Magnon Shelter Museum is on the site where in 1868 the first known modern human was discovered \u2013 the caves and their astonishing Palaeolithic paintings at Lascaux were discovered by four boys in 1940 and the Lascaux II replica cave was meticulously created in 1963 \u2013 time at leisure in Sarlat-la-Can\u00E9da, a maze of golden sandstone cobbled alleyways and courtyards with wonderfully preserved medieval architecture.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Beynac-et-Cazenac, La Roque-Gageac \u0026amp; cruise the Dordogne\u003C/h3\u003E\n\u003Cp\u003EBeynac-et-Cazenac was the site of fierce medieval battles between the lords of its impressive castle and the lords of Ch\u00E2teau de Castelnaud, allies of the English Plantagenets \u2013 at La Roque-Gageac on the banks of the Dordogne admire the ochre coloured houses, sheltering under dramatically overhanging cliffs \u2013 cruise in a traditional Gabare boat along the Dordogne past five of the valley\u0026#39;s most beautiful ch\u00E2teaux.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Souillac\u003C/h3\u003E\n\u003Cp\u003EMorning free at leisure before we transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
