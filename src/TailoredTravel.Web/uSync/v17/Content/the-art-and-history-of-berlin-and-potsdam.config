    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "683fc612-0026-43e7-90c5-88f8693977cc",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "045801de-47d9-4698-bcff-cd0fe19becbc",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* central Berlin hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Berlin\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Germany\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "22f346cc-5496-40a0-8418-6fa5a5382372",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on bed and breakfast basis at the 4* Park Inn by Radisson Hotel. Located in Berlin\u0026#39;s central Alexanderplatz, facilities at the hotel include a bar, restaurant and a roof terrace and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "29b1e0c5-117b-4d88-b985-2fb695498a58",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EIntroductory tour of Berlin\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E\u0026#39;Kaffee und Kuchen\u2019 break \u0026amp; tour of the Reichstag\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAlte Nationalgalerie\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENeues Museum\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPotsdam - Cecilienhof Palace \u0026amp; Sansoucci Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECharlottenburg Palace\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "a575291f-1077-4d4e-90c5-ba8c8ddb294f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ENeue Nationalgalerie \u2013 reopened in 2021 after 6 years of restoration, it is dedicated to the twentieth century art from the Nationalgalerie\u2019s diverse collection\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseum Berggruen - Heinz Berggruen\u2019s modernist collection features works by Picasso, Klee, Matisse, Braque and Giacometti\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBauhaus Archive - devoted to the history and influence of the Bauhaus (1919-1933) with works by students and their famous teachers including Johannes Itten, Paul Klee, Vasily Kandinsky and Oskar Schlemmer\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGem\u00E4ldegalerie - one of the world\u2019s finest collections of European art dating from the 13th to the 18th centuries including works by Raphael, van Eyck, Holbein, Caravaggio, Canaletto, Rubens, Vermeer and Rembrandt\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EJewish Museum Berlin - exhibitions covering two millennia of German Jewish history at the Daniel Libeskind designed museum\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "b832b9af-637d-4d71-94f5-85444a28dc6c",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Berlin\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Berlin \u2013 transfer with our professional guide in our private executive coach to the 4* Park Inn by Radisson Hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Guided tour of Berlin \u0026amp; the Reichstag\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Berlin taking in sights such as Brandenburg Gate, Museum Island, Alexanderplatz, the former Berlin Wall with murals of the East Side Gallery, Checkpoint Charlie and the inside of Emperor William Memorial Church \u2013 after time for lunch, a pre-booked Kaffee und Kuchen break in the Reichstag is followed by a tour of Sir Norman Foster\u2019s great restoration.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Museum Island - Alte Nationalgalerie \u0026amp; Neues Museum\u003C/h3\u003E\n\u003Cp\u003EFull day with our guide at Museum Island, one of the finest museum complexes in the world \u2013 Alte Nationalgalerie is home to a collection from the era between the French Revolution and the First World War and featuring artists such as Caspar David Friedrich, Karl Friedrich Schinkel and Menzel, as well as works by Monet, Renoir, C\u00E9zanne and Degas \u2013 the marvellous Egyptian collection at the Neues Museum includes the exquisite limestone bust of Queen Nefertiti.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Potsdam - Sanssouci Palace \u0026amp; Cecilienhof Palace\u003C/h3\u003E\n\u003Cp\u003ETravel with our guide to Potsdam, a town set amongst woodlands and lakes with opulent palaces and gardens including the delightful Sanssouci Palace created in 1744 by Frederick the Great as his summer residence \u2013 visit Cecilienhof Palace built by Emperor William II for his eldest son, Crown Prince William, and his wife, Crown Princess Cecilie, and more recently the venue of the Potsdam Conference between the victorious Allies in 1945.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Charlottenburg Palace\u003C/h3\u003E\n\u003Cp\u003EVisit the breathtakingly splendid rooms of the Knobelsdorff Wing of Charlottenburg Palace \u2013 transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
