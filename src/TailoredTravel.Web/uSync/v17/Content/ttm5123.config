    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "b5870db4-9a48-40f6-9a97-6f3b917d215b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotels\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E7 dinners \u0026amp; 1 lunch included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel, guided tours \u0026amp; entrance fees included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn UK airport coach transfers included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EReturn direct scheduled flights from Gatwick to Thessaloniki\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECoach for all excursions \u0026amp; transfers in Greece\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIncluded boat excursions on Days 3 \u0026amp; 6\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELocal accommodation tax included\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "c8bb195b-f956-476b-84b0-64a86744b347",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay the first four nights at the 4* Porto Palace Hotel at Thessaloniki (\u003Ca href=\u0022http://www.portopalace.gr\u0022\u003Ewww.portopalace.gr\u003C/a\u003E), before spending the final three nights of our tour at the 4* The Lake Hotel at Io\u00E1nnina (\u003Ca href=\u0022http://www.thelakehotel.gr\u0022\u003Ewww.thelakehotel.gr\u003C/a\u003E). All rooms at both hotels are ensuite. Dinners are included every evening, as detailed in the itinerary.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "8390e455-f1d3-40bd-90cf-476314f29206",
      "values": [
