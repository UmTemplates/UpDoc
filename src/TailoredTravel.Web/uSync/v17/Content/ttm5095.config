    {
      "contentTypeKey": "458004c2-2f2b-40bf-8fd7-cad968995e49",
      "key": "4eb2e8c1-9455-48ff-afc9-d892a484c63e",
      "values": []
    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "2ea68217-dd73-4457-98d4-fccb0876e758",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEntrance fees to non-National Trust properties included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIncluded train excursion on Day 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "423e2ed7-34fd-45a3-ac9f-0664fda84bd1",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay four nights at the 4* Thorpe Park Hotel \u0026amp; Spa, on the outskirts of Garforth (\u003Ca href=\u0022http://www.thorpeparkhotel.co.uk\u0022\u003Ewww.thorpeparkhotel.co.uk\u003C/a\u003E). Facilities at the hotel include a restaurant, bar, indoor swimming pool, sauna, Jacuzzi and a steam room. All rooms are en suite and feature television, telephone, complimentary WiFi, and tea \u0026amp; coffee making facilities. A set 3 course dinner without drinks is included in our hotel on the first night. A choice 3 course dinner without drinks is included in our hotel on the remaining three nights of our tour.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "5847b873-0840-49cf-9b24-c8ccf2831ba4",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organiser"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "For more information on this tour contact your Group Organiser"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOnce you have received your Confirmation and Invoice, you can pay your final balance.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "ed994cc7-aa90-44f5-966b-d12cb53a4c79",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHarewood House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EYork \u2013 guided walking tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EYork Minster\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ERipon Cathedral \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFountains Abbey \u0026amp; Studley Royal Water Garden\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWhitby\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENorth Yorkshire Moors steam train excursion\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECastle Howard\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "c4b3a613-0d2c-4470-8d06-f7efea52d6e0",
      "key": "e65c19d9-d39a-4c0e-a3c0-253e937a9d5c",
      "values": [
        {
          "alias": "featurePropertyNavigationInPageItems",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "7c049160-5292-46b5-95a3-4a0568df1b38",
            "2ea68217-dd73-4457-98d4-fccb0876e758",
            "423e2ed7-34fd-45a3-ac9f-0664fda84bd1",
            "ed994cc7-aa90-44f5-966b-d12cb53a4c79",
            "9701b531-c940-424f-9e27-7690193f2605",
            "5847b873-0840-49cf-9b24-c8ccf2831ba4"
          ]
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "In this page"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "7c049160-5292-46b5-95a3-4a0568df1b38",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe depart by private executive coach from our designated pick up points. En route to our hotel we visit the home of the late Queen\u2019s cousin, the Earl of Harewood. Located just outside Leeds, Harewood House is renowned for its stunning architecture, exquisite Adam interiors and Chippendale furniture and a fine art collection. All are set in a 1,000 acre Capability Brown landscape with a modern bird garden. We continue to the 4* Thorpe Park Hotel \u0026amp; Spa, on the outskirts of Garforth for a four night stay on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EOur Blue Badge guide meets us at our hotel this morning and accompanies us throughout the day. Our guided walking tour of York takes in sights such as the City Walls, the Shambles, and includes a visit to the Minster, the largest Gothic cathedral in northern Europe. We then spend some time at leisure in York, and on an individual basis you may choose to visit the National Railway Museum, or visit York Castle Museum with its recreated Victorian street, Kirkgate.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EThis morning we enjoy a guided tour at Ripon Cathedral, dating back to the 7th century when Saint Wilfrid built one of England\u2019s first stone churches on this site. This afternoon we continue with our Blue Badge guide to the National Trust\u2019s Fountains Abbey and Studley Royal Water Garden, which has been attracting visitors since the 18th century. Together the Cistercian abbey, Georgian water garden, medieval deer park, Elizabethan hall and Victorian church offer an unparalleled opportunity to appreciate the range of England\u2019s heritage at this World Heritage Site.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EOur Blue Badge guide accompanies us on a visit to Whitby, a resort dominated by the cliff top ruins of a beautiful 13th century abbey and with old cobbled streets, picturesque houses and a sandy beach. This afternoon we enjoy an included one way nostalgic steam train journey from Whitby to Pickering through the picturesque North Yorkshire Moors. Preserved in 1967, the North Yorkshire Moors Railway has gone from strength to strength and has featured on television and film, including \u2018Harry Potter\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EAfter checking out of our hotel we visit Castle Howard. Set in a beautiful 1,000 acre park adorned with rose gardens, lakes and fountains, this magnificent 18th century house is home to the Howard family and has been richly furnished throughout. Taking carefully selected comfort stops en route, we return back to our original pick up points.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "NB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems."
          }
        }
      ]
