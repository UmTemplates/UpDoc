    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "443258b5-1c55-4af8-9995-bae4ec583e4b",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursion travel \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEntrance fees to non-National Trust properties included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIncluded train excursion on Day 3\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide on Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "e71f7f0d-eb04-4b2e-bc5d-4e6557f77306",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe stay four nights at the 4* Albrighton Hall Hotel and Spa (\u003Ca href=\u0022https://www.radissonhotels.com/\u0022 target=\u0022_blank\u0022 rel=\u0022noopener\u0022\u003Ewww.radissonhotels.com\u003C/a\u003E). Located in a countryside setting near the village of Albrighton, facilities at the hotel include a restaurant, bar, indoor swimming pool, sauna and a steam room. All of our allocated Standard Rooms are en suite and feature a television, and tea \u0026amp; coffee making facilities. A set 3 course dinner without drinks is included in our hotel on the first night. A choice 3 course dinner without drinks is included in our hotel on the remaining three nights of our tour.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "a00f052f-2581-4b24-a04e-a49db5a87615",
      "key": "d8136fd0-8516-42ed-b0e3-08bd9c3d90cd",
      "values": [
        {
