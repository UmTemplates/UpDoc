    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "29b6f50d-99c1-44da-844e-19d2d48ee66c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWelcome dinner\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Palermo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "fd5d8d11-221d-4bbf-96be-5f63870f7e78",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights at the centrally located 3* Al Madarig Hotel in Castellammare Del Golfo. Located on a central piazza overlooking the sea, facilities at the hotel include a bar and breakfast room overlooking the piazza. All rooms are en suite. A welcome dinner is included at a restaurant close to our hotel on Day 1 and the remaining four nights are on bed and breakfast basis.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "f71f5591-0e29-47f4-9844-b834ed1f4905",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\u003Cli\u003E\u003Cp\u003ECastellammare del Golfo\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003ETrapani - guided tour\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EErice \u0026amp; its Duomo\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EMonreale Cathedral guided tour\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EPalermo - guided tour\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EBoat trip to Mozia Island \u0026amp; the Museum of Mozia\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EMarsala - tour \u0026amp; tasting at Florio Wine Cellar\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EGuided tour of Cefal\u00F9\u003C/p\u003E\u003C/li\u003E\u003Cli\u003E\u003Cp\u003EGuided tour of Segesta\u003C/p\u003E\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "eeeef6cd-b09c-4878-a25b-0b45d828453a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ETour of the rest of Sicily - tours can be tailor made to your group\u2019s exact requirements - see opposite for a suggested itinerary\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESelinunte - founded by Greeks around 650BC, this is a vast archaeological site famous for its many temples and acropolis\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMondello - a charming seaside town just to the north of Palermo known for its Art Nouveau villas and where the cream of Palermo high society came to enjoy its beautiful beach\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "f99da8b8-cba2-4264-8629-63f5281d8646",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Castellammare del Golfo\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Palermo from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the centrally located 3* Al Madarig Hotel in Castellammare Del Golfo \u2013 dinner at a local restaurant.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Trapani, Erice \u0026amp; its Duomo\u003C/h3\u003E\n\u003Cp\u003EA walking tour of Trapani takes in Chiesa del Purgatorio with its impressive 18th century Misteri, twenty life sized wooden effigies depicting the story of Christ\u0026#39;s Passion \u2013 poised on a crag overlooking the Mediterranean, the delightful medieval town of Erice boasts stunning views and we enjoy a guided tour at the 14th century Duomo, home to a \u2018Madonna and Child\u2019 attributed to either Francesco Laurana or Domenico Gagini.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Monreale \u0026amp; Palermo\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the magnificent cathedral at Monreale, one of the great sites of Norman Sicily adorned with glittering Sicilian and Byzantine mosaics \u2013 a guided tour of Palermo, a beautiful city whose architecture ranges from Arabic to Norman in style, takes in sights such as the 12th century La Martorano, the awe inspiring Palatine Chapel and the Church of San Cataldo.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Boat trip to Mozia Island, the Museum of Mozia \u0026amp; Marsala tour \u0026amp; tasting\u003C/h3\u003E\n\u003Cp\u003EThe boat trip to the island of Mozia affords views of the salt flats and windmills that characterise this part of the coastline \u2013 the archaeological site of Mozia was an important colony of the Phoenician city of Carthage, and its museum\u2019s greatest treasure is its marble statue, \u2018Giovinetto di Mozia\u2019, also known as Charioteer \u2013 the port of Marsala is the home of the thick, strong, sweet wine that Admiral Nelson ordered vast quantities of following the Battle of the Nile in 1798, and we enjoy a tour and tasting at the Florio Wine Cellar.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Guided tour of Cefal\u00F9\u003C/h3\u003E\n\u003Cp\u003ETravel along the coast to the charming medieval seaside town for a guided tour of Cefal\u00F9 and its splendid duomo, built in the 12th century during Sicily\u0026#39;s Norman era and intended as the principal religious seat in Sicily \u2013 rest of the day is at leisure in Cefal\u00F9 and on an individual basis you may choose to visit the Museo Mandralisca, home to a fine \u2018Portrait of a Man\u2019 by Antonello da Messina, and an interesting collection of coins, ceramics and vases.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Guided tour of Segesta\u003C/h3\u003E\n\u003Cp\u003EWith a hilltop position on Mount Barbaro, a guided tour of Segesta also takes in its Doric temple dating from 5th century BC and one of the best preserved in the world \u2013 transfer to Palermo airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
