        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "f37072d6-1d8b-4654-aa21-3e157ad5eff5",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Itinerary"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1\u003C/h3\u003E\n\u003Cp\u003EWe depart by private executive coach from our designated pick up points. En route to our hotel we visit the National Trust\u2019s Claydon House in Buckinghamshire. Home of the Verney family for more than 400 years, the extraordinary interiors of Claydon House represent a veritable three- dimensional pattern book of 18th Century decorative styles. Outstanding features include a lavish wood carving in the Chinese Room and the fine grand staircase. Claydon House has strong associations with Florence Nightingale, sister-in-law to Sir Harry Verney. We continue to the 4* Albrighton Hall Hotel and Spa where we stay four nights on a half board basis.\u003C/p\u003E\n\u003Ch3\u003EDay 2\u003C/h3\u003E\n\u003Cp\u003EWe visit the National Trust\u2019s Shugborough Estate with our Blue Badge guide today, set on the banks of the River Sow, with a magnificent 17th- century mansion house, along with working Victorian servant\u2019s quarters and a Georgian park farm with watermill.\u003C/p\u003E\n\u003Ch3\u003EDay 3\u003C/h3\u003E\n\u003Cp\u003EWith our Blue Badge guide this morning we visit the English Heritage\u2019s Stokesay Castle. Nestling in a green valley in the heart of the Shropshire countryside, this perfectly preserved medieval fortified manor house dates back to the 11th century. After spending some time at leisure in Ludlow for lunch, we continue to Kidderminster. On arrival, we enjoy an included one way 16 mile steam train excursion to Bridgnorth on the Severn Valley Railway, the best way to explore the beauty of the River Severn. We spend the rest of the day at leisure at the historic town of Bridgnorth, once a thriving port along the banks of the River Severn. Upon seeing Bridgnorth, Charles the First declared the destination as offering \u2018the finest view in all my Kingdom\u2019, as he gazed, awestruck, from the top of this delightful town.\u003C/p\u003E\n\u003Ch3\u003EDay 4\u003C/h3\u003E\n\u003Cp\u003EOur guided walking tour of Shrewsbury this morning takes in sights such as the Norman Castle and St Mary\u2019s Church, dating from 960 AD and boasting one of the tallest spires in England. With our Blue Badge guide this afternoon we visit the National Trust\u2019s Attingham Park, an elegant 18th century mansion, and home to a fine collection of ambassadorial silver, Italian furniture and Grand Tour paintings\u003C/p\u003E\n\u003Ch3\u003EDay 5\u003C/h3\u003E\n\u003Cp\u003EToday we spend some time at leisure at the Blists Hill Victorian Village at Ironbridge Gorge. The Museum is a recreation of life in a Victorian community. Working factories, shops and cottages are authentic to the era, as are the \u2018townsfolk\u2019. Taking carefully selected comfort stops en route, we return back to our original pick up points.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ENB:- Please note we reserve the right to alter the above itinerary if required for operational\nreasons. Given the historic nature of the places visited, a certain degree of walking will be involved, and this holiday may not be suitable for those with mobility problems.\u003C/p\u003E\n"
          }
        }
      ]
    },
