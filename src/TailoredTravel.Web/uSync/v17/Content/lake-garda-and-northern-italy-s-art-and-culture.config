    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "4ad87827-5a39-4e4d-947f-4a872382a972",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional local guide\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "bb054b95-5e10-4734-864f-61a524c04fd2",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights on half board basis at the 3* Hotel La Perla in the village of Garda. Located about a hundred metres from the shores of Lake Garda and just behind the old town, the hotel has a restaurant, bar and an outdoor swimming pool.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "2ebfddd9-08a1-4d40-892e-361ec210ea85",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGarda\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELake Garda \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVerona \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMuseo di Castelvecchio\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBasilica di San Zeno Maggiore\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVenice\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGallerie dell\u2019Accademia - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPadova \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECappella degli Scrovegni\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "3c66e429-253b-4855-b883-cc4bb6b54e4f",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EMantova - the Palazzo Ducale, once one of Europe\u2019s largest palaces, houses a wonderful art collection including Mantegna\u2019s frescoes in the \u2018Camera degli Sposi\u2019 while Giulio Romano\u2019s \u2018Room of Giants\u2019 is at the magnificent Palazzo Te\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDolomite Mountains - with truly magnificent scenery including the Passa Por Doi and Sella Pass, both over 2,200m high, this is some of the most spectacular scenery in Europe\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDesenzano - with beautiful views of the Alps from the southern shores of Lake Garda, choose simply to relax or visit the Cathedral of St Mary Magdalene home to Tiepolo\u2019s \u2018Last Supper\u2019 or the Villa Romana, dating from 5th century BC with wonderful mosaics showing scenes of fishing, hunting, harvesting and dancing\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "4e0f2555-bc86-4a48-95d5-cc58b301c38e",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Garda\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Italy \u2013 transfer with our professional guide in our private executive coach to the 3* Hotel La Perla in the village of Garda.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Tour of Lake Garda\u003C/h3\u003E\n\u003Cp\u003ETour of Lake Garda combining both coach and boat and a lovely way to see the real beauty of the Lake and its villages including Sirmione, home to Maria Callas, Limone and Gardone Riviera.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Verona, Museo di Castelvecchio \u0026amp; Basilica di San Zeno Maggiore\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Romanesque Verona, Italy\u2019s fourth classical city, home to the Arena dating from the 1st century BC and Shakespeare\u2019s inspiration for \u2018Romeo and Juliet\u2019 \u2013 the Museo di Castelvecchio houses a wonderful overview of Veronese paintings including works by Pisanello, Veronese and Tintoretto \u2013 visit the Basilica di San Zeno Maggiore, built between 1123 and 1135 to house the shrine of Verona\u2019s patron saint and regarded as the finest Romanesque church in northern Italy.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Venice \u0026amp; Gallerie dell\u2019Accademia\u003C/h3\u003E\n\u003Cp\u003EPre-booked boat transfer into Venice along the Giudecca Canal \u2013 guided tour of the Gallerie dell\u2019Accademia to introduce us to the wonderful collection of Venetian art from the 14th to 18th century including works by Titian, Carpaccio, Tintoretto and Veronese \u2013 rest of the day is free to explore Venice and you may choose to visit the Peggy Guggenheim Collection in the Palazzo Venier dei Leoni on the Grand Canal or your tour manager can organise an optional gondola ride.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Padova \u0026amp; Cappella degli Scrovegni\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Padova, one of Italy\u0026#39;s oldest university towns, taking in the Basilica di Sant\u2019Antonio and Donatello\u2019s magnificent reliefs on the miracles of St Anthony, the Caf\u00E9 Pedrocchi, a famous intellectual meeting place dating from 1831, the Piazza delle Erbe and the Jewish Quarter \u2013 visit to the Cappella degli Scrovegni to see Giotto\u2019s beautiful frescoes depicting the life of Christ which became a powerful influence on the development of European art \u2013 rest of the day at leisure.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Lake Garda\u003C/h3\u003E\n\u003Cp\u003EMorning free in Garda on the shores of Lake Garda \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
