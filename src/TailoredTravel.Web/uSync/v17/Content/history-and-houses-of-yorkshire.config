    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "23b9b0ed-2bfc-450e-9e6b-ca20ed941dc6",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHarrogate hotel\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBlue Badge guide Days 2 to 4\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "6279af8c-faad-4129-8eb6-ccba3e5b3b98",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFour nights on half board basis at the 3* Cairn Hotel, located under a ten minute walk from the centre of the spa town of Harrogate. Facilities include a restaurant and a bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "877e540f-7cf8-4086-8371-58c3cbab7e42",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHarewood House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWalking tour of York\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMedieval Merchant Adventurers\u2019 Hall\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFairfax House\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E18th century Castle Howard\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Harrogate\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENorth Yorkshire Moors Railway trip\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWhitby\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EThe Hepworth Wakefield\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "c9510f0a-a891-4855-8b36-81c1e3b4a49e",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EBront\u00EB Parsonage Museum, Haworth - the former home of the world\u2019s most famous literary family\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBurton Agnes Hall - a beautiful Elizabethan house famous for its 17th century carvings and a fine collection of modern paintings, bronzes, furniture and porcelain\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENewby Hall, Ripon - built under the guidance of Sir Christopher Wren, this is one of England\u2019s finest Adam houses\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFountains Abbey \u0026amp; Studley Royal Water Garden - together the Cistercian abbey, Georgian water garden, medieval deer park, Elizabethan hall and Victorian church offer an unparalleled range of England\u2019s heritage\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESledmere House, Driffield - built in 1751 and set in the Yorkshire Wolds, the house exudes 18th century elegance with each room containing fine plasterwork by Joseph Rose Junior\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EBurton Agnes Hall, Driffield - an Elizabethan stately home built between 1598 and 1610 by Sir Henry Griffith, fifteen generations have filled the Hall with French impressionist paintings, contemporary furniture, tapestries and other modern artwork\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EEden Camp - a former prisoner of war camp which uses audio visual technology to depict the history of World War II\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFairfax House - Georgian townhouse brimming with decorative flourishes and artistic treasures and displaying some of the finest 18th century period furniture in England\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EConstable Burton Hall \u0026amp; Gardens - a private guided tour of the romantic garden by the head gardener is followed by time to admire the Hall\u2019s fine collection of furniture and old master paintings\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMarkenfield Hall - completely surrounded by a moat and built mainly in 1310,this is the most complete surviving medium sized 14th century country house left in England\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EYork Art Gallery - home of the Lycett Green collection of Italian Old Masters from the 14th to the 18th century, as well as works by renowned 20th century artists such as LS Lowry, Sarah Lucas and William Etty, York\u2019s most famous artist\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Here are some more suggested places of interest you might like to include:"
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "3a3b8570-fa5f-4b37-9d1b-fdd9134ac52f",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Harewood House\u003C/h3\u003E\n\u003Cp\u003EBoard our private executive coach at your preferred pick up points \u2013 visit Harewood House, the home of Queen Elizabeth II\u2019s cousin, the Earl of Harewood, renowned for its stunning architecture, fine art collection, exquisite Adam interiors and Chippendale furniture and a 1,000 acre \u2018Capability\u2019 Brown landscaped garden \u2013 continue to the 3* Cairn Hotel in Harrogate.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 York guided tour, Merchant Adventurers\u2019 Hall \u0026amp; Fairfax House\u003C/h3\u003E\n\u003Cp\u003EWalking tour of York with our Blue Badge guide taking in the City Walls, the Shambles and the Minster, the largest Gothic cathedral in northern Europe \u2013 visit the Merchant Adventurers\u2019 Hall, built between 1357 and 1361 and one of the best preserved medieval guild halls in the world \u2013 Fairfax House is a stunning Georgian townhouse brimming with decorative flourishes and artistic treasures and displaying some of the finest 18th century period furniture in England.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Castle Howard \u0026amp; Harrogate guided tour\u003C/h3\u003E\n\u003Cp\u003EMagnificent 18th century Castle Howard is set in a beautiful 1,000 acre park adorned with rose gardens, lakes and fountains, while the house is home to the Howard family and has been richly furnished throughout \u2013 guided tour of Harrogate this afternoon takes in sights such as the Royal Hall and Montpellier Gardens \u2013 afternoon at leisure with time to take tea at Betty\u2019s Caf\u00E9 Tea Rooms.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Whitby \u0026amp; North Yorkshire Moors Railway trip\u003C/h3\u003E\n\u003Cp\u003EScenic drive and then time to explore Whitby, a resort dominated by the cliff top ruins of a beautiful 13th century abbey and with old cobbled streets, picturesque houses and a sandy beach \u2013 preserved in 1967 and featured in \u2018Harry Potter\u2019, a nostalgic steam train journey on the North Yorkshire Moors Railway takes us from Whitby to Pickering through the picturesque Moors.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 The Hepworth Wakefield\u003C/h3\u003E\n\u003Cp\u003EThe Hepworth Wakefield features the Hepworth Family Gift consisting of 44 full size working models Barbara Hepworth executed from the mid- 1950s to the end of her career as well as a collection of her drawings, lithographs and screen prints \u2013 return to our original departure points with comfort stops en route.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every one of our tours is exclusively for your group and your group alone so each one can be tailor made to suit the interests and profile of your members until you have a tour with an itinerary and at a price which matches the interests and profile of your members."
        }
      ]
    },
