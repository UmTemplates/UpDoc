    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "95617fe3-8e8b-46fc-9502-f29ea8886da5",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EHalf board accommodation\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFull programme of included excursions\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "07b77a45-2f08-4234-b6e0-a3520257b379",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ESeven nights on half board basis at the 3* Hotel Pace in Torri del Benaco on the shores of Lake Garda. The hotel has a restaurant and bar and all rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "ec3a6982-2484-4117-870a-abf314395775",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ETour of Lake Garda\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVenice\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVicenza \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMantova \u0026amp; Desenzano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EVerona \u2013 guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "bd6f75b2-4aec-4155-835a-cb122987f4a3",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EPadova - one of Italy\u2019s oldest university towns and the setting for Shakespeare\u2019s \u2018Taming of the Shrew\u2019\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIslands of the Venetian Lagoon - full day private boat trip to Murano, famous for its glass making, Burano with its brightly coloured houses and barely inhabited Torcello\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EArchitecture of Andrea Palladio - guided tour taking in the great architect\u2019s palaces and civic buildings including Villa La Rotunda, the Teatro Olimpico, and the Basilica Palladiana\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "7e9a9e82-a5f4-4131-9bbe-135be67cd58e",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Torri del Benaco\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our professional guide in our private executive coach to the 3* Hotel Pace in Torri del Benaco.\u003C/p\u003E\n\u003Ch3\u003EDay 2 - Tour of Lake Garda\u003C/h3\u003E\n\u003Cp\u003ECoach and boat tour of Lake Garda to see the real beauty of the Lake and its villages including Sirmione, home to Maria Callas, Limone and Gardone Riviera.\u003C/p\u003E\n\u003Ch3\u003EDay 3 - Venice\u003C/h3\u003E\n\u003Cp\u003EPre-booked boat transfer along the Giudecca Canal \u2013 free time at leisure to explore Venice including the famous Rialto Bridge, Palazzo Ducale and St Mark\u2019s Square and for art lovers the Accademia houses masterpieces by Venetian artists dating from 14th to 18th century.\u003C/p\u003E\n\u003Ch3\u003EDay 4 - Dolomites\u003C/h3\u003E\n\u003Cp\u003EOptional trip into the Dolomites \u2013 with truly magnificent scenery including the Passa Por Doi and Sella Pass, both over 2,200m high, this is some of the most spectacular scenery in Europe\u003C/p\u003E\n\u003Ch3\u003EDay 5 - Lake Garda\u003C/h3\u003E\n\u003Cp\u003EEnjoy a day to relax at our hotel or a chance to explore beautiful Lake Garda.\u003C/p\u003E\n\u003Ch3\u003EDay 6 - Vicenza\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Vicenza takes in Europe\u2019s oldest indoor theatre, Palladio\u2019s Teatro Olimpico \u2013 afternoon free for further sightseeing or shopping.\u003C/p\u003E\n\u003Ch3\u003EDay 7 - Mantova \u0026amp; Desenzano\u003C/h3\u003E\n\u003Cp\u003EMantegna\u2019s \u2018Camera degli Sposi\u2019 in the magnificent Palazzo Ducale in Mantova \u2013 relax at the delightful town of Desenzano on the southern shores of Lake Garda \u2013 optional farewell meal at our carefully selected Italian farmhouse.\u003C/p\u003E\n\u003Ch3\u003EDay 8 - Verona\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the beautiful Romanesque city of Verona, Italy\u2019s fourth classical city, and home to the Arena dating from 1st century BC and Shakespeare\u2019s inspiration for \u2018Romeo and Juliet\u2019 \u2013 transfer to the airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
    {
