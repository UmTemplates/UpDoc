    },
    {
      "contentTypeKey": "6e95c250-2a6b-4652-b3a0-3ed6039986fd",
      "key": "96649d74-16a3-40e4-8d7a-27480c4f6e83",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003ELike this holiday but want to change it to suit your group\u2019s budget or preferences? You could enjoy a pre or post-cruise stay in Porto or include an exclusive cocktail evening for your group or include some of the optional excursions.\u003C/p\u003E\u003Cp\u003ERemember there will be cost consequences depending on your preferences but once we have sent you our initial offer, we can amend it as required by you until you have a tour with an itinerary and at a price which matches the interests and profile of your members.\u003C/p\u003E\u003Cp\u003EAlternatively, there are a vast range of different river cruises available throughout Europe. Call us to discuss the possibilities.\u003C/p\u003E"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "If you\u0027d like to adjust what\u0027s included, perhaps a different hotel standard, more or fewer days, or different excursions, here are some alternatives:"
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your Features"
        },
        {
