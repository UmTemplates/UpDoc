    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "e69fd773-6113-4e04-9d05-545e8feae7e9",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003E3 dinners included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Italy\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "63d2a0a9-c0bb-44f1-b717-9aeeb5f5532d",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EFive nights in the 3* Hotel Villa Ricci in Chianciano Terme in the heart of Tuscany. Dinner is included at the hotel on Days 1, 2 and 5 and the remaining nights are on bed and breakfast basis. All rooms are en suite and the hotel has a bar, restaurant and indoor pool.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "0847e5c6-4bfc-4092-9624-63d71f34f7ec",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ESpa town of Chianciano Terme\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Abbey of Monte Olivieto Maggiore\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPienza\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EChurch of Madonna Di San Biagio, Montepulciano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAssisi \u0026amp; guided tour of the frescoes at Basilica of St Francis\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPerugia \u0026amp; Galleria Nazionale dell\u2019 Umbria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESiena \u0026amp; guided tour of the Opera del Duomo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESan Gimignano\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFlorence \u0026amp; the Uffizi\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EPisa or Orvieto\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "All of these can be changed. If your group would prefer to visit different attractions, or if there are particular places you\u0027d like to include instead, just let us know."
          }
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "baf437df-e91d-44f3-b40f-ed173862b811",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EPerugia - beautiful medieval town \u0026amp; the Galleria Nazionale dell\u2019 Umbria\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EArezzo - famous for its hanging flower baskets and Pierro della Francesca\u2019s fresco cycle, The Legend of the True Cross, in the Basilica San Francesco\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECortona - home of Fra\u0026#39; Angelico and birthplace of Luca Signorelli and Pietro da Cortona, all three are represented in the Museo Diocesano\u0026#39;s wonderful collection\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESpello, Todi or Gubbio - some of the lesser-known Umbrian hill towns\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELucca - explore the regular grid of streets that still follow the pattern of the former Roman colony founded in 180 BC or visit the house in which Giacomo Puccini was born\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "8242ebc4-f323-4e88-93eb-4785608c34b3",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Chianciano Terme\u003C/h3\u003E\n\u003Cp\u003EScheduled flight to Italy from your preferred airport \u2013 transfer with our tour manager in our private executive coach to the 3* Hotel Villa Ricci in Chianciano Terme in Tuscany \u2013 dinner in the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013 Abbey of Monte Oliveto Maggiore, Pienza \u0026amp; Church of Madonna Di San Biagio\u003C/h3\u003E\n\u003Cp\u003EMorning guided tour of Abbey of Monte Oliveto Maggiore with one of the monks (voluntary donation) to see the magnificent 41 frescoes of the Life of St Benedict by Signorelli and Sodoma \u2013 explore the enchanting town of Pienza with time to walk along the walls to enjoy the wonderful views \u2013 the Church of Madonna Di San Biagio at Montepulciano dates back to 1518 and is one of the most important church buildings of the Renaissance period \u2013 dinner in the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Basilica of St Francis of Assisi, Perugia \u0026amp; Galleria Nazionale dell\u2019 Umbria\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Basilica of St Francis of Assisi and its wonderful frescoes by Giotto, Simone Martini and Lorenzetti \u2013 stop at the medieval town of Perugia to visit the Galleria Nazionale dell\u2019 Umbria, the centre for Umbrian art.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Siena \u0026amp; San Gimignano\u003C/h3\u003E\n\u003Cp\u003ESpend the morning in Siena \u2013 a guided tour of the Opera del Duomo with the 13th century Rose Window and the Duccio di Buoninsegna\u2019s 1308 altar piece dedicated to the Virgin Mary \u2013 free time to visit sights such as the Campo where the Palio horse race is run every year and the Piccolomini Library in the Duomo \u2013 travel into the Chianti wine growing region to visit San Gimignano with its cathedral housing the \u2018Poor Man\u2019s Bible\u2019 and the 13 defensive Medieval towers giving it the name \u2018the Small Manhattan\u2019.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Florence \u0026amp; the Uffizi\u003C/h3\u003E\n\u003Cp\u003EFull day in Florence, the capital of Renaissance art \u2013 pre-booked entry into the Uffizi Gallery, one of the world\u2019s finest art galleries, with time at leisure to enjoy the magnificent Renaissance masterpieces including works by Giotto, Masaccio, Paolo Ucello, Sandro Botticelli, Leonardo da Vinci, Michelangelo, Titian and Caravaggio \u2013 free time to visit Michelangelo\u2019s \u2018David\u2019 at the Accademia, the Ponte Vecchio, the magnificent Duomo, the Pitti Palace or Boboli Gardens \u2013 farewell dinner in hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Pisa or Orvieto\u003C/h3\u003E\n\u003Cp\u003EDepending on the location of your preferred airport, visit the Leaning Tower of Pisa (Torre Pandente) which started to tilt even before the third storey was finished in 1274 or a morning guided tour of the charming Etruscan town of Orvieto \u2013 transfer to the airport for our scheduled flight back home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
