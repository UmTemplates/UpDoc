    },
    {
      "contentTypeKey": "34e5aa3b-db10-40a1-893d-79e98cd3f2f4",
      "key": "a7b189f6-759b-4744-b60f-7903556c539a",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Features"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003E4* hotels throughout\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EFour dinners \u0026amp; one lunch included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EAll excursions \u0026amp; guided tours included\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EProfessional tour manager\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EScheduled flights to Sicily\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EExecutive coach in Sicily\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EOne free place per 10 paying passengers\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "What\u0027s included in this tour is entirely yours to customise to suit your group\u0027s budget and preferences. Here is what we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "1d09b5af-b95a-4af5-b8f2-323db029e817",
      "key": "318c9996-520e-4cad-9c12-cc7eb509ef1c",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Accommodation"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThree nights on half board basis at the 4* Hellenia Yachting Hotel on the seafront at Giardini Naxos near Taormina on Sicily\u2019s east coast, one night on half board basis at the 4* Grand Hotel dei Templi in Agrigento and the final three nights on bed and breakfast basis at the 4* Hotel Garibaldi in the historic centre of Palermo. All rooms are en suite.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Where you stay is entirely yours to choose to match your group\u0027s preferences. Here is our suggested accommodation:"
        }
      ]
    },
    {
      "contentTypeKey": "2d9b0603-29ef-423a-8d3e-d9c039d3d7b1",
      "key": "b3ab9262-0f48-483f-b257-bc93513482c2",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Taormina\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EWine tasting at Cantina Gambino\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ESyracuse \u0026amp; the Temple of Apollo \u0026amp; the Parco Archeologico - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EIsland of Ortigia\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMosaics at Piazza Armerina \u0026amp; Villa Romana del Casale\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EDoric temples at the Valley of the Temples\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Palermo\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EMonreale Abbey - guided tour\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EGuided tour of Segesta\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003EErice\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "The places your group visits are exclusively yours to decide. Here are the main sights we\u0027ve suggested:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "de535189-b468-4594-8118-f303bac50e3c",
      "key": "cfcfacfd-45e7-458d-90ac-0e9732b93791",
      "values": [
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Tailor your sights"
        },
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cul\u003E\n\u003Cli\u003E\u003Cp\u003ECastelbuono - mountain town home to a magnificent feudal castle once owned by the Ventimiglia family\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ELunch at a working farm winery near Siracusa featuring local wines and traditional locally grown food\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ENoto - a beautiful town south of Syracuse famous for its early 18th century buildings, considered among the best examples of the Sicilian Baroque style\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ETour of the rest of Sicily - tours can be tailor made to your group\u2019s exact requirements - see opposite for a suggested itinerary\u003C/p\u003E\n\u003C/li\u003E\n\u003Cli\u003E\u003Cp\u003ECefal\u00F9 - medieval seaside town boasts a 12th century Norman cathedral, mountain top archaeological site and pleasant narrow streets\u003C/p\u003E\n\u003C/li\u003E\n\u003C/ul\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "\nIf you\u0027d prefer to visit different places, or if you\u0027d like to add extra attractions that match your group\u0027s specific interests, here are some more suggestions:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "837beecf-4239-4b3d-b683-1d611af3da2e",
      "key": "92c7c2c9-9720-48ce-98e9-b2b8cf6bc1ad",
      "values": [
        {
          "alias": "richTextContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Ch3\u003EDay 1 \u2013 Giardini Naxos\u003C/h3\u003E\n\u003Cp\u003EScheduled flight from your preferred airport to Catania \u2013 transfer with our professional tour manager in our private executive coach to the 4* Hellenia Yachting Hotel on the seafront at in Giardini Naxos near Taormina.\u003C/p\u003E\n\u003Ch3\u003EDay 2 \u2013Taormina \u0026amp; wine tasting at Cantina Gambino\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Taormina taking in the Palazzo Corvaia, the Duomo and the wonderfully panoramic 4th century BC Greek amphitheatre \u2013 included wine tasting at Cantina Gambino.\u003C/p\u003E\n\u003Ch3\u003EDay 3 \u2013 Syracuse, island of Ortigia \u0026amp; included lunch\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Syracuse, home to Sicily\u2019s earliest Doric temple, the Temple of Apollo, and the Parco Archeologico featuring the Teatro Romano, the Altar of Hieron II and the spectacular Teatro Greco carved from the hillside \u2013 the island of Ortigia in the historical heart of Syracuse is full of close knit lanes, Baroque palaces and churches along with the Piazza Duomo, an open space lined with impressive buildings \u2013 included lunch at a working farmhouse in Syracuse before returning to the hotel.\u003C/p\u003E\n\u003Ch3\u003EDay 4 \u2013 Villa Romana del Casale\u003C/h3\u003E\n\u003Cp\u003ETravel inland to Piazza Armerina for a guided tour of some of the finest surviving mosaics from Roman antiquity at the Villa Romana del Casale \u2013 travel on to Agrigento and check in to the 4* Grand Hotel dei Templi.\u003C/p\u003E\n\u003Ch3\u003EDay 5 \u2013 Valley of Temples\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the Doric temples dating from the 5th century BC at the Valley of Temples in Agrigento, with nine of the ten original temples still visible and some still beautifully preserved \u2013 travel on to Palermo and check into the 4* Hotel Garibaldi in the historic centre.\u003C/p\u003E\n\u003Ch3\u003EDay 6 \u2013 Monreale \u0026amp; Palermo\u003C/h3\u003E\n\u003Cp\u003EGuided tour of the magnificent cathedral at Monreale, one of the great sites of Norman Sicily adorned with glittering Sicilian and Byzantine mosaics \u2013 guided tour of Palermo including La Martorana, the Palazzo Abatellis, the awe inspiring Palatine Chapel in the Palazzo Reale and the Church of San Cataldo.\u003C/p\u003E\n\u003Ch3\u003EDay 7 \u2013 Guided tour of Segesta \u0026amp; Erice\u003C/h3\u003E\n\u003Cp\u003EGuided tour of Segesta, with a hilltop position on Mount Barbaro outside the ancient city, its Doric temple dating from 5th century BC is one of the best preserved in the world \u2013 a delightful medieval town poised on a crag overlooking the sea, at Erice we visit the 14th century Duomo, home to a \u2018Madonna and Child\u2019 attributed to either Francesco Laurana or Domenico Gagini.\u003C/p\u003E\n\u003Ch3\u003EDay 8 \u2013 Palermo\u003C/h3\u003E\n\u003Cp\u003EMorning at leisure in Palermo \u2013 transfer to Palermo Airport for our scheduled flight home.\u003C/p\u003E\n"
          }
        },
        {
          "alias": "featurePropertyFeatureTitle",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Suggested Itinerary"
        },
        {
          "alias": "featurePropertyFeatureDescription",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Your itinerary is exclusively yours to tailor to suit your group\u0027s interests and profile of your members. Here is our suggested itinerary:"
        },
        {
          "alias": "featurePropertyFeatureSummary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "Remember, every element of this itinerary can be adjusted. If you\u0027d like to change the days, add different activities, or adjust the pace, just let us know."
          }
        }
      ]
    },
